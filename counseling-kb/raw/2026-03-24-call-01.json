617,"start":"00:25:30","end":"00:25:32","text":"没事没事啊"},{"number":618,"start":"00:25:35","end":"00:25:38","text":"好可以挂掉了"},{"number":619,"start":"00:25:38","end":"00:25:39","text":"好好再见"},{"number":620,"start":"00:25:39","end":"00:25:41","text":"斌哥哦"},{"number":621,"start":"00:25:41","end":"00:25:42","text":"是的是的"},{"number":622,"start":"00:25:42","end":"00:25:46","text":"我我是在开播之前刚刚核实了消息对"},{"number":623,"start":"00:25:46","end":"00:25:47","text":"所以我开播的时候"},{"number":624,"start":"00:25:47","end":"00:25:51","text":"我就放了一下那个超度的那个"},{"number":625,"start":"00:25:54","end":"00:25:57","text":"嗯虽然一直没有机会线下见面"},{"number":626,"start":"00:25:57","end":"00:25:59","text":"但是人家给咱帮过忙"},{"number":627,"start":"00:25:59","end":"00:26:01","text":"我们是要念人家的好的"},{"number":628,"start":"00:26:01","end":"00:26:05","text":"我回头会专门联系那边的朋友"},{"number":629,"start":"00:26:05","end":"00:26:07","text":"等到追悼会我干嘛的时候的话"},{"number":630,"start":"00:26:07","end":"00:26:09","text":"会专门的去送花圈"},{"number":631,"start":"00:26:13","end":"00:26:16","text":"行现在直播我们不探讨这些好不好啊"},{"number":632,"start":"00:26:16","end":"00:26:18","text":"你们先不发信息啊"},{"number":633,"start":"00:26:21","end":"00:26:23","text":"好下一位"}],"sameDate":[{"slug":"2026-03-24-call-01","title":"37岁女北漂崩溃实录：丈夫40岁躺平炒币三年不管孩子，我还能撑多久","date":"2026-03-24","duration":"26分54秒","index":683,"callNumber":1,"rawTranscriptUrl":"/raw/2026-03-24-call-01"},{"slug":"2026-03-24-call-02","title":"28岁女生网络恋上男友，母亲反对后瞒着复合三年，分手后痛苦不堪","date":"2026-03-24","duration":"14分37秒","index":684,"callNumber":2,"rawTranscriptUrl":"/raw/2026-03-24-call-02"},{"slug":"2026-03-24-call-03","title":"14岁女孩患中度抑郁休学在家，人际考场父亲三议题无人能解","date":"2026-03-24","duration":"17分34秒","index":685,"callNumber":3,"rawTranscriptUrl":"/raw/2026-03-24-call-03"},{"slug":"2026-03-24-call-04","title":"专科男生连麦咨询师求助弟弟叛逆和升学焦虑，咨询师一针见血指明方向","date":"2026-03-24","duration":"23分22秒","index":686,"callNumber":4,"rawTranscriptUrl":""},{"slug":"2026-03-24-call-05","title":"17岁少年被确诊重度抑郁分裂5重人格，得知霸凌者当年只是拿他\"树立敌人\"后崩溃","date":"2026-