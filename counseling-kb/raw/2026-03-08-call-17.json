:18:17","text":"但是我是希望社会能变好一点"},{"number":477,"start":"00:18:17","end":"00:18:19","text":"就是我我一直都希望的"},{"number":478,"start":"00:18:19","end":"00:18:21","text":"然后还想感谢您"},{"number":479,"start":"00:18:21","end":"00:18:22","text":"就还好"},{"number":480,"start":"00:18:22","end":"00:18:23","text":"您是山东人"},{"number":481,"start":"00:18:23","end":"00:18:24","text":"是的和亮"},{"number":482,"start":"00:18:24","end":"00:18:26","text":"这是多大的悲哀"},{"number":483,"start":"00:18:26","end":"00:18:27","text":"太悲哀了"},{"number":484,"start":"00:18:27","end":"00:18:29","text":"一个人人到中年"},{"number":485,"start":"00:18:29","end":"00:18:30","text":"闲得无聊"},{"number":486,"start":"00:18:30","end":"00:18:31","text":"开开直播"},{"number":487,"start":"00:18:31","end":"00:18:33","text":"聊聊常识"},{"number":488,"start":"00:18:34","end":"00:18:35","text":"甚至帮人梳理问题"},{"number":489,"start":"00:18:35","end":"00:18:37","text":"用的都是最基础的常识"},{"number":490,"start":"00:18:37","end":"00:18:41","text":"而这个常识却被很多朋友认为是这个时代所稀缺的"},{"number":491,"start":"00:18:41","end":"00:18:43","text":"甚至认为是光和亮"},{"number":492,"start":"00:18:43","end":"00:18:45","text":"太荒谬了"},{"number":493,"start":"00:18:45","end":"00:18:50","text":"唉真的是好悲伤啊"},{"number":494,"start":"00:18:54","end":"00:18:54","text":"会好的"},{"number":495,"start":"00:18:57","end":"00:18:57","text":"会不会好"},{"number":496,"start":"00:18:57","end":"00:18:59","text":"跟我没关系"},{"number":497,"start":"00:18:59","end":"00:19:02","text":"哎就这么一点常识"},{"number":498,"start":"00:19:02","end":"00:19:03","text":"这么浅薄的一个人"},{"number":499,"start":"00:19:03","end":"00:19:07","text":"出自这么浅薄的这一个人之口"},{"number":500,"start":"00:19:09","end":"00:19:11","text":"不过也无所吊味"},{"number":501,"start":"00:19:11","end":"00:19:12","text":"就一场梦而已嘛"},{"number":502,"start":"00:19:12","end":"00:19:13","text":"都得死"},{"number":503,"start":"00:19:13","end":"00:19:14","text":"都得醒啊"},{"number":504,"start":"00:19:14","end":"00:19:17","text":"好了诶好嘞"},{"number":505,"start":"00:19:17","end":"00:19:18","text":"最后再说一下"},{"numbe