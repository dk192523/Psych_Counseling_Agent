:47","text":"好下一位"},{"number":419,"start":"00:15:55","end":"00:15:58","text":"你们请很多老公进超市"},{"number":420,"start":"00:15:59","end":"00:16:00","text":"要不我先弄死他"},{"number":421,"start":"00:16:00","end":"00:16:02","text":"要不咱不干了"},{"number":422,"start":"00:16:02","end":"00:16:04","text":"现在没有可落地实操性"},{"number":423,"start":"00:16:05","end":"00:16:08","text":"你只是在跟你老婆说说啥"},{"number":424,"start":"00:16:08","end":"00:16:09","text":"咱就出来说一句话"},{"number":425,"start":"00:16:09","end":"00:16:09","text":"你别跟我说这些"},{"number":426,"start":"00:16:09","end":"00:16:10","text":"我很烦"},{"number":427,"start":"00:16:10","end":"00:16:11","text":"这种情况的话"},{"number":428,"start":"00:16:11","end":"00:16:15","text":"很多的时候并不仅仅是那个就是女孩子回来"},{"number":429,"start":"00:16:15","end":"00:16:17","text":"男生会怎么整也好"},{"number":430,"start":"00:16:17","end":"00:16:18","text":"其实不晓得这样的情况的话"},{"number":431,"start":"00:16:18","end":"00:16:20","text":"是男生回来了之后"},{"number":432,"start":"00:16:20","end":"00:16:21","text":"他媳妇怎么跟她说"},{"number":433,"start":"00:16:21","end":"00:16:23","text":"都不要不干嘛"},{"number":434,"start":"00:16:23","end":"00:16:24","text":"真能不干了吗"},{"number":435,"start":"00:16:24","end":"00:16:25","text":"那你"}],"sameDate":[{"slug":"2026-05-21-call-01","title":"女律师七年法律积累却要零基础写网文，咨询师：打造专业IP","date":"2026-05-21","duration":"28分48秒","index":345,"callNumber":1,"rawTranscriptUrl":"/raw/2026-05-21-call-01"},{"slug":"2026-05-21-call-02","title":"32岁女性丧母十年走不出，纠结生育动机，咨询师：重要的是生出来怎么养","date":"2026-05-21","duration":"16分25秒","index":346,"callNumber":2,"rawTranscriptUrl":"/raw/2026-05-21-call-02"},{"slug":"2026-05-21-call-03","title":"日本博士单亲妈妈回国迷茫求助，咨询师：保持生命力才是最好的教育","date":"2026-05-21","duration":"44分56秒","index":347,"callNumber":3,"rawTranscriptUrl":"/raw/2026-05-21-call-03"},{"slug":"2026-05-21-call-04","title":"上海女白领30岁以父母恩爱为模板寻男友，咨询师：自我绑架","date":"2026-05-21","duration":"14分59秒","index":348,"callNumber":4,"rawTranscriptUrl":"/raw/2026-05-21-call-04"},{"slug":"2026-05-21-call-05","title":"女公务员积蓄被父亲放高利贷讨债反被殴打，咨询