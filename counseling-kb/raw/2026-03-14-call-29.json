1:09","end":"00:11:10","text":"第二一个"},{"number":280,"start":"00:11:10","end":"00:11:12","text":"您看那个地方的话有没有工作机会可以捕获"},{"number":281,"start":"00:11:12","end":"00:11:16","text":"得到这两项条件就行了啊"},{"number":282,"start":"00:11:16","end":"00:11:18","text":"那这个销售岗位的话"},{"number":283,"start":"00:11:18","end":"00:11:22","text":"我总觉得他是不是跟地跟区域还有关系吗"},{"number":284,"start":"00:11:22","end":"00:11:24","text":"没有太大的关系"},{"number":285,"start":"00:11:24","end":"00:11:26","text":"哪儿都需要销售嗯"},{"number":286,"start":"00:11:26","end":"00:11:30","text":"主要只主要是看那个那个那个那叫什么"},{"number":287,"start":"00:11:30","end":"00:11:32","text":"就存了多少钱"},{"number":288,"start":"00:11:32","end":"00:11:34","text":"能存下来的钱多少"},{"number":289,"start":"00:11:34","end":"00:11:35","text":"对不对不对呀"},{"number":290,"start":"00:11:35","end":"00:11:37","text":"我没往这个方向说呀"},{"number":291,"start":"00:11:37","end":"00:11:38","text":"主要看你能不能获得"},{"number":292,"start":"00:11:38","end":"00:11:42","text":"以及匹配到和你目前的收入差别不是很大的"},{"number":293,"start":"00:11:42","end":"00:11:44","text":"或者说是心理上可接受的"},{"number":294,"start":"00:11:44","end":"00:11:48","text":"这样的一份薪资的工作机会啊"},{"number":295,"start":"00:11:50","end":"00:11:58","text":"嗯还有还有还有就是嗯我以前养了一只小猫"},{"number":296,"start":"00:11:58","end":"00:12:01","text":"然后呢"},{"number":297,"start":"00:12:03","end":"00:12:06","text":"然后那个然后我就猫毛过敏了"},{"number":298,"start":"00:12:06","end":"00:12:09","text":"但是当时已经养了56年了"},{"number":299,"start":"00:12:09","end":"00:12:12","text":"后来给送到老家去了"},{"number":300,"start":"00:12:16","end":"00:12:17","text":"那个"},{"number":301,"start":"00:12:21","end":"00:12:24","text":"也不是没死"},{"number":302,"start":"00:12:24","end":"00:12:25","text":"是这样的"},{"number":303,"start":"00:12:25","end":"00:12:27","text":"就是因为他本来难受啥呢"},{"number":304,"start":"00:12:27","end":"00:12:31","text":"哎呀就是觉得哎呀真是太多了"},{"number":305,"start":"00:12:31","end":"00:12:36","text":"我又想简单点的说就是这个猫吧"},{"number":306,"start":"00:12:36","end":"00:12:39","text":"嗯它本来是一只土猫"},{"number":307,"start":"00:12:39","end":"00:12:42","text":"后来这就是一个形象表达了"},{"number":308,"start":"00:12:42","end":"00:12:46","text":"让我们刚才都误以为这个猫被人吃了"},{"number":309,"start":"00:12:47","end":"00:12:50","text":"不是别撒娇"},{"number":310,"start":"00:12:50","end":"00:12:51","text":"好好说话"},{"number":311,"start":"00:12:51","end":"00:12:53","text":"这个猫咋了"},{"number":312,"start":"00:12:54","end":"00:13:00","text":"唉这种这种这个猫因为小的时候就是小土猫"},{"number":313,"start":"00:13:00","end":"00:13:03","text":"小的时候我到北京来养"},{"number":314,"start":"00:13:03","end":"00:13:04","text":"在出租屋里养"},{"number":315,"start":"00:13:04","end":"00:13:06","text":"后来养了56年之后"},{"number":316,"start":"00:13:06","end":"00:13:07","text":"我猫猫过敏"},{"number":317,"start":"00:13:07","end":"00:13:09","text":"我就给他送到老家去了"},{"number":318,"start":"00:13:09","end":"00:13:12","text":"我老家是在农村的"},{"number":319,"start":"00:13:12","end":"00:13:16","text":"然后现在这个因现在这个小猫就是回到家之后"},{"number":320,"start":"00:13:16","end":"00:13:19","text":"它也不怎么适应"},{"number":321,"start":"00:13:19","end":"00:13:24","text":"我反正就是感觉他不像正常的那种猫一样"},{"number":322,"start":"00:13:24","end":"00:13:28","text":"会经常把自己的身上舔的干干净净的"},{"number":323,"start":"00:13:28","end":"00:13:29","text":"眼睛也干干净净"},{"number":324,"start":"00:13:29","end":"00:13:33","text":"那不是他就有点"},{"number":325,"start":"00:13:35","end":"00:13:39","text":"那个白的爪子也特别的脏"},{"number":326,"start":"00:13:39","end":"00:13:42","text":"猫目前还活着吧"},{"number":327,"start":"00:13:44","end":"00:13:47","text":"活着呢那就行"},{"number":328,"start":"00:13:49","end":"00:13:51","text":"唉还行吧"},{"number":329,"start":"00:13:51","end":"00:13:53","text":"我感觉他活的邋里邋遢的"},{"number":330,"start":"00:13:53","end":"00:13:55","text":"特别像那种"},{"number":331,"start":"00:13:56","end":"00:14:02","text":"就是山沟里那种留守的儿童或者老人啥的"},{"number":332,"start":"00:14:02","end":"00:14:04","text":"联想能力过于丰富"},{"number":333,"start":"00:14:04","end":"00:14:08","text":"怕会被人家猫自己不在乎哈哈"},{"number":334,"start":"00:14:09","end":"00:14:11","text":"自然界的绝大多数"},{"number":335,"start":"00:14:11","end":"00:14:14","text":"我觉得他人家也有点自然界的绝大多数动物"},{"number":336,"start":"00:14:14","end":"00:14:16","text":"它也没有定期"},{"number":337,"start":"00:14:16","end":"00:14:19","text":"就是说是这种完整清洁"},{"number":338,"start":"00:14:19","end":"00:14:20","text":"那宠物是宠物"},{"number":339,"start":"00:14:20","end":"00:14:23","text":"这个猫它自己大概率人觉着挺自在就行啊"},{"number":340,"start":"00:14:23","end":"00:14:25","text":"你不用替它难过"},{"number":341,"start":"00:14:28","end":"00:14:29","text":"行"},{"number":342,"start":"00:14:29","end":"00:14:32","text":"那那我就不知道这个关于猫的还问不问"},{"number":343,"start":"00:14:32","end":"00:14:36","text":"就是我看不是有那种猫的那种项圈"},{"number":344,"start":"00:14:36","end":"00:14:39","text":"可以带那个摄像头的"},{"number":345,"start":"00:14:39","end":"00:14:43","text":"我其实挺想给她买一个带上"},{"number":346,"start":"00:14:43","end":"00:14:47","text":"然后呢看看他每天到底都去哪儿都干嘛"},{"number":347,"start":"00:14:47","end":"00:14:50","text":"那你再看看这猫它戴上去的舒不舒服"},{"number":348,"start":"00:14:50","end":"00:14:51","text":"那很多猫戴上舒服"},{"number":349,"start":"00:14:51","end":"00:14:54","text":"他啊舒服"},{"number":350,"start":"00:14:54","end":"00:14:57","text":"以前我以前我养的时候就给他买那种相片"},{"number":351,"start":"00:14:57","end":"00:15:05","text":"他都那就带哎呀不是那村里面有很多小孩"},{"number":352,"start":"00:15:05","end":"00:15:08","text":"我担心他那个那个他万一出去的话"},{"number":353,"start":"00:15:08","end":"00:15:11","text":"被别的孩子发现了哈哈"},{"number":354,"start":"00:15:11","end":"00:15:13","text":"那就不带"},{"number":355,"start":"00:15:13","end":"00:15:14","text":"就引起别人的注意"},{"number":356,"start":"00:15:14","end":"00:15:17","text":"那有没有什么别的好办法"},{"number":357,"start":"00:15:17","end":"00:15:20","text":"两全其美没有"},{"number":358,"start":"00:15:20","end":"00:15:20","text":"要不然带"},{"number":359,"start":"00:15:20","end":"00:15:21","text":"要不然不戴啊"},{"number":360,"start":"00:15:21","end":"00:15:22","text":"哎没有"},{"number":361,"start":"00:15:22","end":"00:15:25","text":"那不带那不带了"},{"number":362,"start":"00:15:25","end":"00:15:30","text":"然后再再就是哎这就是一个我"},{"number":363,"start":"00:15:30","end":"00:15:33","t