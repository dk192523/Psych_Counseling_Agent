:"00:08:33","text":"你今年多大岁数"},{"number":196,"start":"00:08:33","end":"00:08:34","text":"我今年33岁"},{"number":197,"start":"00:08:34","end":"00:08:35","text":"33岁"},{"number":198,"start":"00:08:35","end":"00:08:37","text":"两年之后你多大岁数"},{"number":199,"start":"00:08:37","end":"00:08:38","text":"35岁"},{"number":200,"start":"00:08:38","end":"00:08:39","text":"那个时候你的同龄人的话"},{"number":201,"start":"00:08:39","end":"00:08:41","text":"孩子基本上多大"},{"number":202,"start":"00:08:45","end":"00:08:47","text":"你在这越待下去"},{"number":203,"start":"00:08:48","end":"00:08:52","text":"越会沦为横向比较的末位者"},{"number":204,"start":"00:08:52","end":"00:08:54","text":"即便你说你不在乎"},{"number":205,"start":"00:08:54","end":"00:08:55","text":"你不可能不受其影响"},{"number":206,"start":"00:08:55","end":"00:08:58","text":"因为家人也会给你压力"},{"number":207,"start":"00:08:58","end":"00:08:59","text":"是是"},{"number":208,"start":"00:08:59","end":"00:09:01","text":"所以我现在基本是属于一种"},{"number":209,"start":"00:09:01","end":"00:09:04","text":"断绝社交关系的状态"},{"number":210,"start":"00:09:04","end":"00:09:05","text":"这个叫做逃避呀"},{"number":211,"start":"00:09:05","end":"00:09:06","text":"是一种逃避"},{"number":212,"start":"00:09:06","end":"00:09:08","text":"不解决问题啊"},{"number":213,"start":"00:09:08","end":"00:09:09","text":"是的"},{"number":214,"start":"00:09:10","end":"00:09:11","text":"所以我也明白"},{"number":215,"start":"00:09:11","end":"00:09:12","text":"所以我也希望对"},{"number":216,"start":"00:09:12","end":"00:09:15","text":"所以说今天也是想听听您"},{"number":217,"start":"00:09:15","end":"00:09:20","text":"您您能以前在外边学过什么专业"},{"number":218,"start":"00:09:20","end":"00:09:23","text":"当年学的是数学与统计"},{"number":219,"start":"00:09:24","end":"00:09:25","text":"不过已经活了很多年了"},{"number":220,"start":"00:09:25","end":"00:09:28","text":"有什么兴趣爱好"},{"number":221,"start":"00:09:30","end":"00:09:34","text":"哦可能没有什么谈得上拿得出手的兴趣啊"},{"number":222,"start":"00:09:34","end":"00:09:36","text":"不过后面也学过一点点编程"},{"number":223,"start":"00:09:36","end":"00:09:38","text":"然后做过一点尝试"},{"number":224,"start":"00:09:38","end":"00:09:40","text":"但是后面没有没有通通过这个找到工作"},{"number":225,"start":"00:09:40","end":"00:09:42","text":"其实也不是是没有坚持"},{"number":226,"start":"00:09:42","end":"00:09:44","text":"没有把那个工作坚持下去好"},{"number":227,"start":"00:09:44","end":"00:09:45","text":"我现在要告诉你的是"},{"number":228,"start":"00:09:45","end":"00:09:49","text":"按照你之前的这样的一个专业积累的话"},{"number":229,"start":"00:09:49","end":"00:09:51","text":"也没有什么太有效的这个积累"},{"number":230,"start":"00:09:51","end":"00:09:52","text":"是的"},{"number":231,"start":"00:09:52","end":"00:09:54","text":"所以摆正一个心态"},{"number":232,"start":"00:09:54","end":"00:09:57","text":"如果选择脱离这个环境出去历练一下"},{"number":233,"start":"00:09:57","end":"00:09:58","text":"尝试一下"},{"number":234,"start":"00:09:58","end":"00:09:59","text":"成长一下的话"},{"number":235,"start":"00:09:59","end":"00:10:01","text":"有可能要从基层底层工作做起"},{"number":236,"start":"00:10:01","end":"00:10:02","text":"这是一条路"},{"number":237,"start":"00:10:02","end":"00:10:04","text":"还有更大的可能性是资源"},{"number":238,"start":"00:10:04","end":"00:10:07","text":"这个东西并不是只能够靠自己来获取"},{"number":239,"start":"00:10:07","end":"00:10:09","text":"有可能你的家庭和家族自带资源"},{"number":240,"start":"00:10:09","end":"00:10:11","text":"你也可以提出你的这个想法"},{"number":241,"start":"00:10:11","end":"00:10:13","text":"希望你的家族给你匹配这样的资源"},{"number":242,"start":"00:10:13","end":"00:10:15","text":"哪怕你换一个城市"},{"number":243,"start":"00:10:15","end":"00:10:16","text":"换一个地方"},{"number":244,"start":"00:10:16","end":"00:10:18","text":"他有可能是这个厂子的甲方或者乙方"},{"number":245,"start":"00:10:18","end":"00:10:19","text":"上游或者是下游的"},{"number":246,"start":"00:10:19","end":"00:10:21","text":"有横向连接关系的"},{"number":247,"start":"00:10:21","end":"00:10:23","text":"先脱离当下的这个环境"},{"number":248,"start":"00:10:23","end":"00:10:28","text":"OK是就是对"},{"number":249,"start":"00:10:28","end":"00:10:30","text":"就当下这个环境"},{"number":250,"start":"00:10:30","end":"00:10:34","text":"其实感觉就还是我跟我爸的那个关系"},{"number":251,"start":"00:10:34","end":"00:10:35","text":"他就"},{"number":252,"start":"00:10:38","end":"00:10:40","text":"反正感觉只要我爸的影响力在那里"},{"number":253,"start":"00:10:40","end":"00:10:43","text":"我就觉得不是不是很舒服"},{"number":254,"start":"00:10:43","end":"00:10:45","text":"小孩子想学走路的话"},{"number":255,"start":"00:10:45","end":"00:10:49","text":"就必须大人要舍得把他们给放下地的"},{"number":256,"start":"00:10:49","end":"00:10:50","text":"对"},{"number":257,"start":"00:10:50","end":"00:10:53","text":"就是就是之前之前住5年之前"},{"number":258,"start":"00:10:53","end":"00:10:55","text":"我尝试过换一个城市嘛"},{"number":259,"start":"00:10:55","end":"00:11:04","text":"然后这是最后嗯嗯就是他总会给我要求时间"},{"number":260,"start":"00:11:04","end":"00:11:07","text":"但是我我我也说不清我当时的状态"},{"number":261,"start":"00:11:07","end":"00:11:09","text":"那种那种感觉吧"},{"number":262,"start":"00:11:09","end":"00:11:14","text":"但是最后可能其实是没有说真正的做过"},{"number":263,"start":"00:11:14","end":"00:11:17","text":"上一个很好很正向的一个渠道的话"},{"number":264,"start":"00:11:17","end":"00:11:18","text":"不加强陈述了啊"},{"number":265,"start":"00:11:18","end":"00:11:21","text":"当下的这块的话你也不满意"},{"number":266,"start":"00:11:21","end":"00:11:23","text":"那就改变好不好"},{"number":267,"start":"00:11:23","end":"00:11:26","text":"我能唯一能告诉你就是改变调整更换环境"},{"number":268,"start":"00:11:26","end":"00:11:27","text":"好的好"},{"number":269,"start":"00:11:27","end":"00:11:28","text":"具体怎么做"},{"number":270,"start":"00:11:28","end":"00:11:30","text":"自己去想"},{"number":271,"start":"00:11:30","end":"00:11:32","text":"嗯拜拜OK嗯"},{"number":272,"start":"00:11:32","end":"00:11:32","text":"好谢谢"},{"number":273,"start":"00:11:32","end":"00:11:33","text":"谢谢斌哥"},{"number":274,"start":"00:11:33","end":"00:11:35","text":"客气再见嗯"},{"number":275,"start":"00:11:36","end":"00:11:37","text":"怕啥呀"},{"number":276,"start":"00:11:38","end":"00:11:39","text":"大不了回来了"},{"number":277,"start":"00:11:39","end":"00:11:40","text":"只有继承家产"}],"sameDate":[{"slug":"2026-05-03-call-01","title":"咨询师回忆早年在主持到吐血，坦言直播是大家互相成就","date":"2026-05-03","duration":"12分51秒","index":454,"callNumber":1,"rawTranscriptUrl":"/raw/2026-05-03-call-01"},{"slug":"2026-05-03-cal