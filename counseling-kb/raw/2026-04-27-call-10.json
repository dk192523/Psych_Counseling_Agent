","end":"00:22:42","text":"很简单"},{"number":557,"start":"00:22:42","end":"00:22:43","text":"叫做刚上班综合症"},{"number":558,"start":"00:22:43","end":"00:22:45","text":"别看你上班两年了"},{"number":559,"start":"00:22:45","end":"00:22:46","text":"刨掉了你的实习期"},{"number":560,"start":"00:22:46","end":"00:22:50","text":"抛掉了你的这时间时间也没有太长"},{"number":561,"start":"00:22:50","end":"00:22:52","text":"而在这两年过程当中的话"},{"number":562,"start":"00:22:52","end":"00:22:53","text":"你刚刚完成了一个身份的转换"},{"number":563,"start":"00:22:53","end":"00:22:56","text":"从一个学生变成了一个职场人"},{"number":564,"start":"00:22:56","end":"00:22:59","text":"从一个安全的就是被保护的壳子里边"},{"number":565,"start":"00:22:59","end":"00:23:01","text":"到了一个残酷的社会竞争"},{"number":566,"start":"00:23:01","end":"00:23:03","text":"又是在干一线销售工作"},{"number":567,"start":"00:23:03","end":"00:23:03","text":"这个时候的话"},{"number":568,"start":"00:23:03","end":"00:23:05","text":"不管是价值观信息的密度"},{"number":569,"start":"00:23:05","end":"00:23:07","text":"都跟往日的话不可相提并论"},{"number":570,"start":"00:23:07","end":"00:23:09","text":"在此情况之下的话"},{"number":571,"start":"00:23:09","end":"00:23:10","text":"有些人接受的速度比较快"},{"number":572,"start":"00:23:10","end":"00:23:13","text":"有些人兼容的速度相对比较慢一点点"},{"number":573,"start":"00:23:13","end":"00:23:15","text":"但都属于可控的一个正常的范畴之内"},{"number":574,"start":"00:23:15","end":"00:23:18","text":"我们只看最基础的一点经济基本盘"},{"number":575,"start":"00:23:18","end":"00:23:20","text":"你是否每个月可以拿到"},{"number":576,"start":"00:23:20","end":"00:23:21","text":"是不是相对恒定的"},{"number":577,"start":"00:23:21","end":"00:23:24","text":"匹配得上你劳动付出的这部分薪资"},{"number":578,"start":"00:23:24","end":"00:23:25","text":"如果有的话"},{"number":579,"start":"00:23:25","end":"00:23:27","text":"别的没什么太大的事啊"},{"number":580,"start":"00:23:27","end":"00:23:29","text":"嗯好的"},{"number":581,"start":"00:23:29","end":"00:23:30","text":"谢谢大兵叔叔"},{"number":582,"start":"00:23:30","end":"00:23:32","text":"那我这边没有什么问题了"},{"number":583,"start":"00:23:32","end":"00:23:34","text":"感谢您好嘞"},{"number":584,"start":"00:23:34","end":