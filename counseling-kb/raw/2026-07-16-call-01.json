:13:33","text":"但是我有发视频"},{"number":278,"start":"00:13:33","end":"00:13:34","text":"视频号什么的"},{"number":279,"start":"00:13:34","end":"00:13:36","text":"我都有录"},{"number":280,"start":"00:13:36","end":"00:13:38","text":"5年来的点点滴滴呢"},{"number":281,"start":"00:13:38","end":"00:13:39","text":"我都有录像"},{"number":282,"start":"00:13:39","end":"00:13:40","text":"然后发表"},{"number":283,"start":"00:13:40","end":"00:13:41","text":"您不必告诉我"},{"number":284,"start":"00:13:41","end":"00:13:42","text":"您可以告诉告诉"},{"number":285,"start":"00:13:42","end":"00:13:45","text":"就是这个就是离您就近的啊"},{"number":286,"start":"00:13:45","end":"00:13:47","text":"所在辖区的派出所的民警"},{"number":287,"start":"00:13:47","end":"00:13:48","text":"你可以跟他们讲"},{"number":288,"start":"00:13:48","end":"00:13:50","text":"也可以打110讲"},{"number":289,"start":"00:13:51","end":"00:13:54","text":"但是他们这样子只是口头警告"},{"number":290,"start":"00:13:54","end":"00:13:58","text":"那我知我明知道他们背后有人"},{"number":291,"start":"00:13:58","end":"00:14:01","text":"我觉得打这个电话没有多大的意义"},{"number":292,"start":"00:14:01","end":"00:14:03","text":"那我们帮你关一"},{"number":293,"start":"00:14:03","end":"00:14:05","text":"我们能够想到的此类的骚扰"},{"number":294,"start":"00:14:05","end":"00:14:07","text":"最好的解决方法就是报警"},{"number":295,"start":"00:14:07","end":"00:14:08","text":"但是你告诉我的是"},{"number":296,"start":"00:14:08","end":"00:14:10","text":"我不信你不信任警方的力量"},{"number":297,"start":"00:14:10","end":"00:14:11","text":"不信任报警的这个动作"},{"number":298,"start":"00:14:11","end":"00:14:14","text":"那我这没有别的更好的方案啊"},{"number":299,"start":"00:14:19","end":"00:14:32","text":"那我那你呃那我想就是呃我我有点就是但就是坚持不下"},{"number":300,"start":"00:14:32","end":"00:14:34","text":"就是每做一件事情"},{"number":301,"start":"00:14:34","end":"00:14:36","text":"然后坚持不下去"},{"number":302,"start":"00:14:37","end":"00:14:39","text":"那这个应该怎么改变呢"},{"number":303,"start":"00:14:39","end":"00:14:42","text":"呃如果您不选择去看医生的话"},{"number":304,"start":"00:14:42","end":"00:14:46","text":"我这边的话没有办法给您提供一个直接解决的方案"},{"number":305,"start":"00:14:46","end":"00:14:49","text":"因为我对您的状态这块现在目前是存疑嘛"},{"number":306,"start":"00:14:49","end":"00:14:51","text":"心理的基本稳定"},{"number":307,"start":"00:14:51","end":"00:14:52","text":"心理的基本健康"},{"number":308,"start":"00:14:52","end":"00:14:57","text":"乃至于精神卫生层面的一个就是这块的话还是有点存疑"},{"number":309,"start":"00:14:57","end":"00:15:01","text":"所以的话你只要涉及到跟心理相关或者情绪相关的议题"},{"number":310,"start":"00:15:01","end":"00:15:03","text":"我给您唯一的建议就是要去看一下医生"},{"number":311,"start":"00:15:03","end":"00:15:06","text":"正规三甲医院啊"},{"number":312,"start":"00:15:08","end":"00:15:12","text":"你是从哪个方面判断出我有心理"},{"number":313,"start":"00:15:12","end":"00:15:15","text":"您不用管我从哪个方面来判断"},{"number":314,"start":"00:15:15","end":"00:15:17","text":"你只需要听我的结论就行"},{"number":315,"start":"00:15:17","end":"00:15:20","text":"当然你也可以选择不听我的结论"},{"number":316,"start":"00:15:20","end":"00:15:21","text":"因为当你来问我"},{"number":317,"start":"00:15:21","end":"00:15:22","text":"你从哪个阶段来判断呢"},{"number":318,"start":"00:15:22","end":"00:15:24","text":"实际上你是打算跟我来博弈一下吗"},{"number":319,"start":"00:15:24","end":"00:15:26","text":"咱们俩不辩论的吗"},{"number":320,"start":"00:15:26","end":"00:15:31","text":"没有我因为我我去龙岩的时候有看过"},{"number":321,"start":"00:15:31","end":"00:15:34","text":"然后他们说那个"},{"number":322,"start":"00:15:36","end":"00:15:41","text":"他们就说你就是因为我跟就怎么怎么说呢"},{"number":323,"start":"00:15:41","end":"00:15:45","text":"带同宿舍就是大学宿舍"},{"number":324,"start":"00:15:45","end":"00:15:48","text":"像那个同宿舍四五个人一群"},{"number":325,"start":"00:15:48","end":"00:15:50","text":"那我在集体当中呢"},{"number":326,"start":"00:15:50","end":"00:15:53","text":"我又成就是感觉那个场景重现"},{"number":327,"start":"00:15:53","end":"00:15:55","text":"然后我又受到了欺负"},{"number":328,"start":"00:15:55","end":"00:15:58","text":"然后我咨询那个心理医生去看的时候"},{"number":329,"start":"00:15:58","end":"00:16:03","text":"他就他说我是因为我的问题是低自尊"},{"number":330,"start":"00:16:05","end":"00:16:07","text":"额这个东西不叫专业术语啊"},{"number":331,"start":"00:16:07","end":"00:16:09","text":"我不知道您看的是什么医生"},{"number":332,"start":"00:16:09","end":"00:16:10","text":"我能建议您的是"},{"number":333,"start":"00:16:10","end":"00:16:11","text":"如果您离福州近"},{"number":334,"start":"00:16:11","end":"00:16:15","text":"上福州正规三甲医院有相应科室的挂号"},{"number":335,"start":"00:16:15","end":"00:16:16","text":"然后来看一下"},{"number":336,"start":"00:16:16","end":"00:16:17","text":"花不了多少钱"},{"number":337,"start":"00:16:17","end":"00:16:20","text":"挂号费很便宜"},{"number":338,"start":"00:16:22","end":"00:16:24","text":"这个问题解决不了的话"},{"number":339,"start":"00:16:24","end":"00:16:26","text":"我就没法工作了是吗"},{"number":340,"start":"00:16:27","end":"00:16:28","text":"这个你自己评判"},{"number":341,"start":"00:16:28","end":"00:16:30","text":"因为你能不能够工作的话"},{"number":342,"start":"00:16:30","end":"00:16:32","text":"这个我不清楚"},{"number":343,"start":"00:16:32","end":"00:16:33","text":"我不了解您的"},{"number":344,"start":"00:16:33","end":"00:16:37","text":"但是根据您刚才的描述的话时可不必问这个问题"},{"number":345,"start":"00:16:37","end":"00:16:38","text":"因为您刚才很清楚的告诉我们"},{"number":346,"start":"00:16:38","end":"00:16:40","text":"您现在的状态很糟糕"},{"number":347,"start":"00:16:40","end":"00:16:41","text":"没有办法来胜任工作"},{"number":348,"start":"00:16:41","end":"00:16:43","text":"也没有办法来胜任"},{"number":349,"start":"00:16:43","end":"00:16:46","text":"而不是来正常的来生活了呀"},{"number":350,"start":"00:16:54","end":"00:16:56","text":"好像也是"},{"number":351,"start":"00:17:04","end":"00:17:06","text":"嗯那我没问题了"},{"number":352,"start":"00:17:06","end":"00:17:07","text":"好再见"},{"number":353,"start":"00:17:12","end":"00:17:14","text":"再见再见"}],"sameDate":[{"slug":"2026-07-16-call-01","title":"33岁脑瘫后遗症患者被全村叫白痴长大，深陷妄想恐惧无法正常生活","date":"2026-07-16","duration":"17分42秒","index":13,"callNumber":1,"rawTranscriptUrl":"/raw/2026-07-16-call-01"},{"slug":"2026-07-16-call-02","title":"山东女博士该不该为江苏男友放弃编制，咨询师：牺牲感比异地更危险","date":"2026-07-16","duration":"9分0秒","index":14,"callNumber":2,"rawTranscriptUrl":"/raw/2026-07-16-call-02"},{"slug":"2026-07-16-call-03","title":"30岁硕士尝试AI自媒体游戏剪辑又炒股，问咨询师如何靠副业赚500万","date":"2026-07-16","duration":"14分30秒","index":15,"callNumber":3,"rawTranscr