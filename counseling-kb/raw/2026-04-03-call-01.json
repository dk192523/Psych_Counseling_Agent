16:41","text":"你就听得懂了"},{"number":332,"start":"00:16:41","end":"00:16:44","text":"就是不够勇敢对吧"},{"number":333,"start":"00:16:44","end":"00:16:46","text":"哎没有那么的勇敢"},{"number":334,"start":"00:16:46","end":"00:16:48","text":"没有那么勇敢的去面对各种挑战"},{"number":335,"start":"00:16:48","end":"00:16:51","text":"没有那么那么勇敢的去面对压力"},{"number":336,"start":"00:16:51","end":"00:16:54","text":"那么真实的勇敢从哪里来呢"},{"number":337,"start":"00:16:54","end":"00:16:56","text":"真实的这个勇敢呀"},{"number":338,"start":"00:16:56","end":"00:17:00","text":"他永远是基于真实的被保护以及被爱"},{"number":339,"start":"00:17:00","end":"00:17:02","text":"是被承载以及被看见"},{"number":340,"start":"00:17:02","end":"00:17:06","text":"基于此才能够产生真实的勇敢"},{"number":341,"start":"00:17:06","end":"00:17:08","text":"要不然的话呢对仗出来的那种勇敢"},{"number":342,"start":"00:17:08","end":"00:17:11","text":"或者说是硬逼着自己挤压出来的那种勇敢"},{"number":343,"start":"00:17:11","end":"00:17:14","text":"那是纸老虎那个东西"},{"number":344,"start":"00:17:14","end":"00:17:15","text":"它可以用一会儿"},{"number":345,"start":"00:17:15","end":"00:17:17","text":"他长期用的话没有用的呀"},{"number":346,"start":"00:17:17","end":"00:17:19","text":"好吗"},{"number":347,"start":"00:17:19","end":"00:17:22","text":"嗯请注意她并不是说是嫁给你了之后"},{"number":348,"start":"00:17:22","end":"00:17:24","text":"她就停止了生长和成长"},{"number":349,"start":"00:17:24","end":"00:17:25","text":"他有他的成长期"},{"number":350,"start":"00:17:25","end":"00:17:30","text":"在他原生家庭父母亲那边被养育的这个过程"},{"number":351,"start":"00:17:30","end":"00:17:32","text":"但是他和你组建了新的家庭了之后啊"},{"number":352,"start":"00:17:32","end":"00:17:36","text":"你们两个人都是在这段关系当中彼此成长的"},{"number":353,"start":"00:17:36","end":"00:17:39","text":"正向的好的关系是在一段关系当中"},{"number":354,"start":"00:17:39","end":"00:17:42","text":"双方皆可获得成长"},{"number":355,"start":"00:17:42","end":"00:17:44","text":"而这种成长的过程当中啊"},{"number":356,"start":"00:17:44","end":"00:17:48","text":"他是需要彼此为对方承担一定的责任义务"},{"number":357,"start":"00:17:48","end":"00:17:53","text":"其中有非常重要的一项叫做情绪的承载以及情感的支撑"},{"number":358,"start":"00:17:53","end":"00:17:55","text":"如果这一点的话"},{"number":359,"start":"00:17:55","end":"00:17:56","text":"没有办法做到啊"},{"number":360,"start":"00:17:56","end":"00:17:58","text":"或者说做的不太好"},{"number":361,"start":"00:17:58","end":"00:18:00","text":"他的获取路径受阻啊"},{"number":362,"start":"00:18:00","end":"00:18:05","text":"我们不能够指望他面对这个世界更大压力来源的这些时候"},{"number":363,"start":"00:18:05","end":"00:18:06","text":"他有多么的勇敢"},{"number":364,"start":"00:18:06","end":"00:18:09","text":"所以这个事归根到底也不能太怪他啊"},{"number":365,"start":"00:18:09","end":"00:18:12","text":"好吗好的"},{"number":366,"start":"00:18:12","end":"00:18:14","text":"我这么掰开揉碎了"},{"number":367,"start":"00:18:14","end":"00:18:15","text":"说你听得懂了吗"},{"number":368,"start":"00:18:16","end":"00:18:17","text":"听懂听懂"},{"number":369,"start":"00:18:17","end":"00:18:20","text":"所以你告诉我接下来你会怎么做"},{"number":370,"start":"00:18:22","end":"00:18:26","text":"接下来就是多承担一点这个当丈夫的责任吧"},{"number":371,"start":"00:18:26","end":"00:18:29","text":"然后对于她的一些情绪啊"},{"number":372,"start":"00:18:29","end":"00:18:30","text":"然后宣泄啊"},{"number":373,"start":"00:18:30","end":"00:18:32","text":"多包容一些"},{"number":374,"start":"00:18:32","end":"00:18:34","text":"亲亲抱抱举高高会不会哎"},{"number":375,"start":"00:18:34","end":"00:18:38","text":"就是亲亲抱抱举高高会不会啊"},{"number":376,"start":"00:18:38","end":"00:18:40","text":"会会呼噜呼噜头"},{"number":377,"start":"00:18:40","end":"00:18:41","text":"摸摸背"},{"number":378,"start":"00:18:41","end":"00:18:46","text":"会不会嗯会哦好了好了好了"},{"number":379,"start":"00:18:46","end":"00:18:47","text":"哎哟哟哟哟哟好了好了"},{"number":380,"start":"00:18:47","end":"00:18:48","text":"哎呀"},{"number":381,"start":"00:18:48","end":"00:18:49","text":"没事没事"},{"number":382,"start":"00:18:49","end":"00:18:49","text":"有我在呢"},{"number":383,"start":"00:18:49","end":"00:18:50","text":"哎呀呀呀"},{"number":384,"start":"00:18:50","end":"00:18:51","text":"没事没事没事"},{"number":385,"start":"00:18:51","end":"00:18:53","text":"哎呀呀呀呀呀呀呀呀呀啊"},{"number":386,"start":"00:18:53","end":"00:18:53","text":"没事没事没事来"},{"number":387,"start":"00:18:53","end":"00:18:55","text":"我给你拿张纸来醒醒鼻子"},{"number":388,"start":"00:18:55","end":"00:18:56","text":"哭完了再说"},{"number":389,"start":"00:18:56","end":"00:18:57","text":"哎呀没事儿"},{"number":390,"start":"00:18:57","end":"00:18:57","text":"没事儿"},{"number":391,"start":"00:18:57","end":"00:18:57","text":"哎呀"},{"number":392,"start":"00:18:57","end":"00:18:59","text":"你已经很厉害了"},{"number":393,"start":"00:18:59","end":"00:19:01","text":"你换了别人哪能撑这么久啊"},{"number":394,"start":"00:19:01","end":"00:19:02","text":"对不对"},{"number":395,"start":"00:19:02","end":"00:19:03","text":"没事儿"},{"number":396,"start":"00:19:03","end":"00:19:03","text":"没事儿没事儿"},{"number":397,"start":"00:19:03","end":"00:19:04","text":"天塌下来"},{"number":398,"start":"00:19:04","end":"00:19:04","text":"有我呢"},{"number":399,"start":"00:19:04","end":"00:19:06","text":"不怕不怕不怕"},{"number":400,"start":"00:19:06","end":"00:19:07","text":"但是怎么样"},{"number":401,"start":"00:19:07","end":"00:19:07","text":"但是怎么样"},{"number":402,"start":"00:19:07","end":"00:19:11","text":"但是每一个但是给他接住了就好"},{"number":403,"start":"00:19:11","end":"00:19:14","text":"你猜我为什么当年那么早"},{"number":404,"start":"00:19:14","end":"00:19:17","text":"当年那本书叫乖摸摸头啊"},{"number":405,"start":"00:19:17","end":"00:19:19","text":"官摸摸头的话"},{"number":406,"start":"00:19:19","end":"00:19:20","text":"那是官方说话"},{"number":407,"start":"00:19:20","end":"00:19:25","text":"实际上我真实那个书名的意思是很难用书面语言写出来的"},{"number":408,"start":"00:19:25","end":"00:19:26","text":"他其实就是一个动作"},{"number":409,"start":"00:19:26","end":"00:19:28","text":"就是哦哟哟哟好了好了"},{"number":410,"start":"00:19:28","end":"00:19:28","text":"哎呦呦"},{"number":411,"start":"00:19:28","end":"00:19:29","text":"没事没事哦"},{"number":412,"start":"00:19:29","end":"00:19:34","text":"哟哟哟哟哎哟哟哟哟哟哟哟哟哦哟哟哟哟哎呦呦哎"},{"number":413,"start":"00:19:34","end":"00:19:36","text":"好好好好好好好哦呦呦呦"},{"number":414,"start":"00:19:36","end":"00:19:38","text":"这就是关摸摸头的意思"},{"number":415,"start":"00:19:38","end":"00:19:40","text":"他是一次抚慰"},{"number":416,"start":"00:19:40","end":"00:19:41","text":"一种陪伴"},{"number":417,"start":"00:19:41","end":"00:19:42","text":"一种抚慰"},{"number":418,"start":"00:19:42","end":"00:19:45","text":"一种承载啊"},{"number":419,"start":"00:19:45","end":"00:19:47","text":"好谢谢斌哥"},{"number":420,"start":"00:19:47","end":"00:19:49","text":"你怎么有点失落呢"},{"number":421,"start":"00:19:49","end":"00:19:51","text":"我知道你心里面想的是啥"},{"number":422,"start":"00:19:51","end":"00:19:52","text":"我哄他"},{"number":423,"start":"00:19:52","end":"00:19:54","text":"谁哄我是吧"},{"number":424,"start":"00:19:55","end":"00:19:57","text":"可能有这点意思吧"},{"number":425,"start":"00:19:57","end":"00:20:01","text":"因为有时候确实有时候我也有有一定压力的"},{"number":426,"start":"00:20:01","end":"00:20:05","text":"然后我自己其实对于自己这个情绪处理啊"},{"number":427,"start":"00:20:05","end":"00:20:07","text":"我也是就是来得快去得快"},{"number":428,"start":"00:20:07","end":"00:20:09","text":"我也其实我也很清楚"},{"number":429,"start":"00:20:09","end":"00:20:10","text":"应该多包容他一点"},{"number":430,"start":"00:20:10","end":"00:20:12","text":"但是有时候那个劲儿上来了"},{"number":431,"start":"00:20:12","end":"00:20:13","text":"就是没办法控制住"},{"number":432,"start":"00:20:13","end":"00:20:15","text":"自己可以控制得住"},{"number":433,"start":"00:20:15","end":"00:20:17","text":"首先你相信自己可以控制得住"},{"number":434,"start":"00:20:17","end":"00:20:18","text":"你就控制得住"},{"number":435,"start":"00:20:18","end":"00:20:20","text":"第二一个的话"},{"number":436,"start":"00:20:20","end":"00:20:26","text":"这反而对于婚姻家庭模式关系当中稍微心理稍微强大一点的人而言"},{"number":437,"start":"00:20:26","end":"00:20:28","text":"这是很好的一个成长的机会啊"},{"number":438,"start":"00:20:28","end":"00:20:38","text":"因为你去承载对方承载者本身获得的这个成长比被承载者是要多的哦"},{"number":439,"start":"00:20:38","end":"00:20:42","text":"他其实是很好的一次修身的机会"},{"number":440,"start":"00:20:42","end":"00:20:44","text":"所谓的修身齐家"},{"number":441,"start":"00:20:44","end":"00:20:46","text":"为什么是不上来说齐家呢"},{"number":442,"start":"00:20:46","end":"00:20:47","text":"说先说修身"},{"number":443,"start":"00:20:47","end":"00:20:50","text":"家庭关系模式当中其实是最好修身的"},{"number":444,"start":"00:20:50","end":"00:20:56","text":"我有时候看到包括网上又有一些朋友专门往深山老林子扎"},{"number":445,"start":"00:20:56","end":"00:20:59","text":"专门的话又又去求这个发育干嘛"},{"number":446,"start":"00:20:59","end":"00:21:01","text":"不是不是不是你你单纯你只是在各种人际关系"},{"number":447,"start":"00:21:01","end":"00:21:03","text":"尤其亲密关系当中"},{"number":448,"start":"00:21:03","end":"00:21:07","text":"你能够愿意去做以及做到一些责任向的一些东西"},{"number":449,"start":"00:21:07","end":"00:21:10","text":"他已经是很好的一个修持修炼"},{"number":450,"start":"00:21:10","end":"00:21:13","text":"对你自己而言也是很好的一个成长了嘛"},{"number":451,"start":"00:21:13","end":"00:21:16","text":"对不对对嗯"},{"number":452,"start":"00:21:16","end":"00:21:18","text":"两个人如果都不做出改变"},{"number":453,"start":"00:21:18","end":"00:21:20","text":"都不做出调整的话"},{"number":454,"start":"00:21:20","end":"00:21:22","text":"日子会越过越难呢"},{"number":455,"start":"00:21:22","end":"00:21:23","text":"好不好"},{"number":456,"start":"00:21:23","end":"00:21:25","text":"但是一旦做出了调整了之后"},{"number":457,"start":"00:21:25","end":"00:21:27","text":"我们就静观其变了"},{"number":458,"start":"00:21:27","end":"00:21:30","text":"他呢现在的这种不勇敢的程度"},{"number":459,"start":"00:21:30","end":"00:21:33","text":"你看30岁的年龄都已经辐射到了"},{"number":460,"start":"00:21:33","end":"00:21:35","text":"对于生育本身了"},{"number":461,"start":"00:21:35","end":"00:21:36","text":"请注意啊"},{"number":462,"start":"00:21:36","end":"00:21:38","text":"生育啊是我们生物的本能啊"},{"number":463,"start":"00:21:38","end":"00:21:41","text":"已经触碰到它的这种基础本能了"},{"number":464,"start":"00:21:41","end":"00:21:44","text":"他对这个世界的恐惧感已经足够多了"},{"number":465,"start":"00:21:44","end":"00:21:46","text":"反向印证就是它被承载的还是少"},{"number":466,"start":"00:21:46","end":"00:21:50","text":"我不是在说你们的夫妻感情或者是关系不好"},{"number":467,"start":"00:21:50","end":"00:21:52","text":"而是长此以往的话"},{"number":468,"start":"00:21:52","end":"00:21:55","text":"这种承载动作老是做的不到位的话呀"},{"number":469,"start":"00:21:55","end":"00:21:58","text":"他都不是说要你每次都到位"},{"number":470,"start":"00:21:58","end":"00:22:00","text":"你每年总得有几回到位吧"},{"number":471,"start":"00:22:00","end":"00:22:03","text":"我每个月总得有一回是到位的吧"},{"number":472,"start":"00:22:03","end":"00:22:03","text":"到位了"},{"number":473,"start":"00:22:03","end":"00:22:06","text":"那几回的话他就管用了好吗"},{"number":474,"start":"00:22:08","end":"00:22:09","text":"嗯好的"},{"number":475,"start":"00:22:09","end":"00:22:10","text":"听兵哥说"},{"number":476,"start":"00:22:10","end":"00:22:12","text":"这是我刚才的这番话"},{"number":477,"start":"00:22:12","end":"00:22:14","text":"把你专门叫过来啊"},{"number":478,"start":"00:22:14","end":"00:22:22","text":"实际上是等于用这番话送你一份生日礼物好吗"},{"number":479,"start":"00:22:22","end":"00:22:22","text":"好"},{"number":480,"start":"00:22:22","end":"00:22:23","text":"谢谢斌哥"},{"number":481,"start":"00:22:23","end":"00:22:24","text":"这是你说的话"},{"number":482,"start":"00:22:24","end":"00:22:25","text":"我会我会谨记的"},{"number":483,"start":"00:22:25","end":"00:22:26","text":"嘿嘿好嘞"},{"number":484,"start":"00:22:26","end":"00:22:29","text":"这番话就是送给你的生日礼物哈"},{"number":485,"start":"00:22:29","end":"00:22:30","text":"赵哥拜拜"},{"number":486,"start":"00:22:30","end":"00:22:32","text":"没人好好谢谢你"},{"number":487,"start":"00:22:32","end":"00:22:37","text":"嗯没事拜拜嗯拜拜"},{"number":488,"start":"00:22:40","end":"00:22:41","text":"我哄她"},{"number":489,"start":"00:22:41","end":"00:22:42","text":"谁哄我呀"},{"number":490,"start":"00:22:42","end":"00:22:45","text":"不是总得有一个人迈出第一步"},{"number":491,"start":"00:22:45","end":"00:22:46","text":"你哄了她"},{"number":492,"start":"00:22:46","end":"00:22:48","text":"你承载了他"},{"number":493,"start":"00:22:48","end":"00:22:50","text":"他慢慢强大起来"},{"number":494,"start":"00:22:50","end":"00:22:51","text":"他慢慢勇敢起来"},{"number":495,"start":"00:22:51","end":"00:22:54","text":"他才有心力和真正的能量"}],"sameDate":[{"slug":"2026-04-03-call-01","title":"30岁女备考崩溃，咨询师一语点醒：丈夫该做情绪承载，你老公不亲亲抱抱你吗？","date":"2026-04-03","duration":"22分56秒","index":618,"callNumber":1,"rawTranscriptUrl":"/raw/2026-04-03-call-01"},{"slug":"2026-04-03-call-02","title":"985留校工作的女性在父亲去世一年后恐惧生育 咨询师点醒：生命的意义在于寻找意义","date":"2026-04-03","duration":"13分51秒","index":619,"callNumber":2,"raw