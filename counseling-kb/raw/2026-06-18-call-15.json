,{"number":478,"start":"00:21:17","end":"00:21:19","text":"如果真希望自己好"},{"number":479,"start":"00:21:19","end":"00:21:20","text":"甚至有些问题的解决"},{"number":480,"start":"00:21:20","end":"00:21:22","text":"你需要接受的是啊"},{"number":481,"start":"00:21:22","end":"00:21:25","text":"我觉得是相对优质一点的心理咨询"},{"number":482,"start":"00:21:25","end":"00:21:28","text":"偏向当代言人好吧"},{"number":483,"start":"00:21:30","end":"00:21:32","text":"他不是说是荣格名气大"},{"number":484,"start":"00:21:32","end":"00:21:35","text":"荣格就可以帮你解决一切问题"},{"number":485,"start":"00:21:35","end":"00:21:38","text":"在他们那个时代还没有真正的体系化呢"},{"number":486,"start":"00:21:38","end":"00:21:40","text":"好吗"},{"number":487,"start":"00:21:41","end":"00:21:42","text":"嗯好好谢谢"},{"number":488,"start":"00:21:42","end":"00:21:44","text":"好接受一下心理咨"},{"number":489,"start":"00:21:44","end":"00:21:45","text":"谢金哥好不好"},{"number":490,"start":"00:21:45","end":"00:21:46","text":"接触一下心理咨"},{"number":491,"start":"00:21:46","end":"00:21:48","text":"好好嘞"},{"number":492,"start":"00:21:48","end":"00:21:49","text":"谢谢你"},{"number":493,"start":"00:21:49","end":"00:21:50","text":"好拜拜"},{"number":494,"start":"00:21:52","end":"00:21:53","text":"晚安"},{"number":495,"start":"00:21:54","end":"00:21:55","text":"好拜拜"}],"sameDate":[{"slug":"2026-06-18-call-01","title":"小学女生被男同学挤眉弄眼嘲笑求助，咨询师教课后三句话还击","date":"2026-06-18","duration":"14分24秒","index":191,"callNumber":1,"rawTranscriptUrl":"/raw/2026-06-18-call-01"},{"slug":"2026-06-18-call-02","title":"27岁博士生怕导师如临大敌，咨询师：根源是父位缺失叠加母性焦虑","date":"2026-06-18","duration":"15分11秒","index":192,"callNumber":2,"rawTranscriptUrl":"/raw/2026-06-18-call-02"},{"slug":"2026-06-18-call-03","title":"31岁保研男暂不生育怕耽误35岁女友，咨询师喊话姑娘别赌","date":"2026-06-18","duration":"16分4秒","index":193,"callNumber":3,"rawTranscriptUrl":"/raw/2026-06-18-call-03"},{"slug":"2026-06-18-call-04","title":"研究生女孩控诉家族吸血,咨询师当面撕穿她三次表演","date":"2026-06-18","duration":"11分46秒","index":194,"callNumber":4,"rawTranscriptUrl":"/raw/2026-06-18-call-04"},{"slug":"2026-06-18-call-05","title"