er":618,"start":"00:24:28","end":"00:24:30","text":"把基础打得再牢一点"},{"number":619,"start":"00:24:30","end":"00:24:32","text":"嗯好的好的的"},{"number":620,"start":"00:24:32","end":"00:24:32","text":"哎"},{"number":621,"start":"00:24:32","end":"00:24:33","text":"为什么你们搞中医的"},{"number":622,"start":"00:24:33","end":"00:24:36","text":"有很多人人到中年无所成就"},{"number":623,"start":"00:24:36","end":"00:24:38","text":"甚至的话沦为庸医"},{"number":624,"start":"00:24:38","end":"00:24:41","text":"里边有多少人是基础没打好"},{"number":625,"start":"00:24:41","end":"00:24:42","text":"而中医的基础弱"},{"number":626,"start":"00:24:42","end":"00:24:43","text":"想打好"},{"number":627,"start":"00:24:43","end":"00:24:46","text":"不能够光把这个劲放在中医本身的"},{"number":628,"start":"00:24:47","end":"00:24:49","text":"好的好的好的"},{"number":629,"start":"00:24:49","end":"00:24:49","text":"谢谢斌哥"},{"number":630,"start":"00:24:49","end":"00:24:50","text":"诶"},{"number":631,"start":"00:24:50","end":"00:24:51","text":"好嘞好好嘞"},{"number":632,"start":"00:24:51","end":"00:24:51","text":"好斌哥"},{"number":633,"start":"00:24:51","end":"00:24:52","text":"再见"},{"number":634,"start":"00:24:52","end":"00:24:52","text":"好拜拜"},{"number":635,"start":"00:24:52","end":"00:24:54","text":"谢谢嗯拜拜"}],"sameDate":[{"slug":"2026-04-01-call-01","title":"26岁中医硕士不想进公立医院被父母反对 咨询师点醒她别试图改变父母","date":"2026-04-01","duration":"26分11秒","index":636,"callNumber":1,"rawTranscriptUrl":"/raw/2026-04-01-call-01"},{"slug":"2026-04-01-call-02","title":"92年美国女博士被亲妈讨钱逼到抑郁 和外国丈夫像室友关系 读博卡在论文答辩这步","date":"2026-04-01","duration":"38分8秒","index":637,"callNumber":2,"rawTranscriptUrl":"/raw/2026-04-01-call-02"},{"slug":"2026-04-01-call-03","title":"26岁医学生相恋6年男友有连体包裹癖好；自己写作追求认同却遭流量绑架，咨询师点破表达真谛","date":"2026-04-01","duration":"30分53秒","index":638,"callNumber":3,"rawTranscriptUrl":"/raw/2026-04-01-call-03"},{"slug":"2026-04-01-call-04","title":"34岁货车司机连麦咨询师哭诉债务滚到20万，甩锅给原生家庭对他太呵护，冰哥点评：有因有果要认账","date":"2026-04-01","duration":"16分16秒","index":639,"callNumber":4,"rawTranscriptUrl":"/raw/2026-04-01-call-04"},{"slug":"2