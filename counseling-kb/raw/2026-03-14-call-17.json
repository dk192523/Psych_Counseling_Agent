06","end":"00:12:08","text":"目的是啥呀"},{"number":279,"start":"00:12:10","end":"00:12:13","text":"因为我我现在就是比较焦虑"},{"number":280,"start":"00:12:13","end":"00:12:17","text":"告诉我说这些情况的目的是啥"},{"number":281,"start":"00:12:17","end":"00:12:20","text":"我来判断一下是不是无聊嗯"},{"number":282,"start":"00:12:20","end":"00:12:28","text":"就是我现在嗯现在虽然处于这个状况"},{"number":283,"start":"00:12:28","end":"00:12:33","text":"但是我在心里的话是不想走这一步的"},{"number":284,"start":"00:12:38","end":"00:12:41","text":"因为我不想让我孩子"},{"number":285,"start":"00:12:42","end":"00:12:47","text":"就是生活在这种单亲的家庭"},{"number":286,"start":"00:12:47","end":"00:12:51","text":"因为对他的话多多少少都有可能都会有影响"},{"number":287,"start":"00:12:51","end":"00:12:53","text":"嗯只能说明你糊涂"},{"number":288,"start":"00:12:55","end":"00:12:58","text":"你希望孩子长期身旁陪伴成长"},{"number":289,"start":"00:12:58","end":"00:13:03","text":"的是一个屡教不改的烂赌鬼哇"},{"number":290,"start":"00:13:04","end":"00:13:07","text":"只要他以父亲的名义存在就行啊"},{"number":291,"start":"00:13:07","end":"00:13:10","text":"日常孩子也可以有个密切的接触"},{"number":292,"start":"00:13:10","end":"00:13:12","text":"你指望这个烂赌鬼配合你一块"},{"number":293,"start":"00:13:12","end":"00:13:16","text":"来完成对他的孩子的家庭养育及教育"},{"number":294,"start":"00:13:16","end":"00:13:19","text":"您认为这样子的话也比你清清白白"},{"number":295,"start":"00:13:19","end":"00:13:20","text":"干干净净"},{"number":296,"start":"00:13:20","end":"00:13:21","text":"你又不赌不抢不偷"},{"number":297,"start":"00:13:21","end":"00:13:24","text":"然后来养活这个孩子要好"},{"number":298,"start":"00:13:25","end":"00:13:27","text":"你不上班多久"},{"number":299,"start":"00:13:27","end":"00:13:27","text":"来来来"},{"number":300,"start":"00:13:27","end":"00:13:29","text":"你不上班多久了"},{"number":301,"start":"00:13:29","end":"00:13:31","text":"我上班上什么班"},{"number":302,"start":"00:13:31","end":"00:13:32","text":"咱班爱告诉人们"},{"number":303,"start":"00:13:32","end":"00:13:33","text":"你上什么班"},{"number":304,"start":"00:13:33","end":"00:13:37","text":"我现在在一个国企上班"},{"number":305,"start":"00:13:37","end":"00:13:39","text":"救不了你了啊"},{"number":306,"start":"00:13:39","end":"00:13:41","text":"您上班的人有社会接触的人"},{"number":307,"start":"00:13:41","end":"00:13:43","text":"有这样的一个认知"},{"number":308,"start":"00:13:43","end":"00:13:44","text":"算了"},{"number":309,"start":"00:13:44","end":"00:13:46","text":"看在孩子的份上多说两句"},{"number":310,"start":"00:13:46","end":"00:13:48","text":"我们宁可这个孩子啊"},{"number":311,"start":"00:13:48","end":"00:13:52","text":"没有一个烂赌鬼的爹来介入他的成长"},{"number":312,"start":"00:13:52","end":"00:13:54","text":"哪怕是个单亲妈妈"},{"number":313,"start":"00:13:54","end":"00:13:57","text":"然后只要这个单亲妈妈有合法收入"},{"number":314,"start":"00:13:57","end":"00:14:01","text":"正常劳动接触社会养大的这个孩子"},{"number":315,"start":"00:14:01","end":"00:14:05","text":"也大概率比这个孩子在耳濡目染之下"},{"number":316,"start":"00:14:05","end":"00:14:08","text":"被一个屡教不改"},{"number":317,"start":"00:14:08","end":"00:14:13","text":"是不是里外两层皮的一个烂赌鬼介入"},{"number":318,"start":"00:14:13","end":"00:14:14","text":"他的成长要好很多"},{"number":319,"start":"00:14:14","end":"00:14:17","text":"这是我能给你说的所有的话"},{"number":320,"start":"00:14:18","end":"00:14:20","text":"其实这个问题我也想过"},{"number":321,"start":"00:14:20","end":"00:14:21","text":"哎哎哎那是您的议题"},{"number":322,"start":"00:14:21","end":"00:14:23","text":"我只说我能说的话"},{"number":323,"start":"00:14:23","end":"00:14:25","text":"您如果不想离这个婚"},{"number":324,"start":"00:14:25","end":"00:14:25","text":"那是您的事"},{"number":325,"start":"00:14:25","end":"00:14:27","text":"我只是看在孩子的份儿上"},{"number":326,"start":"00:14:27","end":"00:14:28","text":"我多说这几句"},{"number":327,"start":"00:14:28","end":"00:14:30","text":"OK我不劝你"},{"number":328,"start":"00:14:30","end":"00:14:31","text":"我绝对不劝你"},{"number":329,"start":"00:14:31","end":"00:14:32","text":"你好你坏"},{"number":330,"start":"00:14:32","end":"00:14:34","text":"你的人生不冲着这个孩子"},{"number":331,"start":"00:14:34","end":"00:14:35","text":"刚才这话我就不说啊"},{"number":332,"start":"00:14:35","end":"00:14:36","text":"好嘞"},{"number":333,"start":"00:14:36","end":"00:14:37","text":"干杯"},{"number":334,"start":"00:14:39","end":"00:14:41","text":"嗯好拜拜"},{"number":335,"start":"00:14:44","end":"00:14:47","text":"我不能让我的孩子没有爹嗯"},{"number":336,"start":"00:14:47","end":"00:14:49","text":"好孩子倒是有爹了"},{"number":337,"start":"00:14:49","end":"00:14:51","text":"有了一个烂赌鬼的爹"}],"sameDate":[{"slug":"2026-03-14-call-01","title":"36岁单身女问人生意义，咨询师说当下即最好","date":"2026-03-14","duration":"30分22秒","index":735,"callNumber":1,"rawTranscriptUrl":"/raw/2026-03-14-call-01"},{"slug":"2026-03-14-call-02","title":"内耗音乐老师想通过助人修心，冰哥建议意识层面加强","date":"2026-03-14","duration":"8分26秒","index":736,"callNumber":2,"rawTranscriptUrl":"/raw/2026-03-14-call-02"},{"slug":"2026-03-14-call-05","title":"21岁毕业生照顾病父无法工作，咨询师追问医保低保","date":"2026-03-14","duration":"9分12秒","index":737,"callNumber":5,"rawTranscriptUrl":""},{"slug":"2026-03-14-call-07","title":"咨询师闲聊13分钟解释夏天停播缘由原来和ai有关","date":"2026-03-14","duration":"13分18秒","index":738,"callNumber":7,"rawTranscriptUrl":"/raw/2026-03-14-call-07"},{"slug":"2026-03-14-call-10","title":"28岁失业+双相崩溃，咨询师：先走对的路，比安慰重要","date":"2026-03-14","duration":"15分1秒","index":739,"callNumber":10,"rawTranscriptUrl":"/raw/2026-03-14-call-10"},{"slug":"2026-03-14-call-11","title":"爱读书观众连麦求书单遭婉拒，追问轮回因果被咨询师直接破象：没有下一世，把这辈子活好就行","date":"2026-03-14","duration":"7分51秒","index":740,"callNumber":11,"rawTranscriptUrl":"/raw/2026-03-14-call-11"},{"slug":"2026-03-14-call-17","title":"25岁医学女研究生，学业未完便焦虑省考失利和异地婚嫁两头烧，咨询师直判：你还是个孩子","date":"2026-03-14","duration":"21分29秒","index":741,"callNumber":17,"rawTranscriptUrl":"/raw/2026-03-14-call-17"},{"slug":"2026-03-14-call-19","title":"28岁投标从业者拿三万赔偿离职，搬出六条变现路径信心满满要创业，咨询师直言商业模式跑不通","date":"2026-03-14","duration":"9分18秒","index":742,"callNumber":19,"rawTranscriptUrl":"/raw/2026-03-14-call-19"},{"slug":"2026-03-14-call-20","title":"沪漂40岁父亲与妻分居8月几乎见不到双胞胎女儿，咨询师直言无破局点，劝他走法律途径争探视权","date":"2026-03-14","duration":"9分57秒","index":743,"callNumber":20,"rawTranscriptUrl":"/raw/2026-03-14-call-20"},{"slug":"2026-03-14-call-21","title":"55岁上海女性因三弟啃老与丈夫起摩擦，反复追问咨询师\"我没有错吧\"，咨询师三次拒绝站队","date":"2026-03-14","duration":"11分22秒","inde