01:03","end":"00:01:06","text":"然后今年就毕业了"},{"number":27,"start":"00:01:06","end":"00:01:09","text":"稍稍等我稍微缓一缓"},{"number":28,"start":"00:01:10","end":"00:01:14","text":"研究生是公共事务管理呃"},{"number":29,"start":"00:01:14","end":"00:01:17","text":"公共管理名字就叫公共管理"},{"number":30,"start":"00:01:17","end":"00:01:19","text":"因为我想着我是体制内嘛"},{"number":31,"start":"00:01:19","end":"00:01:22","text":"然后就考考的公共管理"},{"number":32,"start":"00:01:22","end":"00:01:25","text":"然后我想问的问题就是"},{"number":33,"start":"00:01:25","end":"00:01:29","text":"我我我这段时间就很想要辞职"},{"number":34,"start":"00:01:29","end":"00:01:32","text":"是因为我觉得就是比较焦虑"},{"number":35,"start":"00:01:32","end":"00:01:34","text":"然后就疲于奔命的"},{"number":36,"start":"00:01:34","end":"00:01:36","text":"就是只有去考证呀"},{"number":37,"start":"00:01:36","end":"00:01:41","text":"或者是学一些东西才可以缓解我的这种焦虑呃"},{"number":38,"start":"00:01:41","end":"00:01:45","text":"原因就是第一点就是我觉得因为我是异地"},{"number":39,"start":"00:01:45","end":"00:01:49","text":"所以感觉这边的文化就融不太进去"},{"number":40,"start":"00:01:49","end":"00:01:52","text":"而且也听不懂他们说话"},{"number":41,"start":"00:01:52","end":"00:01:56","text":"然后第二点就是我觉得你考到了"},{"number":42,"start":"00:01:56","end":"00:02:00","text":"就是就是到了桂平地区额"},{"number":43,"start":"00:02:00","end":"00:02:03","text":"到了和广东比较接近的那边"},{"number":44,"start":"00:02:03","end":"00:02:05","text":"他们说的是白话"},{"number":45,"start":"00:02:05","end":"00:02:07","text":"然后我听过那就是桂平地区了"},{"number":46,"start":"00:02:07","end":"00:02:08","text":"说土白话的"},{"number":47,"start":"00:02:08","end":"00:02:10","text":"嗯嗯嗯啊"},{"number":48,"start":"00:02:10","end":"00:02:11","text":"那确实有点难懂"},{"number":49,"start":"00:02:11","end":"00:02:11","text":"好"},{"number":50,"start":"00:02:11","end":"00:02:12","text":"你接着说"},{"number":51,"start":"00:02:12","end":"00:02:16","text":"然后第二点就是我觉得现在工作的地方"},{"number":52,"start":"00:02:16","end":"00:02:17","text":"我来了以后"},{"number":53,"start":"00:02:17","end":"00:02:18","text":"然后各种熟悉"},{"number":54,"start":"00:02:18","end":"00:02:21","text":"我觉得我不想在