09:28","text":"一开始上去不知话题从哪开始"},{"number":199,"start":"00:09:31","end":"00:09:34","text":"今天主要想找我聊的是啥呀"},{"number":200,"start":"00:09:34","end":"00:09:36","text":"除了以前的事之外"},{"number":201,"start":"00:09:44","end":"00:09:49","text":"以前我也也想打算跟你聊这些呃"},{"number":202,"start":"00:09:49","end":"00:09:50","text":"其他也没什么"},{"number":203,"start":"00:09:50","end":"00:09:52","text":"就是讲我就想聊聊"},{"number":204,"start":"00:09:52","end":"00:09:57","text":"就是我的个人的爱好嗯"},{"number":205,"start":"00:09:57","end":"00:09:59","text":"现在在写什么呀"},{"number":206,"start":"00:10:01","end":"00:10:04","text":"你现在是楷书"},{"number":207,"start":"00:10:05","end":"00:10:07","text":"我有没有荣幸给你提个建议啊"},{"number":208,"start":"00:10:08","end":"00:10:11","text":"嗯写小篆曲"},{"number":209,"start":"00:10:11","end":"00:10:13","text":"但是放弃中锋用笔"},{"number":210,"start":"00:10:13","end":"00:10:16","text":"想怎么写怎么写啊"},{"number":211,"start":"00:10:16","end":"00:10:20","text":"我刚嗯那个好像那个书到了吧"},{"number":212,"start":"00:10:20","end":"00:10:23","text":"好像今天我正好嗯那个我休息一天"},{"number":213,"start":"00:10:23","end":"00:10:25","text":"可能到我们那单位了"},{"number":214,"start":"00:10:25","end":"00:10:26","text":"呃"},{"number":215,"start":"00:10:26","end":"00:10:31","text":"我就买了一本的那个篆体的字帖"},{"number":216,"start":"00:10:31","end":"00:10:33","text":"我再重复一下"},{"number":217,"start":"00:10:33","end":"00:10:34","text":"写篆书去"},{"number":218,"start":"00:10:34","end":"00:10:37","text":"但是咱们不去玩中锋用笔"},{"number":219,"start":"00:10:42","end":"00:10:43","text":"就是"},{"number":220,"start":"00:10:44","end":"00:10:48","text":"篆书里边你最喜欢的是啥呀"},{"number":221,"start":"00:10:48","end":"00:10:52","text":"小篆我喜欢中山传"},{"number":222,"start":"00:10:55","end":"00:10:58","text":"我对篆体了解也不多"},{"number":223,"start":"00:10:58","end":"00:10:59","text":"我也不多"},{"number":224,"start":"00:10:59","end":"00:11:01","text":"正好是我就觉得特别好看"},{"number":225,"start":"00:11:04","end":"00:11:09","text":"我只是了简单了解那个小篆子也也挺好看的"},{"number":226,"start":"00:11:09","end":"00:11:12","text":"嗯可以去练一下"},{"number":2