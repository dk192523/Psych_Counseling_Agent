08:11","text":"就说是百事孝为先"},{"number":196,"start":"00:08:11","end":"00:08:13","text":"那你就笑不都这样不讲"},{"number":197,"start":"00:08:13","end":"00:08:16","text":"只不过笑的方式有点差异化就好"},{"number":198,"start":"00:08:16","end":"00:08:18","text":"既然你的大姐和你的弟弟"},{"number":199,"start":"00:08:18","end":"00:08:22","text":"从小得到了你的生身父母亲那么多的关爱"},{"number":200,"start":"00:08:22","end":"00:08:24","text":"那么亲密人际互动的这个动作"},{"number":201,"start":"00:08:24","end":"00:08:29","text":"他们完成你的话人少去钱多去不就好了吗"},{"number":202,"start":"00:08:29","end":"00:08:31","text":"嗯我是我是钱一直给"},{"number":203,"start":"00:08:31","end":"00:08:34","text":"然后然后我每每一周会去两次"},{"number":204,"start":"00:08:34","end":"00:08:35","text":"钱多去两次"},{"number":205,"start":"00:08:35","end":"00:08:36","text":"人少去就好了啊"},{"number":206,"start":"00:08:36","end":"00:08:40","text":"让对让接受过更多爱的孩子啊"},{"number":207,"start":"00:08:40","end":"00:08:42","text":"让你的姐姐和弟弟多去啊"},{"number":208,"start":"00:08:42","end":"00:08:46","text":"你的话少去你人少去钱多去啊就可以了啊"},{"number":209,"start":"00:08:46","end":"00:08:48","text":"但是我就是看见他们这么老了"},{"number":210,"start":"00:08:48","end":"00:08:49","text":"又需要照顾了"},{"number":211,"start":"00:08:49","end":"00:08:51","text":"我自己心里觉得也很难受"},{"number":212,"start":"00:08:51","end":"00:08:52","text":"但是你让我去照顾他们"},{"number":213,"start":"00:08:52","end":"00:08:53","text":"我又做不到"},{"number":214,"start":"00:08:53","end":"00:08:56","text":"那你需要做的就是这两种难受"},{"number":215,"start":"00:08:56","end":"00:08:58","text":"哪一个来的更难克服"},{"number":216,"start":"00:08:58","end":"00:08:59","text":"那就好了"},{"number":217,"start":"00:09:00","end":"00:09:02","text":"我是经常会去给他们送各种东西"},{"number":218,"start":"00:09:02","end":"00:09:03","text":"就说是他们的"},{"number":219,"start":"00:09:03","end":"00:09:07","text":"现在他们的生活几乎有我的两种难受"},{"number":220,"start":"00:09:07","end":"00:09:09","text":"哪一种难受你更难克服"},{"number":221,"start":"00:09:10","end":"00:09:16","text":"嗯我看到就是就就是是的是的"},{"number":222,"start":"00:09:16","end":"00:09:17","text":"就是家里头"},{"number":223,"start":"00:09:17","end":"00:09:19","text":"因为我看评公屏上说我不想养老"},{"number":224,"start":"00:09:19","end":"00:09:20","text":"其实真的不是这样子的"},{"number":225,"start":"00:09:20","end":"00:09:24","text":"就是这两种难受哪一种更难克服"},{"number":226,"start":"00:09:24","end":"00:09:27","text":"我觉得是我跟他们相处更难克服"},{"number":227,"start":"00:09:27","end":"00:09:32","text":"那你就不去克服这个就好了"},{"number":228,"start":"00:09:32","end":"00:09:35","text":"但是好像心理上还是有一种负罪感"},{"number":229,"start":"00:09:35","end":"00:09:37","text":"而且就是同时我的姐姐和弟弟"},{"number":230,"start":"00:09:37","end":"00:09:38","text":"他们也会说"},{"number":231,"start":"00:09:38","end":"00:09:40","text":"你为什么不放下过去呢"},{"number":232,"start":"00:09:40","end":"00:09:43","text":"你就是意思是我还应该去照照顾他们"},{"number":233,"start":"00:09:43","end":"00:09:46","text":"我但是我就说你们体会不到我"},{"number":234,"start":"00:09:46","end":"00:09:49","text":"我心里的这种这种这种难受的样子"},{"number":235,"start":"00:09:49","end":"00:09:51","text":"而且我现在还是在病中"},{"number":236,"start":"00:09:51","end":"00:09:53","text":"我还一直在持续吃药"},{"number":237,"start":"00:09:53","end":"00:09:55","text":"不是过来要求梳理问题"},{"number":238,"start":"00:09:55","end":"00:09:59","text":"是想找个地方加引号的诉苦啊"},{"number":239,"start":"00:09:59","end":"00:10:01","text":"其实也不是真的真的是在梳理问题"},{"number":240,"start":"00:10:01","end":"00:10:02","text":"就是这个梳理问题"},{"number":241,"start":"00:10:02","end":"00:10:04","text":"麻烦您来回答一下"},{"number":242,"start":"00:10:04","end":"00:10:06","text":"刚才我给您梳理的是啥"},{"number":243,"start":"00:10:06","end":"00:10:07","text":"对您已经给我梳理了"},{"number":244,"start":"00:10:07","end":"00:10:10","text":"就看哪个痛苦更难克服"},{"number":245,"start":"00:10:10","end":"00:10:13","text":"那就不需要多赘述了呀"},{"number":246,"start":"00:10:13","end":"00:10:14","text":"嗯好的"},{"number":247,"start":"00:10:14","end":"00:10:17","text":"这个问题嗯这个问题可以"},{"number":248,"start":"00:10:17","end":"00:10:20","text":"还有个问题我想跟您探讨一下哈"},{"number":249,"start":"00:10:20","end":"00:10:22","text":"就说是嗯我想问问您"},{"number":250,"start":"00:10:22","end":"00:10:24","text":"就说是因为我有这个病"},{"number":251,"start":"00:10:24","end":"00:10:28","text":"我现在就是嗯不知道哪一天他还会复发"},{"number":252,"start":"00:10:28","end":"00:10:30","text":"嗯我现在想"},{"number":253,"start":"00:10:30","end":"00:10:33","text":"因为我的女儿现在只只有22岁"},{"number":254,"start":"00:10:33","end":"00:10:37","text":"我现在就想嗯如果我不在的话"},{"number":255,"start":"00:10:37","end":"00:10:40","text":"是我给他拍下一段视频"},{"number":256,"start":"00:10:40","end":"00:10:42","text":"一比如说在他的重大的"},{"number":257,"start":"00:10:42","end":"00:10:44","text":"比如说是结婚生子"},{"number":258,"start":"00:10:44","end":"00:10:46","text":"或者他一些重大的生日"},{"number":259,"start":"00:10:46","end":"00:10:48","text":"然后我请求一个人帮我"},{"number":260,"start":"00:10:48","end":"00:10:51","text":"就在这个重要的节点把这个视频给他"},{"number":261,"start":"00:10:51","end":"00:10:54","text":"还是说我就不留任何东西"},{"number":262,"start":"00:10:54","end":"00:10:56","text":"让他把我忘掉"},{"number":263,"start":"00:10:56","end":"00:10:58","text":"因为她我们母女感情非常好"},{"number":264,"start":"00:10:58","end":"00:11:01","text":"我又害怕她每看一次这种视频"},{"number":265,"start":"00:11:01","end":"00:11:02","text":"她会更加的难受"},{"number":266,"start":"00:11:02","end":"00:11:04","text":"我不知道这是哪种说法"},{"number":267,"start":"00:11:04","end":"00:11:05","text":"是什么病哦"},{"number":268,"start":"00:11:05","end":"00:11:08","text":"我是那个恶性肿瘤癌症"},{"number":269,"start":"00:11:08","end":"00:11:10","text":"现在的话是三期晚期吧"},{"number":270,"start":"00:11:10","end":"00:11:11","text":"还是啥"},{"number":271,"start":"00:11:11","end":"00:11:14","text":"不是是二期哦"},{"number":272,"start":"00:11:14","end":"00:11:15","text":"是具体什么肿瘤啊"},{"number":273,"start":"00:11:15","end":"00:11:17","text":"病名方面讲呃"},{"number":274,"start":"00:11:17","end":"00:11:20","text":"是那个结肠结肠癌呃"},{"number":275,"start":"00:11:20","end":"00:11:22","text":"我觉得您不要想太多"},{"number":276,"start":"00:11:22","end":"00:11:24","text":"因为AI和医疗的结合"},{"number":277,"start":"00:11:24","end":"00:11:27","text":"超乎我们想象的速度之快的"},{"number":278,"start":"00:11:27","end":"00:11:28","text":"不停的有些惊喜"},{"number":279,"start":"00:11:28","end":