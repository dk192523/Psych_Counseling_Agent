,{"number":26,"start":"00:00:48","end":"00:00:53","text":"然后呃我爷爷奶奶的家庭氛围也是希腊"},{"number":27,"start":"00:00:53","end":"00:00:55","text":"然后我母亲是这样子"},{"number":28,"start":"00:00:55","end":"00:00:58","text":"就是我外公外婆走的比较早"},{"number":29,"start":"00:00:58","end":"00:01:00","text":"但是呢我爸的态度反而是嚣张"},{"number":30,"start":"00:01:00","end":"00:01:01","text":"幸灾乐祸"},{"number":31,"start":"00:01:01","end":"00:01:03","text":"意思就是你也有"},{"number":32,"start":"00:01:03","end":"00:01:04","text":"今天我看这下"},{"number":33,"start":"00:01:04","end":"00:01:05","text":"我看谁给你撑腰"},{"number":34,"start":"00:01:05","end":"00:01:07","text":"然后呢结婚30多年"},{"number":35,"start":"00:01:07","end":"00:01:11","text":"经历的是无数次的家暴和长期的孤独无助"},{"number":36,"start":"00:01:12","end":"00:01:15","text":"一定程度上只为了我们兄弟俩而活"},{"number":37,"start":"00:01:15","end":"00:01:15","text":"除此之外"},{"number":38,"start":"00:01:15","end":"00:01:17","text":"他的生活看不到光"},{"number":39,"start":"00:01:17","end":"00:01:19","text":"现在整个人已经看起来是一个很命苦的样子"},{"number":40,"start":"00:01:19","end":"00:01:21","text":"气色也不好"},{"number":41,"start":"00:01:21","end":"00:01:23","text":"然后家庭的话"},{"number":42,"start":"00:01:23","end":"00:01:26","text":"就是常年的生活模式是我爸早出晚归"},{"number":43,"start":"00:01:26","end":"00:01:27","text":"只负责赚钱"},{"number":44,"start":"00:01:27","end":"00:01:31","text":"然后我的生活和成长主要和我妈一起家"},{"number":45,"start":"00:01:31","end":"00:01:32","text":"对我来说不是港湾"},{"number":46,"start":"00:01:32","end":"00:01:34","text":"家人对我来说在精神上不是后盾"},{"number":47,"start":"00:01:34","end":"00:01:36","text":"家里压抑冷清"},{"number":48,"start":"00:01:36","end":"00:01:37","text":"很少有欢声笑语"},{"number":49,"start":"00:01:37","end":"00:01:38","text":"其乐融融"},{"number":50,"start":"00:01:38","end":"00:01:40","text":"父母当着孩子面吵架"},{"number":51,"start":"00:01:40","end":"00:01:40","text":"一吵架"},{"number":52,"start":"00:01:40","end":"00:01:42","text":"我心里就发紧"},{"number":53,"start":"00:01:43","end":"00:01:44","text":"然后这是家里的情况"},{"number":54,"start":"00:01:45","end":"00:01:48","text":"然后说一下我的成长经历"},{"number":55,"start":"00:01:48","end":"00:01:50","text":"就是在我的感受中"},{"number":56,"start":"00:01:50","end":"00:01:53","text":"几乎没人把我真正的爱人给予尊重"},{"number":57,"start":"00:01:53","end":"00:01:56","text":"小时候父母和其他长辈经常调侃我丑"},{"number":58,"start":"00:01:56","end":"00:01:57","text":"践踏践踏我的自尊"},{"number":59,"start":"00:01:57","end":"00:01:59","text":"忽视我的感受"},{"number":60,"start":"00:01:59","end":"00:02:01","text":"嗯然后小时候不是有龅牙吗"},{"number":61,"start":"00:02:01","end":"00:02:05","text":"嗯那些个父母长辈还喜欢拿我龅牙开玩笑等等"},{"number":62,"start":"00:02:05","end":"00:02:06","text":"诸如此类的事"},{"number":63,"start":"00:02:07","end":"00:02:10","text":"然后呢小时候还比较活泼"},{"number":64,"start":"00:02:10","end":"00:02:11","text":"乐于分享表达"},{"number":65,"start":"00:02:11","end":"00:02:13","text":"但是始终无人回应"},{"number":66,"start":"00:02:13","end":"00:02:17","text":"因为种种原因对父母逐渐封闭内心"},{"number":67,"start":"00:02:17","end":"00:02:18","text":"初中的时候"},{"number":68,"start":"00:02:18","end":"00:02:19","text":"因为不愿意和周围那些人一伙"},{"number":69,"start":"00:02:19","end":"00:02:22","text":"就开始对周围人也封闭内心"},{"number":70,"start":"00:02:22","end":"00:02:24","text":"中学的时候多次喜欢过人"},{"number":71,"start":"00:02:24","end":"00:02:27","text":"但是对方都不喜欢我"},{"number":72,"start":"00:02:27","end":"00:02:31","text":"23年的时候追求过一个女生失败"},{"number":73,"start":"00:02:31","end":"00:02:33","text":"交往过程中出现了明显的没有自我"},{"number":74,"start":"00:02:33","end":"00:02:34","text":"缺乏自信"},{"number":75,"start":"00:02:34","end":"00:02:35","text":"讨好态度不自然"},{"number":76,"start":"00:02:35","end":"00:02:36","text":"相比之下"},{"number":77,"start":"00:02:36","end":"00:02:37","text":"对方活泼开朗"},{"number":78,"start":"00:02:37","end":"00:02:38","text":"有个性"},{"number":79,"start":"00:02:38","end":"00:02:39","text":"有自信"},{"number":80,"start":"00:02:39","end":"00:02:42","text":"然后当时我自我分析归因得出来一个推测是"},{"number":81,"start":"00:02:42","end":"00:02:44","text":"原生家庭差距应该是挺大的"},{"number":82,"start":"00:02:44","end":"00:02:46","text":"对方的原生家庭很幸福"},{"number":83,"start":"00:02:46","end":"00:02:49","text":"能够承接和包容他的一切个性和笑容"},{"number":84,"start":"00:02:49","end":"00:02:50","text":"更不存在家暴"},{"number":85,"start":"00:02:50","end":"00:02:52","text":"这是我当时的呃思考"},{"number":86,"start":"00:02:53","end":"00:02:58","text":"然后现在的情况就是性格方面讨好性人格"},{"number":87,"start":"00:02:58","end":"00:03:00","text":"在人际交往中压抑自我"},{"number":88,"start":"00:03:00","end":"00:03:00","text":"顺从激进"},{"number":89,"start":"00:03:00","end":"00:03:02","text":"不知道该呈现出什么样子"},{"number":90,"start":"00:03:02","end":"00:03:04","text":"不知道自己该是什么性格"},{"number":91,"start":"00:03:04","end":"00:03:05","text":"魅力不足"},{"number":92,"start":"00:03:05","end":"00:03:08","text":"同样对自己的外外在感到自卑别扭"},{"number":93,"start":"00:03:08","end":"00:03:09","text":"表情僵硬冷酷"},{"number":94,"start":"00:03:09","end":"00:03:11","text":"笑起来不自然"},{"number":95,"start":"00:03:11","end":"00:03:13","text":"情绪能量很低"},{"number":96,"start":"00:03:13","end":"00:03:16","text":"出门社交维持高情绪能量之后"},{"number":97,"start":"00:03:16","end":"00:03:17","text":"会感觉疲惫和空虚"},{"number":98,"start":"00:03:17","end":"00:03:19","text":"有点不想和人相处"},{"number":99,"start":"00:03:19","end":"00:03:19","text":"因为感觉很累"},{"number":100,"start":"00:03:21","end":"00:03:25","text":"然后情感方面没有爱和被爱的感觉"},{"number":101,"start":"00:03:25","end":"00:03:26","text":"感觉心里很空"},{"number":102,"start":"00:03:26","end":"00:03:28","text":"觉得我不够好"},{"number":103,"start":"00:03:28","end":"00:03:30","text":"我不配活在愧疚里"},{"number":104,"start":"00:03:30","end":"00:03:32","text":"觉得自己的存在是负的"},{"number":105,"start":"00:03:32","end":"00:03:33","text":"我不知道自己是不是缺爱"},{"number":106,"start":"00:03:33","end":"00:03:36","text":"我妈和我哥肯定是给了很多爱的"},{"number":107,"start":"00:03:36","end":"00:03:38","text":"但是我究竟有没有被爱的感觉"},{"number":108,"start":"00:03:38","end":"00:03:40","text":"这些爱究竟是否在精神上给到了我"},{"number":109,"start":"00:03:40","end":"00:03:41","text":"滋养了我"},{"number":110,"start":"00:03:41","end":"00:03:42","text":"我不知道"},{"number":111,"start":"00:03:42","end":"00:03:44","text":"而且感觉自己和家人情感不深"},{"number":112,"start":"00:03:44","end":"00:03:47","text":"还因此怀疑自己是不是冷酷无情"},{"number":113,"start":"00:03:47","end":"00:03:50","text":"我哥是唯一和我关系比较近的"},{"number":114,"start":"00:03:50","end":"00:03:52","text":"但是有一个情况就是现在我爸妈骂我"},{"number":115,"start":"00:03:52","end":"00:03:54","text":"我没多大感觉"},{"number":116,"start":"00:03:54","end":"00:03:57","text":"但是我哥即便是只批评我几句"},{"number":117,"start":"00:03:57","end":"00:03:59","text":"也会让我的情绪一下子低落很多"},{"number":118,"start":"00:03:59","end":"00:04:02","text":"这也在很大程度上导致了"},{"number":119,"start":"00:04:02","end":"00:04:03","text":"即便是我哥"},{"number":120,"start":"00:04:03","end":"00:04:07","text":"我也没办法敞开胸怀拥抱和他的亲密关系"},{"number":121,"start":"00:04:08","end":"00:04:10","text":"然后人际关系方面的话"},{"number":122,"start":"00:04:10","end":"00:04:12","text":"就是长期吃饭习惯独处一点"},{"number":123,"start":"00:04:12","end":"00:04:13","text":"活成了孤岛"},{"number":124,"start":"00:04:13","end":"00:04:15","text":"但是又害怕孤独"},{"number":125,"start":"00:04:15","end":"00:04:16","text":"对于深度关系"},{"number":126,"start":"00:04:16","end":"00:04:18","text":"不知道是真的不需要还是需求被压抑"},{"number":127,"start":"00:04:18","end":"00:04:21","text":"至少目前依然习惯生活中没有深度关系"},{"number":128,"start":"00:04:21","end":"00:04:23","text":"日子也过得下去"},{"number":129,"start":"00:04:23","end":"00:04:26","text":"只对能度是能够深度交心的关系"},{"number":130,"start":"00:04:26","end":"00:04:27","text":"有兴趣"},{"number":131,"start":"00:04:27","end":"00:04:28","text":"不太会聊天相处"},{"number":132,"start":"00:04:28","end":"00:04:31","text":"对别人说的话不知道如何回应"},{"number":133,"start":"00:04:31","end":"00:04:32","text":"作何反应"},{"number":134,"start":"00:04:32","end":"00:04:33","text":"渴望爱情"},{"number":135,"start":"00:04:33","end":"00:04:34","text":"但是谈不到恋爱"},{"number":136,"start":"00:04:34","end":"00:04:36","text":"也不知道自己能否正常经营爱情"},{"number":137,"start":"00:04:36","end":"00:04:40","text":"也怀疑自己是不是会在真的谈到恋爱之后"},{"number":138,"start":"00:04:40","end":"00:04:43","text":"发现自己对爱情乃至亲密关系其实没什么兴趣"},{"number":139,"start":"00:04:43","end":"00:04:47","text":