1:39","end":"00:11:42","text":"他没有办法接纳自己"},{"number":281,"start":"00:11:42","end":"00:11:45","text":"也不接纳真实的社会秩序和规则"},{"number":282,"start":"00:11:45","end":"00:11:46","text":"游戏规则"},{"number":283,"start":"00:11:46","end":"00:11:49","text":"他会变得愤世嫉俗"},{"number":284,"start":"00:11:49","end":"00:11:50","text":"他会去抨击他的同行"},{"number":285,"start":"00:11:50","end":"00:11:51","text":"瞧不上那个"},{"number":286,"start":"00:11:51","end":"00:11:55","text":"看不起那个仰仗着他所知道的一点点专业知识"},{"number":287,"start":"00:11:55","end":"00:11:58","text":"或者一点点小小的才情及才华去批判他人"},{"number":288,"start":"00:11:58","end":"00:12:01","text":"可是他却恰恰又在违背着"},{"number":289,"start":"00:12:01","end":"00:12:03","text":"另外一个社会游戏规则"},{"number":290,"start":"00:12:03","end":"00:12:05","text":"叫做强者"},{"number":291,"start":"00:12:05","end":"00:12:07","text":"永远不会去批判弱者的呀"},{"number":292,"start":"00:12:07","end":"00:12:08","text":"你去批判他人"},{"number":293,"start":"00:12:08","end":"00:12:11","text":"只能够证明你是事实的弱者"},{"number":294,"start":"00:12:11","end":"00:12:12","text":"到最后的话"},{"number":295,"start":"00:12:12","end":"00:12:13","text":"他的愤愤不平"},{"number":296,"start":"00:12:13","end":"00:12:15","text":"怀才不遇"},{"number":297,"start":"00:12:15","end":"00:12:18","text":"反而恰恰只佐证了他的平庸而已"},{"number":298,"start":"00:12:18","end":"00:12:20","text":"所以不如这道题"},{"number":299,"start":"00:12:20","end":"00:12:22","text":"趁着年轻时代就早一点把它给解决了"},{"number":300,"start":"00:12:22","end":"00:12:24","text":"怎么早一点解决了呀"},{"number":301,"start":"00:12:24","end":"00:12:27","text":"这顿饭咱们吃得上鱼翅捞饭"},{"number":302,"start":"00:12:27","end":"00:12:28","text":"我们好好吃"},{"number":303,"start":"00:12:28","end":"00:12:31","text":"下顿饭我们只能吃萝卜干泡饭"},{"number":304,"start":"00:12:31","end":"00:12:33","text":"那我们也认真吃"},{"number":305,"start":"00:12:33","end":"00:12:33","text":"为什么呢"},{"number":306,"start":"00:12:33","end":"00:12:37","text":"因为不可能有人一辈子都吃好饭"},{"number":307,"start":"00:12:37","end":"00:12:39","text":"在允许自己阶段性的呢"},{"number":308,"start":"00:12:39","end":"00:12:41","text":"偶尔吃个方便面好不好"},{"number":309,"start":"00:12:41","end":"00:12:44","text":"唉不意味着你吃方便面的那那一天"},{"number":310,"start":"00:12:44","end":"00:12:46","text":"你这个人就崩溃掉了"},{"number":311,"start":"00:12:46","end":"00:12:48","text":"或者你这个人就被解构掉了"},{"number":312,"start":"00:12:48","end":"00:12:49","text":"都是人"},{"number":313,"start":"00:12:49","end":"00:12:51","text":"都是你嗯"},{"number":314,"start":"00:12:51","end":"00:12:54","text":"老百姓把这个叫做能屈能伸"},{"number":315,"start":"00:12:54","end":"00:12:56","text":"高可高得低"},{"number":316,"start":"00:12:56","end":"00:12:57","text":"可低得好"},{"number":317,"start":"00:12:57","end":"00:12:58","text":"这是第二个泡面"},{"number":318,"start":"00:12:58","end":"00:13:01","text":"接下来我们来反推一个客观事实"},{"number":319,"start":"00:13:01","end":"00:13:02","text":"要不要听啊"},{"number":320,"start":"00:13:02","end":"00:13:05","text":"好的老师要听你的家庭教育"},{"number":321,"start":"00:13:05","end":"00:13:07","text":"尤其是你和你父亲的关系啊"},{"number":322,"start":"00:13:07","end":"00:13:10","text":"这一块我持一个怀疑的态度啊"},{"number":323,"start":"00:13:14","end":"00:13:18","text":"老师您指的嗯怀疑态度指的是什么呢"},{"number":324,"start":"00:13:18","end":"00:13:19","text":"您觉得就是有缺失吗"},{"number":325,"start":"00:13:19","end":"00:13:22","text":"它不仅仅是缺失的问题"},{"number":326,"start":"00:13:22","end":"00:13:24","text":"听起来不像是缺失"},{"number":327,"start":"00:13:24","end":"00:13:28","text":"而父亲在你过往的生命当中扮演的角色啊"},{"number":328,"start":"00:13:28","end":"00:13:31","text":"扮演的可能并没有拿到60分以上"},{"number":329,"start":"00:13:31","end":"00:13:32","text":"这是我的评估"},{"number":330,"start":"00:13:32","end":"00:13:34","text":"当然你可以来描述一点客观事实"},{"number":331,"start":"00:13:34","end":"00:13:35","text":"当然你也可以告诉我"},{"number":332,"start":"00:13:35","end":"00:13:36","text":"我们俩没有问题"},{"number":333,"start":"00:13:36","end":"00:13:38","text":"嗯都行"},{"number":334,"start":"00:13:38","end":"00:13:42","text":"嗯老师我觉得您说的是有一定道理的"},{"number":335,"start":"00:13:42","end":"00:13:47","text":"因为就是嗯就是我和我爸爸的关系还是挺好的"},{"number":336,"start":"00:13:47","end":"00:13:52","text":"而且我自己也比较嗯信任和依赖他吧"},{"number":337,"start":"00:13:52","end":"00:13:54","text":"但是的但是话就是我12岁之后"},{"number":338,"start":"00:13:54","end":"00:13:56","text":"我就成为了一个留守儿童"},{"number":339,"start":"00:13:56","end":"00:14:00","text":"所以那个时候的话我是和我哥哥一起生活的"},{"number":340,"start":"00:14:00","end":"00:14:01","text":"然后我哥哥的话"},{"number":341,"start":"00:14:01","end":"00:14:03","text":"他是比我大13岁"},{"number":342,"start":"00:14:03","end":"00:14:04","text":"可能在那个时候"},{"number":343,"start":"00:14:04","end":"00:14:09","text":"我哥哥他就嗯成为了一个嗯父亲的"},{"number":344,"start":"00:14:09","end":"00:14:11","text":"还有监护人的这个角色吧"},{"number":345,"start":"00:14:11","end":"00:14:15","text":"但是嗯因为我哥哥他情感上比较冷漠"},{"number":346,"start":"00:14:15","end":"00:14:18","text":"他其实对我呃不怎么嗯关心我"},{"number":347,"start":"00:14:18","end":"00:14:21","text":"然后也嗯不怎么照顾我之类的"},{"number":348,"start":"00:14:21","end":"00:14:23","text":"他就在家里面"},{"number":349,"start":"00:14:23","end":"00:14:26","text":"每天都是嗯在自己的房间里面打游戏"},{"number":350,"start":"00:14:26","end":"00:14:30","text":"然后根本就没有跟我有这种互动吧"},{"number":351,"start":"00:14:30","end":"00:14:34","text":"所以我认为您说的这个可能指向的是我哥哥"},{"number":352,"start":"00:14:35","end":"00:14:36","text":"不是你哥哥"},{"number":353,"start":"00:14:36","end":"00:14:37","text":"还是你父亲"},{"number":354,"start":"00:14:37","end":"00:14:39","text":"即便是出于生计考量"},{"number":355,"start":"00:14:39","end":"00:14:42","text":"必须得出去给一家人谋个酒"},{"number":356,"start":"00:14:42","end":"00:14:43","text":"搅个锅赚钱回来"},{"number":357,"start":"00:14:43","end":"00:14:45","text":"一家人才能吃上饭"},{"number":358,"start":"00:14:45","end":"00:14:47","text":"但是12岁你进入青春期"},{"number":359,"start":"00:14:47","end":"00:14:49","text":"父亲的缺失"},{"number":360,"start":"00:14:49","end":"00:14:51","text":"父亲代表着社会秩序"},{"number":361,"start":"00:14:51","end":"00:14:53","text":"规则权威"},{"number":362,"start":"00:14:53","end":"00:14:58","text":"尤其是代表着是这个社会和规则这一条的话"},{"number":363,"start":"00:14:58","end":"00:14:59","text":"他有重大的一个缺失"},{"number":364,"start":"00:14:59","end":"00:15:01","text":"而在这个缺失过程当中"},{"number":365,"start":"00:15:01","end":"00:15:02","text":"哥哥是替代不了的"},{"number":366,"start":"00:15:02","end":"00:15:04","text":"事实上是无法替代的"},{"number":367,"start":"00:15:04","end":"00:15:06","text":"你们同龄人嗯"},{"number":368,"start":"00:15:06","end":"00:15:07","text":"而在此情况之下的话"},{"number":369,"start":"00:15:07","end":"00:15:09","text":"那么下一步的推演是我"},{"number":370,"start":"00:15:09","end":"00:15:13","text":"我的认为一家之言是有很大的可能性"},{"number":371,"start":"00:15:13","end":"00:15:14","text":"从那个时期开始"},{"number":372,"start":"00:15:14","end":"00:15:17","text":"你开始了当下的这种心态的初期阶段"},{"number":373,"start":"00:15:20","end":"00:15:21","text":"就是说你投票的这种状态"},{"number":374,"start":"00:15:21","end":"00:15:23","text":"他不是当下才有"},{"number":375,"start":"00:15:23","end":"00:15:25","text":"大概率是从那个时期就有"},{"number":376,"start":"00:15:25","end":"00:15:29","text":"而构成这样的一个心态的主因的话是什么呢"},{"number":377,"start":"00:15:29","end":"00:15:30","text":"说出来就有点心酸了"},{"number":378,"start":"00:15:30","end":"00:15:33","text":"实际上并不是跟你哥哥一点关系没有"},{"number":379,"start":"00:15:33","end":"00:15:35","text":"你也不是为了对抗你哥哥"},{"number":380,"start":"00:15:35","end":"00:15:36","text":"你想用这样的方法"},{"number":381,"start":"00:15:36","end":"00:15:38","text":"比如说是努力的拿第一"},{"number":382,"start":"00:15:38","end":"00:15:40","text":"努力的让自己优秀起来"},{"number":383,"start":"00:15:40","end":"00:15:43","text":"努力的让自己看起来更好"},{"number":384,"start":"00:15:43","end":"00:15:44","text":"是不是啊"},{"number":385,"start":"00:15:44","end":"00:15:45","text":"客观意义上更好啊"},{"number":386,"start":"00:15:45","end":"00:15:46","text":"当然我们也可以评估"},{"number":387,"start":"00:15:46","end":"00:15:51","text":"客观意义上更好来捕获爱和认可"},{"number":388,"start":"00:15:51","end":"00:15:52","text":"来捕获世界"},{"number":389,"start":"00:15:52","end":"00:15:53","text":"可以看见你"},{"number":390,"start":"00:15:53","end":"00:15:54","text":"可是真实的道理"},{"number":391,"start":"00:15:54","end":"00:15:55","text":"不是这样子"},{"number":392,"start":"00:15:55","end":"00:15:57","text":"一个小孩子也好"},{"number":393,"start":"00:15:57","end":"00:15:58","text":"还是说是一个少女也好"},{"number":394,"start":"00:15:58","end":"00:16:00","text":"还是像你现在一个大姑娘也好"},{"number":395,"start":"00:16:00","end":"00:16:02","text":"不管你怎样"},{"number":396,"start":"00:16:02","end":"00:16:06","text":"这个世界对你都是无爱无恨得吧"},{"number":397,"start":"00:16:06","end":"00:16:08","text":"这个社会对你亦是如此"},{"number":398,"start":"00:16:08","end":"00:16:10","text":"你其实并不需要专门的去干嘛呢"},{"number":399,"start":"00:16:10","end":"00:16:12","text":"去证明自己"},{"number":400,"start":"00:16:12","end":"00:16:14","text":"而这个证明的这个动作的话"},{"number":401,"start":"00:16:14","end":"00:16:16","text":"他很容易一步走歪了之后"},{"number":402,"start":"00:16:16","end":"00:16:18","text":"变成了一个向世界撒娇"},{"number":403,"start":"00:16:18","end":"00:16:19","text":"当你向世界撒娇的时候"},{"number":404,"start":"00:16:19","end":"00:16:21","text":"你就看不见你自己了呀"},{"number":405,"start":"00:16:22","end":"00:16:24","text":"你更关注的是什么呢"},{"number":406,"start":"00:16:24","end":"00:16:27","text":"你可对接对称反弹补货回来"},{"number":407,"start":"00:16:27","end":"00:16:32","text":"捕获那些反弹回来的一些一些一些一些视角吧"},{"number":408,"start":"00:16:32","end":"00:16:33","text":"嗯这样子"},{"number":409,"start":"00:16:35","end":"00:16:36","text":"艾米老师"},{"number":410,"start":"00:16:36","end":"00:16:38","text":"我觉得你说的挺对的"},{"number":411,"start":"00:16:38","end":"00:16:41","text":"因为确实我在初中的时候"},{"number":412,"start":"00:16:41","end":"00:16:46","text":"那个时候就是嗯就有很就比我小学的时候"},{"number":413,"start":"00:16:46","end":"00:16:48","text":"要更加的努力去学习了"},{"number":414,"start":"00:16:48","end":"00:16:50","text":"然后也更加的希成"},{"number":415,"start":"00:16:50","end":"00:16:55","text":"希望就是学习成绩或者是这种学业方面的东西"},{"number":416,"start":"00:16:55","end":"00:16:57","text":"能够成为自己可控的一个事情"},{"number":417,"start":"00:16:57","end":"00:17:02","text":"然后获得父亲或者说家人的一些嗯认可夸赞"},{"number":418,"start":"00:17:02","end":"00:17:05","text":"这样子这个并不意味当年的你做错了什么"},{"number":419,"start":"00:17:05","end":"00:17:10","text":"只能够因为意味着当时的家庭养育氛围环境"},{"number":420,"start":"00:1