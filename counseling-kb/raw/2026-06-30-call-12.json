36","text":"好的诶"},{"number":194,"start":"00:07:36","end":"00:07:37","text":"好老师"},{"number":195,"start":"00:07:37","end":"00:07:38","text":"那我最后就问您一个"},{"number":196,"start":"00:07:38","end":"00:07:39","text":"就是我这几年"},{"number":197,"start":"00:07:39","end":"00:07:41","text":"因为我想着就是嗯"},{"number":198,"start":"00:07:41","end":"00:07:44","text":"比如说能再掌握一些这个别的行业的"},{"number":199,"start":"00:07:44","end":"00:07:45","text":"一些专业技能"},{"number":200,"start":"00:07:45","end":"00:07:48","text":"提升我以后就业的这个竞争力"},{"number":201,"start":"00:07:48","end":"00:07:52","text":"您有没有什么比较推荐的这个必学的技能"},{"number":202,"start":"00:07:52","end":"00:07:53","text":"没没有必学"},{"number":203,"start":"00:07:53","end":"00:07:57","text":"我可以结合你现在的专业给你推荐一个哎呀"},{"number":204,"start":"00:07:57","end":"00:07:58","text":"太好了"},{"number":205,"start":"00:07:58","end":"00:08:01","text":"您说音乐疗愈哦"},{"number":206,"start":"00:08:01","end":"00:08:02","text":"好的好的"},{"number":207,"start":"00:08:02","end":"00:08:06","text":"确实是哎好那个大兵老师"},{"number":208,"start":"00:08:06","end":"00:08:09","text":"您看这个就是AI音乐这个方向"},{"number":209,"start":"00:08:09","end":"00:08:10","text":"您说才好呢"},{"number":210,"start":"00:08:10","end":"00:08:15","text":"但是嗯好像目前好甚的是德国那边海德堡吧"},{"number":211,"start":"00:08:15","end":"00:08:17","text":"对海德堡出国了嗯"},{"number":212,"start":"00:08:17","end":"00:08:20","text":"海德堡那边音乐那个是特海德堡嗯"},{"number":213,"start":"00:08:20","end":"00:08:22","text":"哦好的好的"},{"number":214,"start":"00:08:22","end":"00:08:25","text":"这个以后发展应该很好是吧"},{"number":215,"start":"00:08:25","end":"00:08:26","text":"他不是发展"},{"number":216,"start":"00:08:26","end":"00:08:27","text":"而是社会需求"},{"number":217,"start":"00:08:27","end":"00:08:28","text":"就是大众认知"},{"number":218,"start":"00:08:28","end":"00:08:31","text":"而且的话已经开始了大众教育了"},{"number":219,"start":"00:08:31","end":"00:08:32","text":"就是很多人这块有意识了"},{"number":220,"start":"00:08:32","end":"00:08:35","text":"那么他将来的话肯定是有社会需求"},{"number":221,"start":"00:08:35","end":"00:08:36","text":"有社会需求的"},{"num