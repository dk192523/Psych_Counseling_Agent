":"00:14:59","text":"打完卡"},{"number":367,"start":"00:14:59","end":"00:15:00","text":"点完了"},{"number":368,"start":"00:15:00","end":"00:15:01","text":"毛人家赶紧"},{"number":369,"start":"00:15:01","end":"00:15:02","text":"然后去到塌方世界"},{"number":370,"start":"00:15:02","end":"00:15:04","text":"直接往生极乐了"},{"number":371,"start":"00:15:04","end":"00:15:05","text":"那可能性也很大呀"},{"number":372,"start":"00:15:05","end":"00:15:07","text":"对不对"},{"number":373,"start":"00:15:10","end":"00:15:12","text":"对不对"},{"number":374,"start":"00:15:15","end":"00:15:16","text":"有点没头"},{"number":375,"start":"00:15:16","end":"00:15:19","text":"哼嗯你就这么想就行"},{"number":376,"start":"00:15:19","end":"00:15:21","text":"这个孩子就是来打个卡而已"},{"number":377,"start":"00:15:21","end":"00:15:22","text":"打完了卡了之后"},{"number":378,"start":"00:15:22","end":"00:15:24","text":"人家是不是象征性的人"},{"number":379,"start":"00:15:24","end":"00:15:25","text":"点完点个卯"},{"number":380,"start":"00:15:25","end":"00:15:26","text":"打个卡"},{"number":381,"start":"00:15:26","end":"00:15:28","text":"人家赶紧的话"},{"number":382,"start":"00:15:28","end":"00:15:28","text":"忙活着"},{"number":383,"start":"00:15:28","end":"00:15:30","text":"赶紧去到人家本应该就去的世界"},{"number":384,"start":"00:15:30","end":"00:15:32","text":"去个好世界"},{"number":385,"start":"00:15:32","end":"00:15:35","text":"他如果只是过来打个卡"},{"number":386,"start":"00:15:35","end":"00:15:37","text":"但是生下来都全须全影"},{"number":387,"start":"00:15:37","end":"00:15:37","text":"啥都没有"},{"number":388,"start":"00:15:37","end":"00:15:39","text":"那他这张卡的话"},{"number":389,"start":"00:15:39","end":"00:15:40","text":"他得打个大几十年"},{"number":390,"start":"00:15:40","end":"00:15:42","text":"他打个七八十年"},{"number":391,"start":"00:15:42","end":"00:15:44","text":"人家嫌时间太长了"},{"number":392,"start":"00:15:45","end":"00:15:46","text":"他不像咱们很多人"},{"number":393,"start":"00:15:46","end":"00:15:48","text":"咱们不是抱着大卡的心理来"},{"number":394,"start":"00:15:48","end":"00:15:50","text":"我们就是来完完整整经历这一生"},{"number":395,"start":"00:15:50","end":"00:15:51","text":"我认为这