ber":285,"start":"00:08:09","end":"00:08:10","text":"就是陪伴着他"},{"number":286,"start":"00:08:10","end":"00:08:11","text":"和他一块胡打乱闹"},{"number":287,"start":"00:08:11","end":"00:08:13","text":"说疯话"},{"number":288,"start":"00:08:13","end":"00:08:14","text":"然后聊外星人"},{"number":289,"start":"00:08:14","end":"00:08:16","text":"聊吃的都行"},{"number":290,"start":"00:08:16","end":"00:08:18","text":"让他开心好吗"},{"number":291,"start":"00:08:18","end":"00:08:21","text":"人最快速获得幸福感的来源的话"},{"number":292,"start":"00:08:21","end":"00:08:22","text":"除了吃之外"},{"number":293,"start":"00:08:22","end":"00:08:26","text":"就是能够在他人身上快速获得正反馈"},{"number":294,"start":"00:08:26","end":"00:08:27","text":"比如你扮演一个强者"},{"number":295,"start":"00:08:27","end":"00:08:28","text":"一个养育者"},{"number":296,"start":"00:08:28","end":"00:08:29","text":"一个监护人的身份"},{"number":297,"start":"00:08:29","end":"00:08:32","text":"能够在最短的时间之内让你的孩子高兴和开心"},{"number":298,"start":"00:08:32","end":"00:08:34","text":"你看着她高兴"},{"number":299,"start":"00:08:34","end":"00:08:35","text":"你心里边可美了"},{"number":300,"start":"00:08:35","end":"00:08:38","text":"这是最好的一种修心和滋养"},{"number":301,"start":"00:08:38","end":"00:08:39","text":"懂吗"},{"number":302,"start":"00:08:39","end":"00:08:43","text":"嗯所以我们经常讲孩子是机会"},{"number":303,"start":"00:08:43","end":"00:08:45","text":"孩子是上天的礼物"},{"number":304,"start":"00:08:45","end":"00:08:46","text":"孩子也是一个机会"},{"number":305,"start":"00:08:46","end":"00:08:48","text":"像你们有孩子当爹当妈的人"},{"number":306,"start":"00:08:48","end":"00:08:50","text":"实际上你要知道"},{"number":307,"start":"00:08:50","end":"00:08:53","text":"不是说是光是你们来养育他"},{"number":308,"start":"00:08:53","end":"00:08:55","text":"他们某种意义上是负载着巨大的能量"},{"number":309,"start":"00:08:55","end":"00:08:57","text":"他们也是过来滋养你的"},{"number":310,"start":"00:08:57","end":"00:09:02","text":"关键是你如何来和他是不是哎发生化学反应"},{"number":311,"start":"00:09:02","end":"00:09:03","text":"就是这么简单"},{"number":312,"start":"00:09:03","end":"00:09:04","text":"心里有不高兴"},{"number":313,"start":"00:09:04","end":"00:09:06","text":"不高兴的时候去抱孩子去"},{"number":314,"start":"00:09:06","end":"00:09:08","text":"而不是不高兴的时候去训孩子"},{"number":315,"start":"00:09:08","end":"00:09:09","text":"急傻"},{"number":316,"start":"00:09:09","end":"00:09:11","text":"很多人都是如此极傻"},{"number":317,"start":"00:09:11","end":"00:09:12","text":"你不高兴的时候"},{"number":318,"start":"00:09:12","end":"00:09:13","text":"你就训孩子"},{"number":319,"start":"00:09:13","end":"00:09:14","text":"冲着孩子撒气"},{"number":320,"start":"00:09:14","end":"00:09:17","text":"这不典型的东亚权力家庭模式吗"},{"number":321,"start":"00:09:17","end":"00:09:19","text":"可是逮着一个人可以欺负"},{"number":322,"start":"00:09:19","end":"00:09:19","text":"欺负了"},{"number":323,"start":"00:09:19","end":"00:09:21","text":"在外边弯了一辈子的腰"},{"number":324,"start":"00:09:21","end":"00:09:22","text":"在孩子面前反而挺起来了"},{"number":325,"start":"00:09:22","end":"00:09:24","text":"不是你越不高兴的时候"},{"number":326,"start":"00:09:24","end":"00:09:25","text":"你去抱孩子"},{"number":327,"start":"00:09:25","end":"00:09:26","text":"你去让孩子高兴"},{"number":328,"start":"00:09:26","end":"00:09:28","text":"这样子反而你高兴的速度更快"},{"number":329,"start":"00:09:28","end":"00:09:30","text":"哎就这么简单啊"},{"number":330,"start":"00:09:35","end":"00:09:36","text":"范明老师"},{"number":331,"start":"00:09:36","end":"00:09:42","text":"就是呃还想还想请教一下内向性格如何打开"},{"number":332,"start":"00:09:42","end":"00:09:43","text":"自己"},{"number":333,"start":"00:09:43","end":"00:09:44","text":"为什么要打开"},{"number":334,"start":"00:09:44","end":"00:09:50","text":"然后呃就是自己据说别人评价挺优秀"},{"number":335,"start":"00:09:50","end":"00:09:52","text":"但不够自信"},{"number":336,"start":"00:09:53","end":"00:09:56","text":"为什么非得自信嗯"},{"number":337,"start":"00:09:56","end":"00:09:58","text":"这个世界上是不是一个人不自信"},{"number":338,"start":"00:09:58","end":"00:10:00","text":"不外向就没法活了"},{"number":339,"start":"00:10:00","end":"00:10:01","text":"我能告诉你的是"},{"number":340,"start":"00:10:01","end":"00:10:02","text":"在这个人世间"},{"number":341,"start":"00:10:02","end":"00:10:05","text":"咱们就都不止一半的人"},{"number":342,"start":"00:10:05","end":"00:10:08","text":"超过一半以上的这个人都是不善言辞"},{"number":343,"start":"00:10:08","end":"00:10:12","text":"也没有太多的这样外话可去观测的自信"},{"number":344,"start":"00:10:12","end":"00:10:14","text":"乃至于有点闷头闷脑的"},{"number":345,"start":"00:10:14","end":"00:10:16","text":"咱们所谓的凡人嘛"},{"number":346,"start":"00:10:16","end":"00:10:17","text":"所谓的凡人"},{"number":347,"start":"00:10:17","end":"00:10:18","text":"绝大多数我们都是这样的"},{"number":348,"start":"00:10:18","end":"00:10:21","text":"凡人不意味着做错了什么"},{"number":349,"start":"00:10:21","end":"00:10:23","text":"这样活就行好不好"},{"number":350,"start":"00:10:23","end":"00:10:26","text":"并不要因为这个世界的评判体系"},{"number":351,"start":"00:10:26","end":"00:10:27","text":"或者他人对你的界定"},{"number":352,"start":"00:10:27","end":"00:10:29","text":"一定去纠错自己或者改变自己"},{"number":353,"start":"00:10:29","end":"00:10:31","text":"反而是一种自我攻击"},{"number":354,"start":"00:10:31","end":"00:10:32","text":"你记住一句话"},{"number":355,"start":"00:10:32","end":"00:10:34","text":"你都是为人父的人"},{"number":356,"start":"00:10:34","end":"00:10:36","text":"你但凡如果你现在刚结婚或者没结婚时"},{"number":357,"start":"00:10:36","end":"00:10:38","text":"年轻小伙子这话我不说了"},{"number":358,"start":"00:10:38","end":"00:10:40","text":"如果你已经是开始给人当爹的人"},{"number":359,"start":"00:10:40","end":"00:10:42","text":"我觉着啊就掌握一个前提"},{"number":360,"start":"00:10:42","end":"00:10:43","text":"一个原则就行"},{"number":361,"start":"00:10:43","end":"00:10:44","text":"我就是这样的人"},{"number":362,"start":"00:10:44","end":"00:10:46","text":"我忠实于自己"},{"number":363,"start":"00:10:46","end":"00:10:48","text":"我只要不犯明显的错误"},{"number":364,"start":"00:10:48","end":"00:10:50","text":"我该咋样就咋样"},{"number":365,"start":"00:10:50","end":"00:10:51","text":"哪怕我沉默一点"},{"number":366,"start":"00:10:51","end":"00:10:52","text":"我内向一点"},{"number":367,"start":"00:10:52","end":"00:10:53","text":"我没有做错什么"},{"number":368,"start":"00:10:53","end":"00:10:54","text":"就这么简单"},{"number":369,"start":"00:10:55","end":"00:10:57","text":"嗯谢谢谢您"},{"number":370,"start":"00:10:57","end":"00:11:02","text":"然后如果如果我如果我有二胎的话"},{"number":371,"start":"00:11:02","end":"00:11:06","text":"男孩或者女孩能请您想一个小名吗"},{"number":372,"start":"00:11:06","end":"00:11:09","text":"你别如果啊有还是没有啊"},{"number":373,"start":"00:11:09","end":"00:11:10","text":"到现在还没有"},{"number":374,"start":"00:11:11","end":"00:11:14","text":"你喜欢男孩女孩啊"},{"number":375,"start":"00:11:14","end":"00:11:16","text":"呃都都喜欢"},{"number":376,"start":"00:11:16","end":"00:11:18","text":"现在因为第一个是女孩嘛"},{"number":377,"start":"00:11:18","end":"00:11:19","text":"如果有第二个"},{"number":378,"start":"00:11:19","end":"00:11:20","text":"如果是男孩的话"},{"number":379,"start":"00:11:20","end":"00:11:22","text":"可能那你你你胆子"},{"number":380,"start":"00:11:22","end":"00:11:23","text":"首先我得承认挺大"},{"number":381,"start":"00:11:23","end":"00:11:24","text":"敢找我来起小名"},{"number":382,"start":"00:11:24","end":"00:11:27","text":"第二一个的话你得给点信息支点"},{"number":383,"start":"00:11:27","end":"00:11:30","text":"要不然我我不知道怎么给得起"},{"number":384,"start":"00:11:31","end":"00:11:37","text":"嗯就是希望希望如果他能来到这个世界的话"},{"number":385,"start":"00:11:37","end":"00:11:43","text":"希望他能呃坚强勇敢嗯"},{"number":386,"start":"00:11:45","end":"00:11:51","text":"就是因为未来未来的这个世界变化会很大"},{"number":387,"start":"00:11:51","end":"00:11:53","text":"如果他能来到"},{"number":388,"start":"00:11:53","end":"00:11:55","text":"希望他能平安吧"},{"number":389,"start":"00:11:56","end":"00:11:58","text":"坚强勇敢平安"},{"number":390,"start":"00:11:59","end":"00:12:02","text":"对啊好"},{"number":391,"start":"00:12:02","end":"00:12:04","text":"坚强勇敢平安"},{"number":392,"start":"00:12:04","end":"00:12:06","text":"我给你起一个绝对不重名"},{"number":393,"start":"00:12:06","end":"00:12:13","text":"但我起了你得用好的防弹衣哦"},{"number":394,"start":"00:12:13","end":"00:12:14","text":"很好很好"},{"number":395,"start":"00:12:14","end":"00:12:16","text":"我很喜欢这个名字"},{"number":396,"start":"00:12:16","end":"00:12:17","text":"防弹衣啊"},{"number":397,"start":"00:12:17","end":"00:12:17","text":"你小姨要生"},{"number":398,"start":"00:12:17","end":"00:12:20","text":"你重新就是又第二个是小姑娘"},{"number":399,"start":"00:12:20","end":"00:12:22","text":"小姑娘从幼儿园到小学呃"},{"number":400,"start":"00:12:22","end":"00:12:23","text":"小小名叫防弹衣"},{"number":401,"start":"00:12:23","end":"00:12:24","text":"绝对不重样"},{"number":402,"start":"00:12:24","end":"00:12:25","text":"独一无二"},{"number":403,"start":"00:12:26","end":"00:12:28","text":"好好好好哎"},{"number":404,"start":"00:12:28","end":"00:12:30","text":"本来我想起的稍微长一点"},{"number":405,"start":"00:12:30","end":"00:12:32","text":"然后但但是我想想算了吧"},{"number":406,"start":"00:12:32","end":"00:12:34","text":"就叫防弹衣就行啊"},{"number":407,"start":"00:12:34","end":"00:12:37","text":"嗯嗯嗯好好好"},{"number":408,"start":"00:12:37","end":"00:12:38","text":"谢谢谢谢您"},{"number":409,"start":"00:12:38","end":"00:12:39","text":"谢谢您"},{"number":410,"start":"00:12:39","end":"00:12:40","text":"好拜拜嗯"},{"number":411,"start":"00:12:40","end":"00:12:43","text":"好拜拜拜拜嗯拜拜嗯"},{"number":412,"start":"00:12:48","end":"00:12:50","text":"本来我想叫碳纤维加综合"},{"number":413,"start":"00:12:50","end":"00:12:53","text":"这碳纤维加凯夫拉综合材质防弹衣"},{"number":414,"start":"00:12:53","end":"00:12:54","text":"但是这个有点长"},{"number":415,"start":"00:12:54","end":"00:12:56","text":"所以直接叫防弹衣吧"},{"number":416,"start":"00:12:56","end":"00:12:57","text":"好不好"},{"number":417,"start":"00:12:57","end":"00:13:01","text":"平安安全这各方面"},{"number":418,"start":"00:13:02","end":"00:13:06","text":"唉其实我本来刚才想叫个三级甲的"},{"number":419,"start":"00:13:08","end":"00:13:10","text":"但是确实不太好"}],"sameDate":[{"slug":"2026-05-03-call-01","title":"咨询师回忆早年在主持到吐血，坦言直播是大家互相成就","date":"2026-05-03","duration":"12分51秒","index":454,"callNumber":1,"rawTranscriptUrl":"/raw/2026-05-03-call-01"},{"slug":"2026-05-03-call-02","title":"从小打压式教育的女生，遇推卸责任暴躁男友，咨询师：这是强迫性重复","date":"2026-05-03","duration":"15分1秒","index":455,"callNumber":2,"rawTranscriptUrl":"/raw/2026-05-03-call-02"},{"slug":"2026-05-03-call-03","title":"异地12年女士噩梦缠身，咨询师戳穿丈夫：别用公婆帮带抹杀她付出","date":"2026-05-03","duration":"26分10秒","index":456,"callNumber":3,"rawTranscriptUrl":"/raw/2026-05-03-call-03"},{"slug":"2026