0:07:54","end":"00:07:56","text":"然后来进入这个行业做点什么事情"},{"number":195,"start":"00:07:56","end":"00:07:58","text":"风险比太高了"},{"number":196,"start":"00:07:59","end":"00:08:02","text":"OK明白明白明白嗯"},{"number":197,"start":"00:08:02","end":"00:08:03","text":"对对对"},{"number":198,"start":"00:08:03","end":"00:08:05","text":"我的建议是啥呢"},{"number":199,"start":"00:08:05","end":"00:08:06","text":"到了这个年龄了之后啊"},{"number":200,"start":"00:08:06","end":"00:08:08","text":"不是说你没有可能性"},{"number":201,"start":"00:08:08","end":"00:08:10","text":"而是尽量的把这个可能性"},{"number":202,"start":"00:08:10","end":"00:08:11","text":"从我们已经完成的积累"},{"number":203,"start":"00:08:11","end":"00:08:14","text":"以及你有丰富经验的这些维度议题之内"},{"number":204,"start":"00:08:14","end":"00:08:16","text":"我们来寻求可能性"},{"number":205,"start":"00:08:16","end":"00:08:19","text":"尽量不重新做一个从0~1"},{"number":206,"start":"00:08:19","end":"00:08:21","text":"另起炉灶的这样的一个动作"},{"number":207,"start":"00:08:22","end":"00:08:25","text":"精力体力年龄都是不饶人的"},{"number":208,"start":"00:08:25","end":"00:08:27","text":"那你现在的这个岁数"},{"number":209,"start":"00:08:27","end":"00:08:28","text":"你熬上一晚上"},{"number":210,"start":"00:08:28","end":"00:08:29","text":"你两天恢复得了吗"},{"number":211,"start":"00:08:29","end":"00:08:31","text":"恢复不了"},{"number":212,"start":"00:08:31","end":"00:08:35","text":"是不是嗯对啊"},{"number":213,"start":"00:08:35","end":"00:08:37","text":"目前还行好嘞"},{"number":214,"start":"00:08:37","end":"00:08:39","text":"明白"},{"number":215,"start":"00:08:41","end":"00:08:42","text":"行好嘞好嘞"},{"number":216,"start":"00:08:42","end":"00:08:43","text":"谢谢大斌老师哦"},{"number":217,"start":"00:08:43","end":"00:08:44","text":"太晚了"},{"number":218,"start":"00:08:44","end":"00:08:45","text":"来辛苦您啊"},{"number":219,"start":"00:08:45","end":"00:08:47","text":"我没有其他的问题了"},{"number":220,"start":"00:08:47","end":"00:08:54","text":"客气嗯嗯嗯拜拜晚安再见再见"},{"number":221,"start":"00:08:55","end":"00:08:57","text":"金税四期出来了之后的话"},{"number":222,"start":"00:08:57","end":"00:08:58","text":"就很多人讲"},{"number":223,"start":"00:08:58","end":"00:09:00","text":"那那是是是以后就没有税收师这个岗位"},{"number":224,"start":"00:09:00","end":"00:09:01","text":"那现在来看的话"},{"number":225,"start":"00:09:01","end":"00:09:04","text":"照样还是有税收存在的必要及合理性的"},{"number":226,"start":"00:09:04","end":"00:09:06","text":"你不愿意在单位当了"},{"number":227,"start":"00:09:06","end":"00:09:07","text":"你自己另起炉灶"},{"number":228,"start":"00:09:07","end":"00:09:08","text":"你干你熟悉的行当也行啊"},{"number":229,"start":"00:09:08","end":"00:09:09","text":"直接服务"},{"number":230,"start":"00:09:09","end":"00:09:14","text":"然后一些私人客户或者说是服务一部分"},{"number":231,"start":"00:09:14","end":"00:09:15","text":"是不是通过人脉"},{"number":232,"start":"00:09:15","end":"00:09:17","text":"社会关系来发展出去了就行了嘛"},{"number":233,"start":"00:09:17","end":"00:09:20","text":"主要有点事干就好了"},{"number":234,"start":"00:09:21","end":"00:09:23","text":"当然你单位既然能够返聘的话"},{"number":235,"start":"00:09:23","end":"00:09:25","text":"那接着回去干不也挺好吗"},{"number":236,"start":"00:09:25","end":"00:09:26","text":"至于你所说的"},{"number":237,"start":"00:09:26","end":"00:09:29","text":"为什么你现在的话就不想干了"},{"number":238,"start":"00:09:29","end":"00:09:31","text":"现在就是想改变或者干嘛"},{"number":239,"start":"00:09:31","end":"00:09:32","text":"我怀疑啊"},{"number":240,"start":"00:09:32","end":"00:09:34","text":"我严重怀疑啊"},{"number":241,"start":"00:09:34","end":"00:09:35","text":"短视频刷多了"},{"number":242,"start":"00:09:35","end":"00:09:36","text":"要不然就是线下"},{"number":243,"start":"00:09:36","end":"00:09:39","text":"你哪个老姊妹儿拽着你去听过什么课"},{"number":244,"start":"00:09:39","end":"00:09:42","text":"叫人家给多多少少的给打过鸡血"},{"number":245,"start":"00:09:42","end":"00:09:44","text":"认为可能性无限"},{"number":246,"start":"00:09:44","end":"00:09:46","text":"哎对"},{"number":247,"start":"00:09:52","end":"00:09:53","text":"好下一位"}],"sameDate":[{"slug":"2026-03-10-call-01","title":"32岁县城事业编纠结辞职还是做副业，咨询师直言他根本不会行动","date":"2026-03-10","duration":"9分52秒","index":775,"callNumber":1,"rawTranscriptUrl":"/raw/2026-03-10-call-01"},{"slug":"2026-03-10-call-02","title":"山东听众欲徒步岗仁波齐转山，咨询师指