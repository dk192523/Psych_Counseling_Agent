ber":475,"start":"00:16:33","end":"00:16:36","text":"破财的心理准备啊"},{"number":476,"start":"00:16:37","end":"00:16:40","text":"明白了好的"},{"number":477,"start":"00:16:40","end":"00:16:42","text":"所以他不是一个地域选择"},{"number":478,"start":"00:16:42","end":"00:16:44","text":"他是一个人群选择"},{"number":479,"start":"00:16:44","end":"00:16:46","text":"而这个人群选择的话呢"},{"number":480,"start":"00:16:46","end":"00:16:49","text":"尽量是可接纳你的人群啊"},{"number":481,"start":"00:16:49","end":"00:16:51","text":"类似于这种"},{"number":482,"start":"00:16:51","end":"00:16:53","text":"而这个切入点我刚才给你讲了"},{"number":483,"start":"00:16:53","end":"00:16:57","text":"你完全从零开始重新去搭建"},{"number":484,"start":"00:16:57","end":"00:16:59","text":"你过往存量的人生经历"},{"number":485,"start":"00:16:59","end":"00:17:01","text":"里边没有过场景锻炼的"},{"number":486,"start":"00:17:01","end":"00:17:02","text":"你不像我们"},{"number":487,"start":"00:17:02","end":"00:17:03","text":"你把我们撂在哪"},{"number":488,"start":"00:17:03","end":"00:17:04","text":"我可以迅速打开局面"},{"number":489,"start":"00:17:04","end":"00:17:07","text":"就像我们去年亚欧非摩旅"},{"number":490,"start":"00:17:07","end":"00:17:08","text":"我们到了巴塞罗那了之后"},{"number":491,"start":"00:17:08","end":"00:17:09","text":"我先回来了"},{"number":492,"start":"00:17:09","end":"00:17:11","text":"我把小黑和达子扔在巴塞"},{"number":493,"start":"00:17:11","end":"00:17:13","text":"我就给他介绍了苏的一个朋友"},{"number":494,"start":"00:17:13","end":"00:17:16","text":"到最后他们通过苏的话认识了545十个朋友"},{"number":495,"start":"00:17:16","end":"00:17:17","text":"都不止"},{"number":496,"start":"00:17:17","end":"00:17:20","text":"整个在那边的华人社会都打开名气了"},{"number":497,"start":"00:17:20","end":"00:17:22","text":"天天带着大家的话一块去看球赛"},{"number":498,"start":"00:17:22","end":"00:17:24","text":"完了一块组织活动"},{"number":499,"start":"00:17:24","end":"00:17:25","text":"还烧烤干嘛呢"},{"number":500,"start":"00:17:25","end":"00:17:26","text":"因为什么呢"},{"number":501,"start":"00:17:26","end":"00:17:28","text":"是走江湖跑码头的人"},{"number":502,"start":"00:17:28","end":"00:17:29","text":"懂得如何打开局面"},{"number":503,"start":"00:17:29","end":"00:17:33","text":"懂得如何一上来的话就把无利害关系"},{"number":504,"start":"00:17:33","end":"00:17:34","text":"这一点的话"},{"number":505,"start":"00:17:34","end":"00:17:36","text":"话里话外全部表现表现明白"},{"number":506,"start":"00:17:36","end":"00:17:37","text":"就是你们什么都别图我"},{"number":507,"start":"00:17:37","end":"00:17:38","text":"我也不图你们"},{"number":508,"start":"00:17:38","end":"00:17:40","text":"咱们就是开心高兴在一块玩"},{"number":509,"start":"00:17:40","end":"00:17:41","text":"玩完了之后"},{"number":510,"start":"00:17:41","end":"00:17:42","text":"我走了走了"},{"number":511,"start":"00:17:42","end":"00:17:44","text":"有可能我们这辈子都见不着"},{"number":512,"start":"00:17:44","end":"00:17:45","text":"当我们留下美好的回忆"},{"number":513,"start":"00:17:45","end":"00:17:47","text":"将来如果一旦我有可能性再回来的话"},{"number":514,"start":"00:17:47","end":"00:17:49","text":"再来咱们照样高高兴兴的玩"},{"number":515,"start":"00:17:49","end":"00:17:51","text":"谁不喜欢这样的人呢"},{"number":516,"start":"00:17:51","end":"00:17:53","text":"这个是你们在办公室待了这么多人"},{"number":517,"start":"00:17:53","end":"00:17:55","text":"不掌握的技能及方法"},{"number":518,"start":"00:17:55","end":"00:17:57","text":"这个是我们走江湖跑码头的人"},{"number":519,"start":"00:17:57","end":"00:17:58","text":"我们多少年锻炼出来的"},{"number":520,"start":"00:17:58","end":"00:18:01","text":"所以不建议你们去到一个完全陌生的地方"},{"number":521,"start":"00:18:01","end":"00:18:02","text":"从0~1来解决这个门槛"},{"number":522,"start":"00:18:02","end":"00:18:04","text":"动作成本会过高"},{"number":523,"start":"00:18:04","end":"00:18:06","text":"所以希望你们的切入点最好是什么呢"},{"number":524,"start":"00:18:06","end":"00:18:07","text":"投亲靠友"},{"number":525,"start":"00:18:07","end":"00:18:10","text":"投亲靠友这样子啊"},{"number":526,"start":"00:18:10","end":"00:18:13","text":"因为我们的这个亲友啊都在河北"},{"number":527,"start":"00:18:13","end":"00:18:16","text":"但是这河北并不是我们喜欢的一个地方嘛"},{"number":528,"start":"00:18:16","end":"00:18:19","text":"毕竟包括老家的这个环境污染也比较严重"},{"number":529,"start":"00:18:19","end":"00:18:21","text":"所以只想着说"},{"number":530,"start":"00:18:21","end":"00:18:24","text":"找一些跟我们现在的生活环境不一样的地方"},{"number":531,"start":"00:18:24","end":"00:18:27","text":"因为这十几年的工作呢一直在北京啊"},{"number":532,"start":"00:18:27","end":"00:18:29","text":"但是北京并没有给我家的感觉"},{"number":533,"start":"00:18:29","end":"00:18:30","text":"所以就想换"},{"number":534,"start":"00:18:30","end":"00:18:32","text":"再次跟你强调环境不重要"},{"number":535,"start":"00:18:32","end":"00:18:34","text":"如果你今年五六十岁的话"},{"number":536,"start":"00:18:34","end":"00:18:35","text":"环境很重要"},{"number":537,"start":"00:18:35","end":"00:18:37","text":"宜养地宜居地嘛"},{"number":538,"start":"00:18:37","end":"00:18:38","text":"但如果你还年轻的话"},{"number":539,"start":"00:18:38","end":"00:18:40","text":"这个岁数还不到40岁的话"},{"number":540,"start":"00:18:40","end":"00:18:41","text":"环境不重要"},{"number":541,"start":"00:18:41","end":"00:18:42","text":"人重要"},{"number":542,"start":"00:18:42","end":"00:18:43","text":"哪怕他重污染"},{"number":543,"start":"00:18:43","end":"00:18:45","text":"他的人也比环境重要"},{"number":544,"start":"00:18:47","end":"00:18:48","text":"明白嗯"},{"number":545,"start":"00:18:48","end":"00:18:52","text":"因为我见过太多像你这样情况的朋友了"},{"number":546,"start":"00:18:52","end":"00:18:55","text":"是这些中国著名的风景秀美的地方"},{"number":547,"start":"00:18:55","end":"00:18:57","text":"旅游目的地嗯"},{"number":548,"start":"00:18:57","end":"00:18:59","text":"这么多年我太有发言权了"},{"number":549,"start":"00:18:59","end":"00:19:00","text":"我见过太多"},{"number":550,"start":"00:19:00","end":"00:19:04","text":"像你们这样基于环境而奔赴了这个地方"},{"number":551,"start":"00:19:04","end":"00:19:06","text":"待到第3年或者第5年"},{"number":552,"start":"00:19:06","end":"00:19:10","text":"忍痛把你们在那个地方买的以及装修的房子"},{"number":553,"start":"00:19:10","end":"00:19:12","text":"甚至是客栈盘下来的客栈"},{"number":554,"start":"00:19:12","end":"00:19:14","text":"忍痛割肉出手"},{"number":555,"start":"00:19:14","end":"00:19:17","text":"然后再重新回归回去"},{"number":556,"start":"00:19:17","end":"00:19:18","text":"你们之前去过去"},{"number":557,"start":"00:19:18","end":"00:19:22","text":"就是就回到你们重新曾经出发的地方太多了"},{"number":558,"start":"00:19:22","end":"00:19:24","text":"我也看到过很多这样的案例"},{"number":559,"start":"00:19:24","end":"00:19:25","text":"所以我才会犹豫"},{"number":560,"start":"00:19:25","end":"00:19:27","text":"因为比如说我在小红书上看到了以后"},{"number":561,"start":"00:19:27","end":"00:19:29","text":"他会疯狂的给我推这些东西"},{"number":562,"start":"00:19:29","end":"00:19:32","text":"然后推到推到最后都是我这也玩不下去了"},{"number":563,"start":"00:19:32","end":"00:19:35","text":"或者是我要忍痛把这个客栈卖掉了"},{"number":564,"start":"00:19:35","end":"00:19:36","text":"把我小院装好了"},{"number":565,"start":"00:19:36","end":"00:19:36","text":"卖掉了"},{"number":566,"start":"00:19:36","end":"00:19:37","text":"我要回到原来的生活了"},{"number":567,"start":"00:19:37","end":"00:19:41","text":"我也会怕自己有一天会会会会待不住"},{"number":568,"start":"00:19:41","end":"00:19:41","text":"会怎么样的"},{"number":569,"start":"00:19:41","end":"00:19:43","text":"所以就是说想跟您联一下"},{"number":570,"start":"00:19:43","end":"00:19:46","text":"因为你对这方面的这个接触的人也比较多"},{"number":571,"start":"00:19:46","end":"00:19:49","text":"想那我给您做一番意识加强及印证"},{"number":572,"start":"00:19:50","end":"00:19:54","text":"嗯对最后一番意识加强及印证"},{"number":573,"start":"00:19:55","end":"00:19:56","text":"嗯感谢大饼老师"},{"number":574,"start":"00:19:56","end":"00:19:57","text":"我的问题问完了"},{"number":575,"start":"00:19:57","end":"00:20:00","text":"好嘞拜拜嗯"},{"number":576,"start":"00:20:00","end":"00:20:01","text":"好的再见嗯"}],"sameDate":[{"slug":"2026-05-17-call-01","title":"已婚00后医学女生，体制内还是读研？如何处理与闺蜜矛盾","date":"2026-05-17","duration":"13分44秒","index":367,"callNumber":1,"rawTranscriptUrl":"/raw/2026-05-17-call-01"},{"slug":"2026-05-17-call-02","title":"34岁书法创业男七年感情不求婚，问咨询师该不该结婚","date":"2026-05-17","duration":"17分10秒","index":368,"callNumber":2,"rawTranscriptUrl":"/raw/2026-05-17-call-02"},{"slug":"2026-05-17-call-03","title":"尿毒症透析11年攒两套房给媳妇存100万，咨询师要帮他改编成短剧","date":"2026-05-17","duration":"39分42秒","index":369,"callNumber":3,"rawTranscriptUrl":"/raw/2026-05-17-call-03"},{"slug":"2026-05-17-call-04","title":"28岁教师考公计划总打折扣，咨询师：不是自律问题是想太多动太少","date":"2026-05-17","duration":"17分5秒","index":370,"callNumber":4,"rawTranscriptUrl":"/raw/2026-05-17-call-