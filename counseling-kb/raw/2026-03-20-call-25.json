00:11:52","text":"再加点白糖"},{"number":346,"start":"00:11:57","end":"00:11:57","text":"啊"},{"number":347,"start":"00:12:00","end":"00:12:00","text":"可以可以"},{"number":348,"start":"00:12:00","end":"00:12:04","text":"这边很喜欢加黄豆粉哈啊漂亮漂亮"},{"number":349,"start":"00:12:04","end":"00:12:06","text":"谢谢贵阳的滨江"},{"number":350,"start":"00:12:06","end":"00:12:09","text":"其实就是加糯米打的这种水果冰"},{"number":351,"start":"00:12:09","end":"00:12:11","text":"来马上上来看看"},{"number":352,"start":"00:12:12","end":"00:12:14","text":"嗯这芒果香很天然"},{"number":353,"start":"00:12:14","end":"00:12:15","text":"微微带一点酸"},{"number":354,"start":"00:12:15","end":"00:12:17","text":"尤其是加了糯米以后"},{"number":355,"start":"00:12:17","end":"00:12:21","text":"更多一点那种浓稠的碳水的满足感"},{"number":356,"start":"00:12:21","end":"00:12:22","text":"诶还蛮好吃的"},{"number":357,"start":"00:12:22","end":"00:12:24","text":"我蛮喜欢的"},{"number":358,"start":"00:12:24","end":"00:12:25","text":"老板拜拜哈"},{"number":359,"start":"00:12:25","end":"00:12:27","text":"嗯拜拜嘿嘿"},{"number":360,"start":"00:12:27","end":"00:12:28","text":"那今天去的地方呢"},{"number":361,"start":"00:12:28","end":"00:12:30","text":"虽然比我想象中的网红"},{"number":362,"start":"00:12:30","end":"00:12:32","text":"虽然吃不惯折耳根"},{"number":363,"start":"00:12:32","end":"00:12:34","text":"但是基本上没有踩雷"},{"number":364,"start":"00:12:34","end":"00:12:35","text":"我觉得大家都可以来试试看"},{"number":365,"start":"00:12:35","end":"00:12:36","text":"再见啦拜拜"}],"sameDate":[{"slug":"2026-03-20-call-01","title":"初一女生被传坏话太敏感，咨询师点破家庭影响根源","date":"2026-03-20","duration":"25分48秒","index":709,"callNumber":1,"rawTranscriptUrl":"/raw/2026-03-20-call-01"},{"slug":"2026-03-20-call-04","title":"16岁双相孩子家庭破碎，咨询师暖心资助5000元","date":"2026-03-20","duration":"25分48秒","index":710,"callNumber":4,"rawTranscriptUrl":"/raw/2026-03-20-call-04"},{"slug":"2026-03-20-call-07","title":"小六女生被说「装」后拒绝跳绳班，咨询师戳破：母亲乱贴敏感标签才是真正的问题","date":"2026-03-20","duration":"25分48秒","index":711,"callNumber":7,"rawTranscriptUrl":"/raw/2026-03-20-call-07"},{"slug":"2026-03-20-call-11","title":"近