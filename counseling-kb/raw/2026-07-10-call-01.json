:15:42","end":"00:15:46","text":"嗯我理解就是这关系模式不太一样"},{"number":279,"start":"00:15:47","end":"00:15:49","text":"你这不是听到了吗"},{"number":280,"start":"00:15:52","end":"00:15:55","text":"对啊就是的"},{"number":281,"start":"00:15:57","end":"00:15:59","text":"你将来你的家庭生活"},{"number":282,"start":"00:15:59","end":"00:16:01","text":"你和你妻子的关系"},{"number":283,"start":"00:16:01","end":"00:16:05","text":"和你现在跟这两个这两个要你钱的人啊"},{"number":284,"start":"00:16:05","end":"00:16:08","text":"咱们先我们现在也无法确定是否是未成年人"},{"number":285,"start":"00:16:08","end":"00:16:11","text":"他的关系模式不一样啊"},{"number":286,"start":"00:16:16","end":"00:16:17","text":"好"},{"number":287,"start":"00:16:23","end":"00:16:26","text":"哦这呃最后还想请教一个"},{"number":288,"start":"00:16:27","end":"00:16:30","text":"呃就是会感觉说"},{"number":289,"start":"00:16:33","end":"00:16:36","text":"有点众生皆苦的那种感觉"},{"number":290,"start":"00:16:36","end":"00:16:42","text":"在就是就我就是先不论这个事情的一个真假啊"},{"number":291,"start":"00:16:43","end":"00:16:52","text":"就就是我会感觉说像我在嗯帮助这个过程中啊"},{"number":292,"start":"00:16:52","end":"00:16:57","text":"就是我原本想着他们只要找到一个工作"},{"number":293,"start":"00:16:57","end":"00:17:01","text":"然后能够呃挣到一两千块钱"},{"number":294,"start":"00:17:01","end":"00:17:05","text":"能够维持的那个住宿以及吃饭"},{"number":295,"start":"00:17:05","end":"00:17:09","text":"就那这个生活就可持续下来了"},{"number":296,"start":"00:17:09","end":"00:17:14","text":"但是一旦你每一次开始有一点好转的时候"},{"number":297,"start":"00:17:14","end":"00:17:17","text":"就会有各种各样的事情"},{"number":298,"start":"00:17:17","end":"00:17:18","text":"像生病啊"},{"number":299,"start":"00:17:18","end":"00:17:22","text":"然后像像被车撞啊这种各种事情"},{"number":300,"start":"00:17:22","end":"00:17:27","text":"然后却感觉说呃很不如意"},{"number":301,"start":"00:17:27","end":"00:17:33","text":"然后感觉有点像那个余华的那个小说活着的"},{"number":302,"start":"00:17:33","end":"00:17:38","text":"但当然这个成绩很不一样呃"},{"number":303,"start":"00:17:38","end":"00:17:44","text":"就感觉呃很很难对"},{"number":304,"start":"00:17:45","end":"00:17:50","text":"当然这个是我在于我这个没有经历过太多"},{"number":305,"start":"00:17:50","end":"00:17:56","text":"这种真正困难的这个这个刚出来的那个人"},{"number":306,"start":"00:17:56","end":"00:17:58","text":"看看到了不是"},{"number":307,"start":"00:17:58","end":"00:18:02","text":"主要是你没有实力哦"},{"number":308,"start":"00:18:02","end":"00:18:05","text":"对如果你真有实力的话"},{"number":309,"start":"00:18:05","end":"00:18:08","text":"你对他们的期望是我对你的帮扶的截止动作"},{"number":310,"start":"00:18:08","end":"00:18:12","text":"叫做给你们创造了每1000块钱的收入的工作"},{"number":311,"start":"00:18:12","end":"00:18:12","text":"你真有实力"},{"number":312,"start":"00:18:12","end":"00:18:14","text":"你直接给他安排"},{"number":313,"start":"00:18:21","end":"00:18:22","text":"是的"},{"number":314,"start":"00:18:23","end":"00:18:25","text":"不过就两个方向"},{"number":315,"start":"00:18:25","end":"00:18:26","text":"你帮人的时候"},{"number":316,"start":"00:18:26","end":"00:18:28","text":"要不然你就量力而为"},{"number":317,"start":"00:18:28","end":"00:18:30","text":"这是一个方向"},{"number":318,"start":"00:18:30","end":"00:18:31","text":"是大多数人走的方向"},{"number":319,"start":"00:18:31","end":"00:18:33","text":"量力而为去帮人"},{"number":320,"start":"00:18:33","end":"00:18:35","text":"实在帮不上了"},{"number":321,"start":"00:18:35","end":"00:18:37","text":"不意味着自己做错了啥"},{"number":322,"start":"00:18:37","end":"00:18:39","text":"真实评估自己的实力"},{"number":323,"start":"00:18:39","end":"00:18:41","text":"你想给别人一桶水"},{"number":324,"start":"00:18:41","end":"00:18:43","text":"你自己的话最起码有一桶多呀"},{"number":325,"start":"00:18:43","end":"00:18:44","text":"你只有一杯"},{"number":326,"start":"00:18:44","end":"00:18:45","text":"你想给人家一桶"},{"number":327,"start":"00:18:45","end":"00:18:46","text":"你也给不了"},{"number":328,"start":"00:18:46","end":"00:18:49","text":"所以大多数人的话走的这个路径叫做量力而为"},{"number":329,"start":"00:18:49","end":"00:18:51","text":"当然还有别的路径"},{"number":330,"start":"00:18:51","end":"00:18:52","text":"我不入地狱"},{"number":331,"start":"00:18:52","end":"00:18:53","text":"谁入地狱"},{"number":332,"start":"00:18:53","end":"00:18:54","text":"你是吗"},{"number":333,"start":"00:18:54","end":"00:18:54","text":"你也不是"},{"number":334,"start":"00:19:02","end":"00:19:03","text":"嗯好的"},{"number":335,"start":"00:19:03","end":"00:19:04","text":"谢谢冰叔"},{"number":336,"start":"00:19:04","end":"00:19:05","text":"谢谢冰叔"},{"number":337,"start":"00:19:06","end":"00:19:07","text":"清晰多了"},{"number":338,"start":"00:19:08","end":"00:19:10","text":"感谢再见"},{"number":339,"start":"00:19:24","end":"00:19:27","text":"你需要去思考一个问题"},{"number":340,"start":"00:19:27","end":"00:19:30","text":"为什么每一次的话即将事情步入正轨"},{"number":341,"start":"00:19:30","end":"00:19:32","text":"突然间就车祸了"},{"number":342,"start":"00:19:32","end":"00:19:33","text":"突然间又出事了"},{"number":343,"start":"00:19:33","end":"00:19:35","text":"突然间就干满了"},{"number":344,"start":"00:19:35","end":"00:19:36","text":"我再强调一下"},{"number":345,"start":"00:19:36","end":"00:19:38","text":"若你的善行啊"},{"number":346,"start":"00:19:39","end":"00:19:41","text":"没有办法以实力匹配"},{"number":347,"start":"00:19:41","end":"00:19:44","text":"也没有办法以基本的智慧匹配的话"},{"number":348,"start":"00:19:44","end":"00:19:47","text":"这个事情可以做差不多就行了啊"}],"sameDate":[{"slug":"2026-07-10-call-01","title":"25岁失业青年资助两名15岁离家少女四千元，咨询师劝他量力而为","date":"2026-07-10","duration":"20分2秒","index":43,"callNumber":1,"rawTranscriptUrl":"/raw/2026-07-10-call-01"},{"slug":"2026-07-10-call-02","title":"45岁北京出纳被八十万贷款和出轨怀疑困住，咨询师：先找律师","date":"2026-07-10","duration":"8分42秒","index":44,"callNumber":2,"rawTranscriptUrl":"/raw/2026-07-10-call-02"},{"slug":"2026-07-10-call-03","title":"38岁体制内干部躯体化焦虑，咨询师：压力出口缺失朋友关系塌陷","date":"2026-07-10","duration":"30分38秒","index":45,"callNumber":3,"rawTranscriptUrl":"/raw/2026-07-10-call-03"},{"slug":"2026-07-10-call-04","title":"教师不满校园内卷想带孩子游学靠AI与网课自学再高考","date":"2026-07-10","duration":"1小时1分12秒","index":46,"callNumber":4,"rawTranscriptUrl":"/raw/2026-07-10-call-04"},{"slug":"2026-07-10-call-05","title":"21岁医学生守着癌晚期母亲求精神支点，咨询师：是来报恩的孩子","date":"2026-07-10","duration":"25分51秒","index":47,"callNumber":5,"rawTranscriptUrl":"/raw/2026-07-10-call-05"},{"slug":"2026-07-10-call-06","title":"小伙从小目睹家庭暴力内心缺安全感，咨询师支招讨好型人格","date":"2026-07