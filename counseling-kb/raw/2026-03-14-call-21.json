23","end":"00:08:26","text":"你不能要求我不是你们家老公来干这个队"},{"number":197,"start":"00:08:26","end":"00:08:28","text":"谢谢你行"},{"number":198,"start":"00:08:28","end":"00:08:29","text":"谢谢你"},{"number":199,"start":"00:08:29","end":"00:08:31","text":"我倒是确实是没有应该"},{"number":200,"start":"00:08:31","end":"00:08:34","text":"我只是想跟你聊聊这个问题"},{"number":201,"start":"00:08:35","end":"00:08:39","text":"聊了我已经第三次表达我的观点了"},{"number":202,"start":"00:08:39","end":"00:08:42","text":"行我我也我已经很复一下我的观点"},{"number":203,"start":"00:08:42","end":"00:08:47","text":"就是我坚信你一上来先定了这个调家庭和睦"},{"number":204,"start":"00:08:47","end":"00:08:48","text":"生活幸福"},{"number":205,"start":"00:08:48","end":"00:08:48","text":"哎"},{"number":206,"start":"00:08:48","end":"00:08:50","text":"那还要什么自行车嗯"},{"number":207,"start":"00:08:50","end":"00:08:54","text":"确实那也可以分享一下嘛"},{"number":208,"start":"00:08:54","end":"00:08:55","text":"对吧"},{"number":209,"start":"00:08:55","end":"00:08:57","text":"我觉得一上来不应该去嗯"},{"number":210,"start":"00:08:57","end":"00:09:01","text":"跟你聊天不一定是要诉苦或者有什么问题"},{"number":211,"start":"00:09:01","end":"00:09:05","text":"然后我也想说一下做的那个动作做错了没有对"},{"number":212,"start":"00:09:05","end":"00:09:07","text":"然后我也想跟你聊一下"},{"number":213,"start":"00:09:07","end":"00:09:13","text":"就是我有非常今年宝宝问我妈妈"},{"number":214,"start":"00:09:13","end":"00:09:16","text":"你2026想要什么吗"},{"number":215,"start":"00:09:16","end":"00:09:18","text":"因为宝宝现在工作还是不错哈"},{"number":216,"start":"00:09:18","end":"00:09:20","text":"然后他会问我呀"},{"number":217,"start":"00:09:20","end":"00:09:21","text":"诶你许个愿望"},{"number":218,"start":"00:09:21","end":"00:09:22","text":"妈妈啊"},{"number":219,"start":"00:09:22","end":"00:09:24","text":"爸爸给你满足"},{"number":220,"start":"00:09:24","end":"00:09:26","text":"我忽然想不出我有什么愿望"},{"number":221,"start":"00:09:26","end":"00:09:27","text":"我觉得我现在挺好"},{"number":222,"start":"00:09:27","end":"00:09:30","text":"然后每天早上起来阳光透进来的时候"},{"number":223,"start":"00:09:30","end":"00:09:32","text":"我就觉得很幸福"},{"number":224,"start":"00:09:32","end":"00:09:34","text":"就是我我身体的感知"},{"number":225,"start":"00:09:34","end":"00:09:37","text":"它有呃那种幸福感"},{"number":226,"start":"00:09:37","end":"00:09:39","text":"所以还是挺好的"},{"number":227,"start":"00:09:39","end":"00:09:41","text":"也没有什么特别不好的事情"},{"number":228,"start":"00:09:41","end":"00:09:42","text":"就是因为这个事情"},{"number":229,"start":"00:09:42","end":"00:09:44","text":"这个话我有点纠结而已"},{"number":230,"start":"00:09:44","end":"00:09:46","text":"提了一嘴呃"},{"number":231,"start":"00:09:46","end":"00:09:50","text":"但是确实也像你说的没有啊"},{"number":232,"start":"00:09:50","end":"00:09:51","text":"不是特别大的事情"},{"number":233,"start":"00:09:51","end":"00:09:55","text":"但是呃还是跟你连上麦了"},{"number":234,"start":"00:09:55","end":"00:09:59","text":"我还是要强调这一点嗯"},{"number":235,"start":"00:09:59","end":"00:10:03","text":"那我所有的不快乐和小烦恼也会一扫而空啊"},{"number":236,"start":"00:10:03","end":"00:10:06","text":"所以也很感谢你呀"},{"number":237,"start":"00:10:06","end":"00:10:11","text":"然后嗯我看一下"},{"number":238,"start":"00:10:12","end":"00:10:13","text":"唉也没有什么了"},{"number":239,"start":"00:10:13","end":"00:10:15","text":"就还有一个呃"},{"number":240,"start":"00:10:15","end":"00:10:20","text":"关于就是前面有宝宝说跟父母的相处"},{"number":241,"start":"00:10:20","end":"00:10:25","text":"其实这一点我其实也是蛮有困惑的嗯"},{"number":242,"start":"00:10:26","end":"00:10:27","text":"算吧"},{"number":243,"start":"00:10:27","end":"00:10:31","text":"嘿嘿我觉得下面的真的"},{"number":244,"start":"00:10:31","end":"00:10:36","text":"我没有你们说的这个老太婆好了"},{"number":245,"start":"00:10:36","end":"00:10:38","text":"大兵我就说到这里了"},{"number":246,"start":"00:10:38","end":"00:10:40","text":"其实也不是没事找事"},{"number":247,"start":"00:10:40","end":"00:10:43","text":"就是聊聊天嘛对吧"},{"number":248,"start":"00:10:44","end":"00:10:46","text":"聊天有聊天的聊法"},{"number":249,"start":"00:10:46","end":"00:10:48","text":"因为其他人上来聊天"},{"number":250,"start":"00:10:48","end":"00:10:52","text":"人家不是非得硬找出来一个话题或者是干嘛"},{"number":251,"start":"00:10:52","end":"00:10:52","text":"好吧"},{"number":252,"start":"00:10:52","end":"00:10:54","text":"你完全可以连上麦找我聊聊"},{"number":253,"start":"00:10:54","end":"00:10:56","text":"吃的喝的天气都行"},{"number":254,"start":"00:10:56","end":"00:10:57","text":"那更轻松了"},{"number":255,"start":"00:10:57","end":"00:10:59","text":"不是嗯好嘞"},{"number":256,"start":"00:10:59","end":"00:11:02","text":"拜拜好的拜拜"}],"sameDate":[{"slug":"2026-03-14-call-01","title":"36岁单身女问人生意义，咨询师说当下即最好","date":"2026-03-14","duration":"30分22秒","index":735,"callNumber":1,"rawTranscriptUrl":"/raw/2026-03-14-call-01"},{"slug":"2026-03-14-call-02","title":"内耗音乐老师想通过助人修心，冰哥建议意识层面加强","date":"2026-03-14","duration":"8分26秒","index":736,"callNumber":2,"rawTranscriptUrl":"/raw/2026-03-14-call-02"},{"slug":"2026-03-14-call-05","title":"21岁毕业生照顾病父无法工作，咨询师追问医保低保","date":"2026-03-14","duration":"9分12秒","index":737,"callNumber":5,"rawTranscriptUrl":""},{"slug":"2026-03-14-call-07","title":"咨询师闲聊13分钟解释夏天停播缘由原来和ai有关","date":"2026-03-14","duration":"13分18秒","index":738,"callNumber":7,"rawTranscriptUrl":"/raw/2026-03-14-call-07"},{"slug":"2026-03-14-call-10","title":"28岁失业+双相崩溃，咨询师：先走对的路，比安慰重要","date":"2026-03-14","duration":"15分1秒","index":739,"callNumber":10,"rawTranscriptUrl":"/raw/2026-03-14-call-10"},{"slug":"2026-03-14-call-11","title":"爱读书观众连麦求书单遭婉拒，追问轮回因果被咨询师直接破象：没有下一世，把这辈子活好就行","date":"2026-03-14","duration":"7分51秒","index":740,"callNumber":11,"rawTranscriptUrl":"/raw/2026-03-14-call-11"},{"slug":"2026-03-14-call-17","title":"25岁医学女研究生，学业未完便焦虑省考失利和异地婚嫁两头烧，咨询师直判：你还是个孩子","date":"2026-03-14","duration":"21分29秒","index":741,"callNumber":17,"rawTranscriptUrl":"/raw/2026-03-14-call-17"},{"slug":"2026-03-14-call-19","title":"28岁投标从业者拿三万赔偿离职，搬出六条变现路径信心满满要创业，咨询师直言商业模式跑不通","date":"2026-03-14","duration":"9分18秒","index":742,"callNumber":19,"rawTranscriptUrl":"/raw/2026-03-14-call-19"},{"slug":"2026-03-14-call-20","title":"沪漂40岁父亲与妻分居8月几乎见不到双胞胎女儿，咨询师直言无破局点，劝他走法律途径争探视权","date":"2026-03-14","duration":"9分57秒","index":743,"callNumber":20,"rawTranscriptUrl":"/raw/2026-03-14-call-20"},{"slug":"2026-03-14-call-21","title":"55岁上海女性因三弟啃老与丈夫起摩擦，反复追