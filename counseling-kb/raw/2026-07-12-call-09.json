rt":"00:23:44","end":"00:23:45","text":"服务行业嘛"},{"number":614,"start":"00:23:45","end":"00:23:47","text":"我们又没有说纯技术工种"},{"number":615,"start":"00:23:47","end":"00:23:48","text":"因为很大的可能性"},{"number":616,"start":"00:23:48","end":"00:23:49","text":"现在让他学也学不进去了"},{"number":617,"start":"00:23:49","end":"00:23:55","text":"跟服务行业相关的偏技术项的有啥好不好"},{"number":618,"start":"00:23:55","end":"00:23:58","text":"好明白诶好嘞"},{"number":619,"start":"00:23:58","end":"00:24:00","text":"嗯明白"},{"number":620,"start":"00:24:00","end":"00:24:04","text":"后来我还是得督促他自己去选"},{"number":621,"start":"00:24:04","end":"00:24:07","text":"我确实确实管太多了"},{"number":622,"start":"00:24:07","end":"00:24:10","text":"可能有时候好嘞"},{"number":623,"start":"00:24:10","end":"00:24:11","text":"还有别的问题吗"},{"number":624,"start":"00:24:12","end":"00:24:13","text":"嗯没有了"},{"number":625,"start":"00:24:13","end":"00:24:14","text":"谢谢斌哥嗯"}],"sameDate":[{"slug":"2026-07-12-call-01","title":"博士在央企AI研发两年频繁换岗，回杭读博士后还是闯私企大厂","date":"2026-07-12","duration":"9分1秒","index":29,"callNumber":1,"rawTranscriptUrl":"/raw/2026-07-12-call-01"},{"slug":"2026-07-12-call-02","title":"老师的儿子在家懂事，在校频繁与同学老师冲突，咨询师：方向反了","date":"2026-07-12","duration":"22分50秒","index":30,"callNumber":2,"rawTranscriptUrl":"/raw/2026-07-12-call-02"},{"slug":"2026-07-12-call-03","title":"57岁父亲因儿子抑郁休学求助，咨询师警示和睦家庭才是康复根本","date":"2026-07-12","duration":"18分54秒","index":31,"callNumber":3,"rawTranscriptUrl":"/raw/2026-07-12-call-03"},{"slug":"2026-07-12-call-04","title":"17岁男生从小被家暴中专退学工作一日就辞，咨询师说路不止一条","date":"2026-07-12","duration":"19分44秒","index":32,"callNumber":4,"rawTranscriptUrl":"/raw/2026-07-12-call-04"},{"slug":"2026-07-12-call-05","title":"农村19岁大学生孤僻没朋友初恋分手，咨询师：你只是晚熟","date":"2026-07-12","duration":"21分22秒","index":33,"callNumber":5,"rawTranscriptUrl":"/raw/2026-07-12-call-05"},{"slug":"2026-07-12-call-06","title":"35岁残疾女子网恋订婚出分歧拉扯一年，咨询师：勉强换不来好结局","date":"2026-07-12","duration":"17分8秒","index":34,"callNumber":6,"rawTranscriptUrl":"/raw/2026-07-12-call-06"},{"slug":"2026-07-12