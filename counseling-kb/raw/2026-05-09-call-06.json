,{"number":281,"start":"00:11:25","end":"00:11:28","text":"对你又产生了适时的语言攻击"},{"number":282,"start":"00:11:28","end":"00:11:30","text":"乃至于出去乱讲乱说"},{"number":283,"start":"00:11:30","end":"00:11:31","text":"对外攻击"},{"number":284,"start":"00:11:31","end":"00:11:33","text":"你并不需要你来含屈抱辱"},{"number":285,"start":"00:11:33","end":"00:11:36","text":"以牺牲自我的这个心态及姿态"},{"number":286,"start":"00:11:36","end":"00:11:38","text":"来所谓的加引号"},{"number":287,"start":"00:11:38","end":"00:11:39","text":"而对他好"},{"number":288,"start":"00:11:39","end":"00:11:40","text":"这个东西就不科学了"},{"number":289,"start":"00:11:40","end":"00:11:43","text":"所以钱到位了就行"},{"number":290,"start":"00:11:43","end":"00:11:45","text":"基本的赡养费用能到位了啊"},{"number":291,"start":"00:11:45","end":"00:11:46","text":"这方面的就行"},{"number":292,"start":"00:11:46","end":"00:11:46","text":"这是第一"},{"number":293,"start":"00:11:46","end":"00:11:47","text":"我能告诉你"},{"number":294,"start":"00:11:47","end":"00:11:49","text":"第二一个各出各的"},{"number":295,"start":"00:11:49","end":"00:11:50","text":"你跟你婆婆就处成这样就行"},{"number":296,"start":"00:11:50","end":"00:11:53","text":"甚至沟通交流接触也不需要太多"},{"number":297,"start":"00:11:53","end":"00:11:56","text":"孩子们如果跟他的奶奶有他的正常的互动"},{"number":298,"start":"00:11:56","end":"00:11:57","text":"那是孩子们和奶奶之间的关系"},{"number":299,"start":"00:11:57","end":"00:11:58","text":"和你没什么问题"},{"number":300,"start":"00:11:58","end":"00:11:59","text":"没什么关系"},{"number":301,"start":"00:11:59","end":"00:12:00","text":"就这么简单"},{"number":302,"start":"00:12:00","end":"00:12:01","text":"一道题听得懂吗"},{"number":303,"start":"00:12:01","end":"00:12:03","text":"我再重复一下啊"},{"number":304,"start":"00:12:03","end":"00:12:03","text":"我担心你听不懂"},{"number":305,"start":"00:12:03","end":"00:12:05","text":"你是个很迟钝的人"},{"number":306,"start":"00:12:05","end":"00:12:09","text":"你留给丈夫的承诺叫做在你能力范围之内"},{"number":307,"start":"00:12:09","end":"00:12:10","text":"尽量对她妈妈好"},{"number":308,"start":"00:12:10","end":"00:12:13","text":"而并不是无条件的以牺牲自我"},{"number":309,"start":"00:12:13","end":"00:12:16","text":"委屈自己来对他妈妈好好吗"},{"number":310,"start":"00:12:16","end":"00:12:19","text":"你留给他的承诺不是这个承诺"},{"number":311,"start":"00:12:22","end":"00:12:24","text":"嗯嗯听懂了吗"},{"number":312,"start":"00:12:24","end":"00:12:24","text":"知道了"},{"number":313,"start":"00:12:24","end":"00:12:26","text":"你明白了"},{"number":314,"start":"00:12:26","end":"00:12:30","text":"你就我之前一直就自己心里好像没放得下"},{"number":315,"start":"00:12:30","end":"00:12:32","text":"然后有时候想起来的话"},{"number":316,"start":"00:12:32","end":"00:12:35","text":"还感觉别给我来讲你的情绪那种"},{"number":317,"start":"00:12:35","end":"00:12:37","text":"我就问你听不听得懂"},{"number":318,"start":"00:12:37","end":"00:12:38","text":"不必在这陈述你的情绪"},{"number":319,"start":"00:12:38","end":"00:12:40","text":"明白了明白了"},{"number":320,"start":"00:12:40","end":"00:12:40","text":"嗯嗯好嘞"},{"number":321,"start":"00:12:40","end":"00:12:41","text":"好好再见"},{"number":322,"start":"00:12:42","end":"00:12:43","text":"嗯好"},{"number":323,"start":"00:12:43","end":"00:12:44","text":"谢谢斌哥"},{"number":324,"start":"00:12:44","end":"00:12:45","text":"客气"},{"number":325,"start":"00:12:50","end":"00:12:53","text":"当你被某一个承诺所绑架的时候"},{"number":326,"start":"00:12:53","end":"00:12:56","text":"没有办法来逾越一个自我设立的这样的一个"},{"number":327,"start":"00:12:56","end":"00:12:58","text":"道德的高峰的时候吧"},{"number":328,"start":"00:12:58","end":"00:13:00","text":"你先来问问自己"},{"number":329,"start":"00:13:00","end":"00:13:04","text":"这个你对这个承诺的解读事求出现了偏差"},{"number":330,"start":"00:13:04","end":"00:13:06","text":"哎这是我想告诉他的"},{"number":331,"start":"00:13:06","end":"00:13:08","text":"也是咱们直播间很多的朋友的话"},{"number":332,"start":"00:13:08","end":"00:13:09","text":"我没有资格给你们上课"},{"number":333,"start":"00:13:09","end":"00:13:11","text":"咱们来分享的一句话"},{"number":334,"start":"00:13:11","end":"00:13:13","text":"我们有时候很容易被一个念头"},{"number":335,"start":"00:13:13","end":"00:13:15","text":"甚至被某一种道德"},{"number":336,"start":"00:13:15","end":"00:13:16","text":"甚至被某一次承诺"},{"number":337,"start":"00:13:16","end":"00:13:17","text":"然后给绑架了"},{"number":338,"start":"00:13:17","end":"00:13:18","text":"自我绑架住了"},{"number":339,"start":"00:13:18","end":"00:13:20","text":"当你判断自己被绑架住了"},{"number":340,"start":"00:13:20","end":"00:13:21","text":"陷入了一个泥脑"},{"number":341,"start":"00:13:21","end":"00:13:26","text":"然后到了一种这个很难受的一种状态的时候"},{"number":342,"start":"00:13:26","end":"00:13:28","text":"麻烦你先反观回照"},{"number":343,"start":"00:13:28","end":"00:13:30","text":"先来审视一下你对这个承诺的解读"},{"number":344,"start":"00:13:30","end":"00:13:31","text":"是否出现了问题"},{"number":345,"start":"00:13:31","end":"00:13:33","text":"你的动作是否有变形"},{"number":346,"start":"00:13:33","end":"00:13:36","text":"往往的话因为这块出现了问题"}],"sameDate":[{"slug":"2026-05-09-call-01","title":"研二秋招还是外派去孔子学院？咨询师直言：别求最优解","date":"2026-05-09","duration":"22分12秒","index":409,"callNumber":1,"rawTranscriptUrl":"/raw/2026-05-09-call-01"},{"slug":"2026-05-09-call-02","title":"19岁青年问提升学历重要吗，咨询师：学历本质是入场券，真正的台面是别的","date":"2026-05-09","duration":"14分3秒","index":410,"callNumber":2,"rawTranscriptUrl":"/raw/2026-05-09-call-02"},{"slug":"2026-05-09-call-03","title":"61岁退休药师考心理证想从业，咨询师指路：做倾听师","date":"2026-05-09","duration":"12分37秒","index":411,"callNumber":3,"rawTranscriptUrl":"/raw/2026-05-09-call-03"},{"slug":"2026-05-09-call-04","title":"8岁儿童多领域超常天赋引妈妈焦虑，咨询师现场与孩子交流","date":"2026-05-09","duration":"25分30秒","index":412,"callNumber":4,"rawTranscriptUrl":"/raw/2026-05-09-call-04"},{"slug":"2026-05-09-call-05","title":"30岁大厂夫妇纠结在哪定居，咨询师戳破城市选择本质","date":"2026-05-09","duration":"25分57秒","index":413,"callNumber":5,"rawTranscriptUrl":"/raw/2026-05-09-call-05"},{"slug":"2026-05-09-call-06","title":"中年单亲妈妈八年报恩不知如何开口，咨询师：心意细水长流莫强求","date":"2026-05-09","duration":"13分35秒","index":414,"callNumber":6,"rawTranscriptUrl":"/raw/2026-05-09-call-06"},{"slug":"2026-05-09-call-07","title":"带57岁母亲和4岁女儿规划三代旅行，咨询师：我脑子里有一整本中国地图","date":"2026-05-09","duration":"12分6秒","index":415,"callNumber":7,"rawTranscriptUrl":"/raw/2026-05-09-call-07"},{"slug":"2026-05-09-call-08","title":"28岁女孩在职场反复被误解 咨询师：童年缺乏人际边界训练","date":"