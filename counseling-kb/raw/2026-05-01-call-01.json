9","end":"00:02:50","text":"咱俩不掰扯了"},{"number":85,"start":"00:02:50","end":"00:02:51","text":"你有什么事找我"},{"number":86,"start":"00:02:51","end":"00:02:53","text":"你直接说哦"},{"number":87,"start":"00:02:53","end":"00:02:55","text":"就是我呃今年大四"},{"number":88,"start":"00:02:55","end":"00:02:57","text":"然后目前在西安上学嗯"},{"number":89,"start":"00:02:57","end":"00:03:00","text":"我主要的问题就是说我跟人聊天的时候"},{"number":90,"start":"00:03:00","end":"00:03:01","text":"容易特别紧张"},{"number":91,"start":"00:03:01","end":"00:03:04","text":"如果说是呃比我年龄大的"},{"number":92,"start":"00:03:04","end":"00:03:07","text":"比如说像老师这样的嗯"},{"number":93,"start":"00:03:07","end":"00:03:10","text":"如线上线上发消息我也会很紧张"},{"number":94,"start":"00:03:10","end":"00:03:12","text":"比如说发一个消息"},{"number":95,"start":"00:03:12","end":"00:03:16","text":"我甚至要在文件传输助手里面排练好几次"},{"number":96,"start":"00:03:17","end":"00:03:20","text":"如果是同龄人的话"},{"number":97,"start":"00:03:20","end":"00:03:23","text":"我看到他们也会很紧张"},{"number":98,"start":"00:03:23","end":"00:03:25","text":"就不知道说什么好"},{"number":99,"start":"00:03:25","end":"00:03:27","text":"你问问看我说的对不对啊"},{"number":100,"start":"00:03:27","end":"00:03:30","text":"A叫做你妈妈很厉害"},{"number":101,"start":"00:03:30","end":"00:03:34","text":"B你有可能很怕你爹是A还是B呀"},{"number":102,"start":"00:03:34","end":"00:03:36","text":"AA是吧哈"},{"number":103,"start":"00:03:36","end":"00:03:36","text":"好嘞"},{"number":104,"start":"00:03:36","end":"00:03:37","text":"不怪你啊"},{"number":105,"start":"00:03:37","end":"00:03:38","text":"怪你妈"},{"number":106,"start":"00:03:38","end":"00:03:40","text":"一般妈特别厉害"},{"number":107,"start":"00:03:40","end":"00:03:41","text":"养出来的孩子"},{"number":108,"start":"00:03:41","end":"00:03:43","text":"尤其是姑娘容易出现这种情况啊"},{"number":109,"start":"00:03:43","end":"00:03:45","text":"那现在接下来你需要来告诉我"},{"number":110,"start":"00:03:45","end":"00:03:49","text":"你和你爹的关系怎么样哦"},{"number":111,"start":"00:03:49","end":"00:03:52","text":"我如果有什么心理上的一些事情的话"},{"number":112,"start":"00:03:52","end":"00:03:53","text":"我基本上都不会瞒"},{"numb