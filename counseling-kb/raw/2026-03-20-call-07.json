art":"00:24:55","end":"00:25:00","text":"他需要替你来担一部分的呃"},{"number":620,"start":"00:25:00","end":"00:25:01","text":"孩子的沟通交流"},{"number":621,"start":"00:25:01","end":"00:25:03","text":"甚至是陪伴动作"},{"number":622,"start":"00:25:03","end":"00:25:05","text":"比如孩子周末去新华书店"},{"number":623,"start":"00:25:05","end":"00:25:08","text":"他如果有可能陪着孩子去"},{"number":624,"start":"00:25:08","end":"00:25:10","text":"他需要替你来分摊"},{"number":625,"start":"00:25:10","end":"00:25:13","text":"不小一定比例的跟孩子的相处"},{"number":626,"start":"00:25:13","end":"00:25:17","text":"陪伴陪同这样的一些动作行嗯"},{"number":627,"start":"00:25:19","end":"00:25:21","text":"嗯因为你这个的话要是这么说的话"},{"number":628,"start":"00:25:21","end":"00:25:24","text":"听起来就不像是光是一个预期值了"},{"number":629,"start":"00:25:24","end":"00:25:27","text":"因为如果说是预期值过高的话"},{"number":630,"start":"00:25:27","end":"00:25:30","text":"你是不会允许他周末还允许的"},{"number":631,"start":"00:25:30","end":"00:25:32","text":"青蛙书店自由看书的"},{"number":632,"start":"00:25:32","end":"00:25:34","text":"这是一个显性信号"},{"number":633,"start":"00:25:34","end":"00:25:34","text":"好了"},{"number":634,"start":"00:25:34","end":"00:25:36","text":"主要你老公需要调整啊"},{"number":635,"start":"00:25:36","end":"00:25:36","text":"好嘞"},{"number":636,"start":"00:25:36","end":"00:25:37","text":"我们聊到这吧"},{"number":637,"start":"00:25:37","end":"00:25:39","text":"拜拜行嗯"},{"number":638,"start":"00:25:39","end":"00:25:41","text":"好谢谢斌哥"},{"number":639,"start":"00:25:41","end":"00:25:42","text":"好好的谢谢"},{"number":640,"start":"00:25:42","end":"00:25:43","text":"非常感谢啊"},{"number":641,"start":"00:25:43","end":"00:25:45","text":"没事嗯"},{"number":642,"start":"00:25:46","end":"00:25:47","text":"当然我也有我的判断偏差"},{"number":643,"start":"00:25:47","end":"00:25:50","text":"一开始我上来问你老公是不是经常不着家啊"},{"number":644,"start":"00:25:50","end":"00:25:51","text":"着架着家"},{"number":645,"start":"00:25:51","end":"00:25:52","text":"那就是不搭理孩子"}],"sameDate":[{"slug":"2026-03-20-call-01","title":"初一女生被传坏话太敏感，咨询师点破家庭影响根源","date":"2026-03-20","duration":"25分48秒","index":709,"ca