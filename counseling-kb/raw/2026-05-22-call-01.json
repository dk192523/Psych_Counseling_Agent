:07:46","text":"你如果希望别人喜欢你"},{"number":196,"start":"00:07:46","end":"00:07:47","text":"你先喜欢别人"},{"number":197,"start":"00:07:47","end":"00:07:49","text":"在你没开口说话之前"},{"number":198,"start":"00:07:49","end":"00:07:50","text":"先对称你的礼貌和友好"},{"number":199,"start":"00:07:50","end":"00:07:52","text":"你在心里边可以先告诉自己"},{"number":200,"start":"00:07:52","end":"00:07:53","text":"我很想和他交朋友"},{"number":201,"start":"00:07:53","end":"00:07:56","text":"我要努力发现他身上的闪光点"},{"number":202,"start":"00:07:56","end":"00:07:58","text":"如果你自始至终啊"},{"number":203,"start":"00:07:58","end":"00:07:59","text":"或者刚接触的时候"},{"number":204,"start":"00:07:59","end":"00:08:00","text":"一直抱有这样的一种想法"},{"number":205,"start":"00:08:00","end":"00:08:02","text":"对方是可感知到的"},{"number":206,"start":"00:08:02","end":"00:08:04","text":"因为有个东西叫做直觉啊"},{"number":207,"start":"00:08:06","end":"00:08:08","text":"嗯好的嗯"},{"number":208,"start":"00:08:08","end":"00:08:14","text":"然后接下来还有一个嗯还有一个问题嗯"},{"number":209,"start":"00:08:17","end":"00:08:19","text":"稍等一下"},{"number":210,"start":"00:08:26","end":"00:08:31","text":"嗯嗯就是嗯其实也是同一个类型的问题"},{"number":211,"start":"00:08:31","end":"00:08:33","text":"就是在学校压力比较大"},{"number":212,"start":"00:08:33","end":"00:08:38","text":"整天会思考一些非常嗯非常不值得思考的问题"},{"number":213,"start":"00:08:38","end":"00:08:41","text":"比如说老师点我名会不会回答不上来"},{"number":214,"start":"00:08:41","end":"00:08:43","text":"然后就是类似这样的"},{"number":215,"start":"00:08:43","end":"00:08:47","text":"我就在想要不要在学校下一个学期"},{"number":216,"start":"00:08:47","end":"00:08:48","text":"变成一个嗯"},{"number":217,"start":"00:08:48","end":"00:08:53","text":"变成一个比较嗯比较调皮的一个人设"},{"number":218,"start":"00:08:53","end":"00:08:54","text":"多犯点错误"},{"number":219,"start":"00:08:55","end":"00:08:59","text":"你这个问题感性回答了你了"},{"number":220,"start":"00:08:59","end":"00:09:02","text":"你回想一下我怎么回答你的第一个问题"},{"number":221,"start":"00:09:03","end":"00:09:06","text":"你现在就是把这个场域太当回事了"},{"number":222,"start":"00:09:06","end":"00:09:08","text":"你认为这个东西意味着现在去上学"},{"number":223,"start":"00:09:08","end":"00:09:10","text":"去到回到你的这个中学"},{"number":224,"start":"00:09:10","end":"00:09:11","text":"对你而言"},{"number":225,"start":"00:09:11","end":"00:09:14","text":"就像是意味着你正式闯荡江湖"},{"number":226,"start":"00:09:14","end":"00:09:15","text":"闯荡世界一样"},{"number":227,"start":"00:09:15","end":"00:09:15","text":"它不是的"},{"number":228,"start":"00:09:15","end":"00:09:17","text":"他就是个排练厅"},{"number":229,"start":"00:09:17","end":"00:09:18","text":"就是一个训练场"},{"number":230,"start":"00:09:18","end":"00:09:20","text":"他无所谓的一个东西"},{"number":231,"start":"00:09:20","end":"00:09:23","text":"它是一个模拟态的一种社交场域"},{"number":232,"start":"00:09:23","end":"00:09:24","text":"在里边所有的人际关系"},{"number":233,"start":"00:09:24","end":"00:09:25","text":"你和同学之间"},{"number":234,"start":"00:09:25","end":"00:09:26","text":"你和老师之间"},{"number":235,"start":"00:09:26","end":"00:09:30","text":"3年之后有可能里边99%的人"},{"number":236,"start":"00:09:30","end":"00:09:32","text":"你这一辈子也见不着了"},{"number":237,"start":"00:09:32","end":"00:09:35","text":"你不要把它太当回事儿好不好"},{"number":238,"start":"00:09:35","end":"00:09:38","text":"就是你太把这个东西当真了"},{"number":239,"start":"00:09:38","end":"00:09:42","text":"嗯我可以把它归结于是我太敏感了吗"},{"number":240,"start":"00:09:42","end":"00:09:44","text":"还是说读的书太少"},{"number":241,"start":"00:09:44","end":"00:09:45","text":"认知不够"},{"number":242,"start":"00:09:45","end":"00:09:47","text":"这个跟认知没什么关系"},{"number":243,"start":"00:09:47","end":"00:09:49","text":"就是你的世界太小"},{"number":244,"start":"00:09:49","end":"00:09:50","text":"世界太小了之后"},{"number":245,"start":"00:09:50","end":"00:09:53","text":"就会把你有限可触碰的这个世界"},{"number":246,"start":"00:09:53","end":"00:09:54","text":"看得无比的重要"},{"number":247,"start":"00:09:54","end":"00:09:56","text":"这就好比一个人的兜里边的话"},{"number":248,"start":"00:09:56","end":"00:09:57","text":"只有那15块钱"},{"number":249,"start":"00:09:57","end":"00:10:01","text":"他会把每一毛钱都看得非常重要一样嗯"},{"number":250,"start":"00:10:03","end":"00:10:04","text":"而事实上"},{"number":251,"start":"00:10:04","end":"00:10:06","text