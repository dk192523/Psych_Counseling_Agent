7","end":"00:17:39","text":"说完了吗"},{"number":370,"start":"00:17:45","end":"00:17:47","text":"还没有好"},{"number":371,"start":"00:17:47","end":"00:17:48","text":"接着说"},{"number":372,"start":"00:18:00","end":"00:18:02","text":"还是书读少了"},{"number":373,"start":"00:18:02","end":"00:18:04","text":"我现在很后悔当初没努力读书"},{"number":374,"start":"00:18:04","end":"00:18:05","text":"我们不在"},{"number":375,"start":"00:18:05","end":"00:18:06","text":"现在还来得及吗"},{"number":376,"start":"00:18:06","end":"00:18:09","text":"笔试我们不在乎你书读的多还是少"},{"number":377,"start":"00:18:09","end":"00:18:12","text":"我们只在乎你接下来怎么做"},{"number":378,"start":"00:18:15","end":"00:18:19","text":"我现在重新开始读书还来得及吗"},{"number":379,"start":"00:18:19","end":"00:18:22","text":"如果你现在重新学东西"},{"number":380,"start":"00:18:22","end":"00:18:26","text":"尤其是学专业技术类的东西来得及"},{"number":381,"start":"00:18:45","end":"00:18:47","text":"并说能不能帮帮我"},{"number":382,"start":"00:18:47","end":"00:18:50","text":"不能不要勉强任何人"},{"number":383,"start":"00:18:52","end":"00:18:53","text":"应该帮和合适帮的"},{"number":384,"start":"00:18:53","end":"00:18:54","text":"我一定会帮你"},{"number":385,"start":"00:18:54","end":"00:18:56","text":"不属于"},{"number":386,"start":"00:18:59","end":"00:19:01","text":"为什么"},{"number":387,"start":"00:19:02","end":"00:19:03","text":"呃不存在"},{"number":388,"start":"00:19:03","end":"00:19:04","text":"说是我拒绝你"},{"number":389,"start":"00:19:04","end":"00:19:06","text":"我还必须要向你解释呀"},{"number":390,"start":"00:19:07","end":"00:19:09","text":"为什么我要向你解释"},{"number":391,"start":"00:19:10","end":"00:19:11","text":"抱歉"},{"number":392,"start":"00:19:11","end":"00:19:12","text":"我强人所难"},{"number":393,"start":"00:19:12","end":"00:19:14","text":"对"},{"number":394,"start":"00:19:20","end":"00:19:26","text":"我去图书馆借了你的那个作品来看"},{"number":395,"start":"00:19:26","end":"00:19:27","text":"不必道德绑架"},{"number":396,"start":"00:19:27","end":"00:19:29","text":"是这会儿如果来增添这个信息的话"},{"number":397,"start":"00:19:29","end":"00:19:32","text":"等于是某种意义上的软性道德绑架了"},{"number":398,"start":"00:19