06:45","end":"00:06:48","text":"但是如果您家里边只有这一个馒头"},{"number":140,"start":"00:06:48","end":"00:06:51","text":"您会特别在乎这一个馒头"},{"number":141,"start":"00:06:55","end":"00:06:57","text":"明白了"},{"number":142,"start":"00:07:12","end":"00:07:15","text":"可能我对自己的性格定位不是很清晰"},{"number":143,"start":"00:07:15","end":"00:07:17","text":"我一直以为自己是那种大大咧咧"},{"number":144,"start":"00:07:17","end":"00:07:19","text":"不在乎的"},{"number":145,"start":"00:07:21","end":"00:07:24","text":"根据您刚才反复按着同一个话题"},{"number":146,"start":"00:07:24","end":"00:07:27","text":"不停的来做不同形式的重复"},{"number":147,"start":"00:07:27","end":"00:07:29","text":"我想直接告诉您"},{"number":148,"start":"00:07:29","end":"00:07:31","text":"有可能您连麦啊"},{"number":149,"start":"00:07:31","end":"00:07:32","text":"包括您跟我讲话"},{"number":150,"start":"00:07:32","end":"00:07:36","text":"由您的潜意识需求是需要被关注"},{"number":151,"start":"00:07:36","end":"00:07:38","text":"尤其是主要关注您的内在"},{"number":152,"start":"00:07:38","end":"00:07:40","text":"尤其是您的情感波动"},{"number":153,"start":"00:07:40","end":"00:07:42","text":"这一切的话再往下挖"},{"number":154,"start":"00:07:42","end":"00:07:44","text":"叫做希望被看见"},{"number":155,"start":"00:07:44","end":"00:07:46","text":"希望情绪被承载"},{"number":156,"start":"00:07:46","end":"00:07:47","text":"甚至被主动抚慰"},{"number":157,"start":"00:07:47","end":"00:07:48","text":"那我能告诉您"},{"number":158,"start":"00:07:48","end":"00:07:53","text":"我们直播间主要帮忙的叫做问题的梳理好吗"},{"number":159,"start":"00:07:55","end":"00:07:57","text":"明白了"},{"number":160,"start":"00:07:58","end":"00:07:59","text":"或者说的直接一点儿"},{"number":161,"start":"00:07:59","end":"00:08:05","text":"就是您更希望我来关注您这个人本身"},{"number":162,"start":"00:08:06","end":"00:08:09","text":"而不是您所说的这件事儿"},{"number":163,"start":"00:08:10","end":"00:08:14","text":"您更希望的是能够通过我和您的交互"},{"number":164,"start":"00:08:14","end":"00:08:18","text":"让您有机会多来阐述以及描述自己细腻的内心"},{"number":165,"start":"00:08:18","end":"00:08:20","text":"以及具体的感觉"},{"number":166,"start":"00:08:20","end":"00:08:22","text":"感知感受呃"},{"number":167,"start":"00:08:22","end":"00:08:24","text":"可是我认为那个东西并不解决您的问题"},{"number":168,"start":"00:08:24","end":"00:08:25","text":"在我们这儿的话"},{"number":169,"start":"00:08:25","end":"00:08:27","text":"当您提出了一个事件或者是现象"},{"number":170,"start":"00:08:27","end":"00:08:30","text":"我们主要帮您来梳理这个事儿好吗"},{"number":171,"start":"00:08:35","end":"00:08:37","text":"老师这是您看到我的潜意识吗"},{"number":172,"start":"00:08:39","end":"00:08:40","text":"我看不到你的潜意识"},{"number":173,"start":"00:08:40","end":"00:08:42","text":"但是我可以根据啊"},{"number":174,"start":"00:08:42","end":"00:08:43","text":"您的行为"},{"number":175,"start":"00:08:43","end":"00:08:45","text":"也就是咱们交互啊"},{"number":176,"start":"00:08:45","end":"00:08:46","text":"语言交互的过程当中"},{"number":177,"start":"00:08:46","end":"00:08:49","text":"我来捕捉一些信号"},{"number":178,"start":"00:08:53","end":"00:08:55","text":"因为我在连麦的时候"},{"number":179,"start":"00:08:55","end":"00:08:56","text":"我的初衷"},{"number":180,"start":"00:08:56","end":"00:08:59","text":"我脑子里面一直想的是"},{"number":181,"start":"00:08:59","end":"00:09:01","text":"就是过往的这几段关系里面"},{"number":182,"start":"00:09:01","end":"00:09:04","text":"每一段关系的这种分离"},{"number":183,"start":"00:09:04","end":"00:09:08","text":"为什么我始终是就是"},{"number":184,"start":"00:09:10","end":"00:09:12","text":"出就是出群聊的那一个人"},{"number":185,"start":"00:09:12","end":"00:09:14","text":"我想知道这个原因"},{"number":186,"start":"00:09:14","end":"00:09:17","text":"就是或者是大家太过于关注"},{"number":187,"start":"00:09:17","end":"00:09:18","text":"而你太过于关注"},{"number":188,"start":"00:09:18","end":"00:09:21","text":"是因为太少了"},{"number":189,"start":"00:09:26","end":"00:09:27","text":"明白了"},{"number":190,"start":"00:09:27","end":"00:09:30","text":"可能因为我这个圈子确实比较闭塞"},{"number":191,"start":"00:09:31","end":"00:09:36","text":"我们等于这是说第六遍了这个问题的原因"},{"number":192,"start":"00:09:39","end":"00:09:39","text":"好的好的"},{"number":193,"start":"00:09:39","end":"00:09:40","text":"我明白了"},{"number":194,"start":"00:09:40","end":"00:09:41","text":"谢谢你"},{"number":195,"start":"00:09:42","end":"00:09:45","text":"好的再见嗯"}],