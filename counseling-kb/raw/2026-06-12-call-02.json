00:00:57","end":"00:01:00","text":"就是我没有成功的转出这个专业"},{"number":26,"start":"00:01:00","end":"00:01:02","text":"在这个挫折之后"},{"number":27,"start":"00:01:02","end":"00:01:06","text":"我其实在当时陷入了非常严重的情绪障碍"},{"number":28,"start":"00:01:06","end":"00:01:10","text":"就是有可能中度的焦虑和抑郁状态"},{"number":29,"start":"00:01:10","end":"00:01:13","text":"并且可能有一点双向"},{"number":30,"start":"00:01:13","end":"00:01:17","text":"然后当时甚至考虑过说要不要直接退学"},{"number":31,"start":"00:01:17","end":"00:01:19","text":"重新去高考"},{"number":32,"start":"00:01:19","end":"00:01:21","text":"但是总之还是读下去了"},{"number":33,"start":"00:01:21","end":"00:01:26","text":"然后在这种保持了一段时间的很差的状态之后"},{"number":34,"start":"00:01:26","end":"00:01:28","text":"我觉得不能再继续这样下去"},{"number":35,"start":"00:01:28","end":"00:01:31","text":"必必须想办法去走出这个状态"},{"number":36,"start":"00:01:31","end":"00:01:35","text":"然后就开始了进一步的在学院里探索"},{"number":37,"start":"00:01:35","end":"00:01:36","text":"当时是喜欢画画"},{"number":38,"start":"00:01:36","end":"00:01:41","text":"并且在做游戏研究的老师手下去当志愿者"},{"number":39,"start":"00:01:41","end":"00:01:44","text":"所以确定了一个方向"},{"number":40,"start":"00:01:44","end":"00:01:48","text":"就是想要去做游戏的技术美术岗位"},{"number":41,"start":"00:01:49","end":"00:01:52","text":"于是在学校里就辅修了计算机作为二专业"},{"number":42,"start":"00:01:52","end":"00:01:56","text":"并且自己尝试联系老师和一些喜欢的项目"},{"number":43,"start":"00:01:56","end":"00:02:01","text":"看能不能做科研助理和一些工作呃"},{"number":44,"start":"00:02:01","end":"00:02:06","text":"学校的呃还休学了半年去公司进行实习"},{"number":45,"start":"00:02:06","end":"00:02:08","text":"然后当时其实还想过留学"},{"number":46,"start":"00:02:08","end":"00:02:12","text":"所以英语成绩和作品集也都有准备呃"},{"number":47,"start":"00:02:12","end":"00:02:18","text":"在好在当时通过实习转正的方式"},{"number":48,"start":"00:02:18","end":"00:02:21","text":"顺利的进入了一家游戏引擎公司"},{"number":49,"start":"00:02:21","end":"00:02:24","text":"然后呢月薪是目前的月薪是2万"},{"number":50,"start":"00:02:24","end":"00:02:27","text":"然后年包大概是30左右"},{"number":51,"start":"00:02:27","end":"00:02:30","text":"于是这个留学计划也就搁置了呃"},{"number":52,"start":"00:02:30","en