:41","end":"00:07:44","text":"你肯定听过那首诗叫做晴川"},{"number":203,"start":"00:07:44","end":"00:07:46","text":"历历汉阳树"},{"number":204,"start":"00:07:46","end":"00:07:49","text":"芳草萋萋鹦鹉洲"},{"number":205,"start":"00:07:49","end":"00:07:50","text":"我小时候背这个诗"},{"number":206,"start":"00:07:50","end":"00:07:51","text":"感觉也挺美"},{"number":207,"start":"00:07:51","end":"00:07:52","text":"但没有什么感觉"},{"number":208,"start":"00:07:52","end":"00:07:54","text":"后来在我长大了之后"},{"number":209,"start":"00:07:54","end":"00:07:55","text":"有一回我路过武汉"},{"number":210,"start":"00:07:55","end":"00:08:00","text":"然后的话正好是在那个鹦鹉洲那旁边吃饭"},{"number":211,"start":"00:08:00","end":"00:08:01","text":"然后人们说那个是鹦鹉咒"},{"number":212,"start":"00:08:01","end":"00:08:02","text":"啪一下"},{"number":213,"start":"00:08:02","end":"00:08:03","text":"我就想起来了"},{"number":214,"start":"00:08:03","end":"00:08:07","text":"而且正好那是一个刚刚下完雨的秋天的什么呢"},{"number":215,"start":"00:08:07","end":"00:08:10","text":"黄昏带有一点肃杀感觉"},{"number":216,"start":"00:08:10","end":"00:08:13","text":"脑海当中立马的话就出来这两句诗"},{"number":217,"start":"00:08:13","end":"00:08:15","text":"晴川历历汉阳树"},{"number":218,"start":"00:08:15","end":"00:08:17","text":"因为我们是从这个武昌的方向"},{"number":219,"start":"00:08:17","end":"00:08:20","text":"然后来望向汉阳的这个方向"},{"number":220,"start":"00:08:20","end":"00:08:23","text":"然后在武昌的方向可以看到那个鹦鹉洲嘛"},{"number":221,"start":"00:08:23","end":"00:08:25","text":"晴川历历汉阳树"},{"number":222,"start":"00:08:25","end":"00:08:27","text":"芳草萋萋"},{"number":223,"start":"00:08:27","end":"00:08:28","text":"鹦鹉洲"},{"number":224,"start":"00:08:28","end":"00:08:29","text":"日暮乡关"},{"number":225,"start":"00:08:29","end":"00:08:30","text":"何处是烟波"},{"number":226,"start":"00:08:30","end":"00:08:33","text":"江上使人愁"},{"number":227,"start":"00:08:33","end":"00:08:35","text":"汗毛都竖起来了"},{"number":228,"start":"00:08:35","end":"00:08:37","text":"原来这个诗里边写的这种意境"},{"number":229,"start":"00:08:37","end":"00:08:40","text":"这种感觉在我的有生之年"},{"number":230,"start":"00:08:40","end":"00:08:41","text":"我很幼小的时候"},{"number":231,"start":"00:08:41","end":"00:08:43","text":"我我所背诵所记忆下来的"},{"number":232,"start":"00:08:43","end":"00:08:46","text":"它是可以真实重叠的哇"},{"number":233,"start":"00:08:46","end":"00:08:50","text":"那么提前做的这个储蓄太好了"},{"number":234,"start":"00:08:50","end":"00:08:52","text":"所以要多背"},{"number":235,"start":"00:08:52","end":"00:08:53","text":"多去接触"},{"number":236,"start":"00:08:53","end":"00:08:55","text":"咱们目的不是为了跟别人比"},{"number":237,"start":"00:08:55","end":"00:08:57","text":"而是为了给若干年之后的自己"},{"number":238,"start":"00:08:57","end":"00:08:59","text":"提前来做一个储蓄动作"},{"number":239,"start":"00:08:59","end":"00:09:00","text":"就像存钱一样"},{"number":240,"start":"00:09:00","end":"00:09:01","text":"现在存了"},{"number":241,"start":"00:09:01","end":"00:09:03","text":"将来花好不好"},{"number":242,"start":"00:09:03","end":"00:09:06","text":"好谢谢大兵叔"},{"number":243,"start":"00:09:06","end":"00:09:07","text":"诶好嘞"},{"number":244,"start":"00:09:07","end":"00:09:08","text":"谢谢你"},{"number":245,"start":"00:09:08","end":"00:09:09","text":"很高兴和你聊天啊"},{"number":246,"start":"00:09:09","end":"00:09:11","text":"还有别的事吗"},{"number":247,"start":"00:09:11","end":"00:09:12","text":"啊没有了嗯"},{"number":248,"start":"00:09:12","end":"00:09:14","text":"谢谢好嘞"},{"number":249,"start":"00:09:15","end":"00:09:17","text":"再见嗯拜拜"}],"sameDate":[{"slug":"2026-04-03-call-01","title":"30岁女备考崩溃，咨询师一语点醒：丈夫该做情绪承载，你老公不亲亲抱抱你吗？","date":"2026-04-03","duration":"22分56秒","index":618,"callNumber":1,"rawTranscriptUrl":"/raw/2026-04-03-call-01"},{"slug":"2026-04-03-call-02","title":"985留校工作的女性在父亲去世一年后恐惧生育 咨询师点醒：生命的意义在于寻找意义","date":"2026-04-03","duration":"13分51秒","index":619,"callNumber":2,"rawTranscriptUrl":"/raw/2026-04-03-call-02"},{"slug":"2026-04-03-call-04","title":"皮肤长痘过敏不敢谈恋爱的女生，却被爬山认识的男友无条件包容 冰哥给小伙子点赞!","date":"2026-04-03","duration":"27分35秒","index":620,"callNumber":4,"rawTranscriptUrl":"/raw/2026-04-03-call-04"},{"slug":"2026-04-03-call-05","title":"10岁男孩想通过背诗超过嘲讽他的同学，咨询师一句话让他明白真正该为什么而背","date":"2026-04-03","duration":"10分53秒","