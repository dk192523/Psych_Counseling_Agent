# Docker Compose project name. Keep this unchanged across upgrades so named volumes are reused.
COMPOSE_PROJECT_NAME=psych-counseling-agent

# Public deployment requires HTTPS; keep port 3004 on loopback.
FRONTEND_PORT=3004
FRONTEND_BIND_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=true
APP_REGISTRATION_ENABLED=false

POSTGRES_DB=dk_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
JDBC_CONNECTION_TIMEOUT_MS=5000
JDBC_QUERY_TIMEOUT=25s
PG_CONNECT_TIMEOUT_SECONDS=5
PG_SOCKET_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_WEB_SEARCH_TOOL=web_search_20260209

CHAT_HISTORY_MAX_MESSAGES=1000
CHAT_HISTORY_CONTEXT_WINDOW=30
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_DIGEST_MAX_CHARS=1200
CHAT_MEMORY_FOLD_THRESHOLD=6
CHAT_MEMORY_RECALL_CANDIDATES=30
CHAT_MEMORY_RECALL_EPISODES=4
CHAT_MEMORY_RECALL_SNIPPET_CHARS=300

DEEP_THINKING_ENABLED=true
DEEP_THINKING_STEP_TIMEOUT_SECONDS=45
DEEP_THINKING_HISTORY_MESSAGES=12
DEEP_THINKING_MAX_QUERIES=3
DEEP_THINKING_ASSOCIATION_HYPOTHESES=3
DEEP_THINKING_CANDIDATE_TOP_K=6
DEEP_THINKING_SIMILARITY_THRESHOLD=0.25
DEEP_THINKING_CANDIDATE_LIMIT=12
DEEP_THINKING_EVIDENCE_LIMIT=4
DEEP_THINKING_TRANSCRIPT_SNIPPETS=2
DEEP_THINKING_CANDIDATE_TEXT_CHARS=900
DEEP_THINKING_CONTEXT_MAX_CHARS=8000
DEEP_THINKING_VECTOR_MAX_CONCURRENCY=8
DEEP_THINKING_TRANSCRIPT_MAX_CONCURRENCY=8

AI_WORKER_ENABLED=true
AI_WORKER_BASE_URL=http://ai-worker:8000
AI_WORKER_CONNECT_TIMEOUT_SECONDS=2
AI_WORKER_REQUEST_TIMEOUT_SECONDS=25
AI_WORKER_MAX_CONCURRENCY=4
AI_WORKER_FAILURE_THRESHOLD=3
AI_WORKER_CIRCUIT_OPEN_SECONDS=30
AI_WORKER_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_INTERNAL_SECRET
AI_WORKER_LLM_ENABLED=true
AI_WORKER_MODEL_TIMEOUT_SECONDS=20
AI_WORKER_MODEL_MAX_CONCURRENCY=4

# Set a strong known password for the first administrator account.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
SESSION_TIMEOUT=24h

# Same-origin production deployment leaves this empty.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=

# Optional model mirror. Leave commented to use the pinned upstream ONNX model.
# ONNX_EMBEDDING_MODEL_URI=https://your-mirror.example/model.onnx

# Container log rotation and startup wait timeout.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
STARTUP_TIMEOUT_SECONDS=1200
