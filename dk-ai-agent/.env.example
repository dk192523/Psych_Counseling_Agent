FRONTEND_PORT=3001
FRONTEND_BIND_ADDRESS=127.0.0.1
DEV_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=dk_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
JDBC_CONNECTION_TIMEOUT_MS=5000
JDBC_QUERY_TIMEOUT=25s
PG_CONNECT_TIMEOUT_SECONDS=5
PG_SOCKET_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_WEB_SEARCH_TOOL=web_search_20260209

# Conversation memory working set and model context, not time-based data retention.
# Consolidation into the long-term digest runs before raw-message eviction.
CHAT_HISTORY_MAX_MESSAGES=1000
CHAT_HISTORY_CONTEXT_WINDOW=30
CHAT_HISTORY_REPLAY_RETENTION=7d

# Whole-conversation retention: dry-run only by default; 0 means no period configured.
# Agree on the product/legal period before choosing 1..36500 days and enabling apply.
# Batch size: 1..500. Tombstones are never purged. Database deletion does not erase backups.
DATA_RETENTION_APPLY=false
DATA_RETENTION_CONVERSATION_DAYS=0
DATA_RETENTION_BATCH_SIZE=100

# Long-term conversation memory (digest + episode recall).
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_DIGEST_MAX_CHARS=1200
CHAT_MEMORY_FOLD_THRESHOLD=6
CHAT_MEMORY_RECALL_CANDIDATES=30
CHAT_MEMORY_RECALL_EPISODES=4
CHAT_MEMORY_RECALL_SNIPPET_CHARS=300

# Deep-thinking Agent. Contract caps: history 30, queries 8, candidates 20,
# evidence 8, snippets 3 and candidate text 2000 characters.
DEEP_THINKING_ENABLED=true
DEEP_THINKING_STEP_TIMEOUT_SECONDS=45
DEEP_THINKING_HISTORY_MESSAGES=12
DEEP_THINKING_MAX_QUERIES=3
DEEP_THINKING_ASSOCIATION_HYPOTHESES=3
DEEP_THINKING_CANDIDATE_TOP_K=6
DEEP_THINKING_SIMILARITY_THRESHOLD=0.25
DEEP_THINKING_CANDIDATE_LIMIT=12
DEEP_THINKING_EVIDENCE_LIMIT=4
DEEP_THINKING_TRANSCRIPT_SNIPPETS=2
DEEP_THINKING_CANDIDATE_TEXT_CHARS=900
DEEP_THINKING_CONTEXT_MAX_CHARS=8000
DEEP_THINKING_VECTOR_MAX_CONCURRENCY=8
DEEP_THINKING_TRANSCRIPT_MAX_CONCURRENCY=8

# Optional Python intelligence plane. Java falls back automatically if it is unavailable.
AI_WORKER_ENABLED=true
AI_WORKER_BASE_URL=http://ai-worker:8000
AI_WORKER_CONNECT_TIMEOUT_SECONDS=2
AI_WORKER_REQUEST_TIMEOUT_SECONDS=25
AI_WORKER_MAX_CONCURRENCY=4
AI_WORKER_FAILURE_THRESHOLD=3
AI_WORKER_CIRCUIT_OPEN_SECONDS=30
# REQUIRED when AI_WORKER_ENABLED=true. The worker now fails to start on a blank secret
# instead of silently authorizing every caller. Its recall endpoint decides which of the
# user's own past sentences get pasted into the model context, so an open worker port is a
# prompt-injection channel, not merely an unauthenticated API. Generate one per environment:
#   openssl rand -base64 32
# To run the worker with no auth at all (local bare-metal debugging only), leave this blank
# and set AI_WORKER_ALLOW_UNAUTHENTICATED=true — the waiver has to be explicit.
AI_WORKER_SHARED_SECRET=replace-with-a-32-byte-random-secret
AI_WORKER_ALLOW_UNAUTHENTICATED=false
AI_WORKER_LLM_ENABLED=true
AI_WORKER_MODEL_TIMEOUT_SECONDS=20
AI_WORKER_MODEL_MAX_CONCURRENCY=4

# Authentication and sessions (AUTH-v1). Before the first production or development startup,
# set ADMIN_INITIAL_PASSWORD
# to at least 8 characters and at most 72 UTF-8 bytes. If no admin exists, an unset, empty,
# whitespace-only or invalid password prevents startup. Passwords and hashes are never logged.
# If an admin already exists, the initial password is not required or reapplied.
# Compose passes an empty value through so the backend can check whether an admin exists.
# SESSION_TIMEOUT accepts Spring duration syntax (e.g. 24h).
ADMIN_INITIAL_PASSWORD=
SESSION_TIMEOUT=24h

# Optional. Defaults to the pinned Spring AI 1.0.0 ONNX model URL.
ONNX_EMBEDDING_MODEL_URI=

# Local launcher binds to 127.0.0.1 over HTTP. For public HTTPS deployments use
# deploy/tencent-cloud/.env.server.example, secure cookies and controlled registration.
SESSION_COOKIE_SECURE=false
APP_REGISTRATION_ENABLED=true

# Java 后端只支持单副本；禁止重叠滚动发布、蓝绿双实例或 --scale backend=2。
# 非 single / 非 1 的声明在启动时拒绝；不能自动发现两个均自称 single 的进程。
APP_DEPLOYMENT_MODE=single
APP_REPLICA_COUNT=1
# 留空则每次进程启动生成 UUID；仅用于观测，不是锁，不写咨询正文。
# 显式值限 1..128 位 ASCII 字母、数字、点、下划线、冒号、连字符。
APP_INSTANCE_ID=
